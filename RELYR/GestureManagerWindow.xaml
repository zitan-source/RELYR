<Window x:Class="RELYR.GestureManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ジェスチャー" Width="900" Height="650" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackground}" Foreground="{DynamicResource PrimaryText}" ShowInTaskbar="False">
  <Window.Resources>
    <DataTemplate x:Key="GestureActionChoiceHeaderTemplate">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding Icon}" Foreground="{Binding IconBrush}" FontFamily="Segoe UI Symbol" FontSize="15" Width="20" TextAlignment="Center" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding Label}" Margin="8,0,0,0" VerticalAlignment="Center"/>
      </StackPanel>
    </DataTemplate>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
      <Setter Property="Background" Value="{DynamicResource DangerBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource DangerForeground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="DangerBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource ControlCornerRadius}" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="DangerBorder" Property="Background" Value="{DynamicResource DangerHoverBackground}"/><Setter Property="Foreground" Value="{DynamicResource DangerHoverForeground}"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="DangerBorder" Property="Opacity" Value="0.8"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="DangerBorder" Property="Opacity" Value="0.42"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="GestureDirectionIconFrame" TargetType="Border">
      <Setter Property="Width" Value="42"/><Setter Property="Height" Value="42"/><Setter Property="Margin" Value="0,0,12,0"/>
      <Setter Property="Background" Value="{DynamicResource ControlBackground}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="9"/>
    </Style>
    <Style x:Key="GestureTitleTextBox" TargetType="TextBox" BasedOn="{StaticResource AppTextBoxStyle}">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0,0,34,0"/>
      <Setter Property="FontSize" Value="21"/><Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Grid>
        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Focusable="False"/>
        <Button x:Name="GestureTitleEditButton" Style="{StaticResource AppButtonStyle}" Width="30" Height="32" MinWidth="0" MinHeight="0" Padding="0" Margin="0" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" HorizontalAlignment="Right" VerticalAlignment="Center" Focusable="False" Click="RenameGesture_Click" ToolTip="名前を編集" AutomationProperties.Name="ジェスチャー名を編集"><TextBlock x:Name="GestureTitleEditGlyph" Text="&#xE70F;" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="{DynamicResource MutedText}"/></Button>
        <Border x:Name="GestureTitleFocusLine" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource AccentBrush}" Opacity="0"/>
      </Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="GestureTitleEditGlyph" Property="Foreground" Value="{DynamicResource PrimaryText}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="GestureTitleFocusLine" Property="Opacity" Value="1"/><Setter TargetName="GestureTitleEditGlyph" Property="Foreground" Value="{DynamicResource AccentTextBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,10">
      <TextBlock Text="方向ごとの操作と短押しを設定" Foreground="{DynamicResource SecondaryText}"/>
    </StackPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource SurfaceCornerRadius}" Padding="10">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="一覧" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
          <ListBox x:Name="GestureList" Grid.Row="1" DisplayMemberPath="Name" SelectionChanged="GestureSelectionChanged"
                   Background="{DynamicResource InputBackground}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource BorderBrush}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
          <UniformGrid Grid.Row="2" Columns="3" Margin="0,9,0,0">
            <Button x:Name="AddGestureButton" Style="{StaticResource AppButtonStyle}" Margin="3" Padding="0" Click="AddGesture_Click" ToolTip="ジェスチャーを追加">
              <Viewbox Width="18" Height="18"><Canvas Width="18" Height="18"><Path Data="M9,3 V15 M3,9 H15" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox>
            </Button>
            <Button x:Name="RenameGestureButton" Style="{StaticResource AppButtonStyle}" Margin="3" Padding="0" Click="RenameGesture_Click" ToolTip="ジェスチャー名を変更">
              <Viewbox Width="18" Height="18"><Canvas Width="18" Height="18"><Path Data="M3,15 L4.2,10.8 L12.6,2.4 Q13.3,1.7 14,2.4 L15.6,4 Q16.3,4.7 15.6,5.4 L7.2,13.8 Z M4.2,10.8 L7.2,13.8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/></Canvas></Viewbox>
            </Button>
            <Button x:Name="DeleteGestureButton" Style="{StaticResource DangerButton}" Margin="3" Padding="0" Click="DeleteGesture_Click" ToolTip="ジェスチャーを削除">
              <Viewbox Width="18" Height="18"><Canvas Width="18" Height="18"><Path Data="M3,5 H15 M6,5 V3 H12 V5 M5,5 L6,16 H12 L13,5 M8,8 V13 M10,8 V13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/></Canvas></Viewbox>
            </Button>
          </UniformGrid>
        </Grid>
      </Border>
      <Border Grid.Column="2" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource SurfaceCornerRadius}" Padding="16">
        <Grid x:Name="GestureEditor" IsEnabled="False">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
          <TextBox x:Name="GestureTitle" Style="{StaticResource GestureTitleTextBox}" Height="44" Margin="0,0,0,12" IsReadOnly="True" PreviewKeyDown="GestureTitle_PreviewKeyDown" LostKeyboardFocus="GestureTitle_LostKeyboardFocus"/>
          <UniformGrid Grid.Row="1" Rows="5">
            <Border Margin="0,3" Padding="10" Background="{DynamicResource InputBackground}" CornerRadius="{StaticResource ControlCornerRadius}" SnapsToDevicePixels="True"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition/><ColumnDefinition Width="84"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Border Style="{StaticResource GestureDirectionIconFrame}"><Viewbox Width="22" Height="22"><Canvas Width="20" Height="20"><Path Data="M10,17 V4 M4.5,9.5 L10,4 L15.5,9.5" Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox></Border><TextBlock Text="上" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel><TextBlock x:Name="UpActionText" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><Button Grid.Column="2" Content="選択…" Tag="Up" Style="{StaticResource AppButtonStyle}" Margin="3" Click="SelectAction_Click"/><Button Grid.Column="3" Content="クリア" Tag="Up" Style="{StaticResource AppButtonStyle}" Margin="3" Click="ClearAction_Click"/></Grid></Border>
            <Border Margin="0,3" Padding="10" Background="{DynamicResource InputBackground}" CornerRadius="{StaticResource ControlCornerRadius}" SnapsToDevicePixels="True"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition/><ColumnDefinition Width="84"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Border Style="{StaticResource GestureDirectionIconFrame}"><Viewbox Width="22" Height="22"><Canvas Width="20" Height="20"><Path Data="M10,3 V16 M4.5,10.5 L10,16 L15.5,10.5" Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox></Border><TextBlock Text="下" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel><TextBlock x:Name="DownActionText" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><Button Grid.Column="2" Content="選択…" Tag="Down" Style="{StaticResource AppButtonStyle}" Margin="3" Click="SelectAction_Click"/><Button Grid.Column="3" Content="クリア" Tag="Down" Style="{StaticResource AppButtonStyle}" Margin="3" Click="ClearAction_Click"/></Grid></Border>
            <Border Margin="0,3" Padding="10" Background="{DynamicResource InputBackground}" CornerRadius="{StaticResource ControlCornerRadius}" SnapsToDevicePixels="True"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition/><ColumnDefinition Width="84"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Border Style="{StaticResource GestureDirectionIconFrame}"><Viewbox Width="22" Height="22"><Canvas Width="20" Height="20"><Path Data="M17,10 H4 M9.5,4.5 L4,10 L9.5,15.5" Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox></Border><TextBlock Text="左" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel><TextBlock x:Name="LeftActionText" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><Button Grid.Column="2" Content="選択…" Tag="Left" Style="{StaticResource AppButtonStyle}" Margin="3" Click="SelectAction_Click"/><Button Grid.Column="3" Content="クリア" Tag="Left" Style="{StaticResource AppButtonStyle}" Margin="3" Click="ClearAction_Click"/></Grid></Border>
            <Border Margin="0,3" Padding="10" Background="{DynamicResource InputBackground}" CornerRadius="{StaticResource ControlCornerRadius}" SnapsToDevicePixels="True"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition/><ColumnDefinition Width="84"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Border Style="{StaticResource GestureDirectionIconFrame}"><Viewbox Width="22" Height="22"><Canvas Width="20" Height="20"><Path Data="M3,10 H16 M10.5,4.5 L16,10 L10.5,15.5" Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox></Border><TextBlock Text="右" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel><TextBlock x:Name="RightActionText" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><Button Grid.Column="2" Content="選択…" Tag="Right" Style="{StaticResource AppButtonStyle}" Margin="3" Click="SelectAction_Click"/><Button Grid.Column="3" Content="クリア" Tag="Right" Style="{StaticResource AppButtonStyle}" Margin="3" Click="ClearAction_Click"/></Grid></Border>
            <Border Margin="0,3" Padding="10" Background="{DynamicResource InputBackground}" CornerRadius="{StaticResource ControlCornerRadius}" SnapsToDevicePixels="True"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition/><ColumnDefinition Width="84"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Border Style="{StaticResource GestureDirectionIconFrame}"><Viewbox Width="22" Height="22"><Canvas Width="20" Height="20"><Ellipse Canvas.Left="3" Canvas.Top="3" Width="14" Height="14" Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="1.7"/><Ellipse Canvas.Left="7" Canvas.Top="7" Width="6" Height="6" Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="1.7"/></Canvas></Viewbox></Border><TextBlock Text="短押し" FontWeight="Bold" VerticalAlignment="Center" ToolTip="方向を入力せずにボタンを離したときの動作"/></StackPanel><TextBlock x:Name="CenterActionText" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><Button Grid.Column="2" Content="選択…" Tag="Center" Style="{StaticResource AppButtonStyle}" Margin="3" Click="SelectAction_Click"/><Button Grid.Column="3" Content="クリア" Tag="Center" Style="{StaticResource AppButtonStyle}" Margin="3" Click="ClearAction_Click"/></Grid></Border>
          </UniformGrid>
        </Grid>
      </Border>
    </Grid>
    <Grid Grid.Row="2" Margin="0,16,0,0">
      <TextBlock x:Name="StatusText" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="キャンセル" Style="{StaticResource AppButtonStyle}" Margin="3" Click="Cancel_Click"/>
        <Button Content="適用" Style="{StaticResource AccentAppButtonStyle}" Margin="3" Click="Apply_Click"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
