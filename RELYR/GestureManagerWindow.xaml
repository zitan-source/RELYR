<Window x:Class="RELYR.GestureManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ジェスチャー" Width="900" Height="650" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackground}" Foreground="{DynamicResource PrimaryText}" ShowInTaskbar="False">
  <Window.Resources>
    <DataTemplate x:Key="GestureActionChoiceHeaderTemplate">
      <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Icon}" Foreground="{Binding IconBrush}" FontFamily="Segoe UI Symbol" FontSize="15" Width="20" TextAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="{Binding Label}" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
    </DataTemplate>
    <Style x:Key="QuietIconButton" TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
      <Setter Property="Width" Value="44"/><Setter Property="Height" Value="40"/><Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/>
      <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="3"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource DangerActionButtonStyle}">
      <Setter Property="Width" Value="44"/><Setter Property="Height" Value="40"/><Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="3"/>
    </Style>
    <Style x:Key="FlatListBoxItem" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,2"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Background="{TemplateBinding Background}" CornerRadius="{StaticResource ControlCornerRadius}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource ControlHoverBackground}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentSoftBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="FlatListBox" TargetType="ListBox" BasedOn="{StaticResource AppListBoxStyle}">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="ItemContainerStyle" Value="{StaticResource FlatListBoxItem}"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden"/>
    </Style>
    <Style x:Key="GestureRowStyle" TargetType="Border">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}"/><Setter Property="Margin" Value="0,3"/><Setter Property="Padding" Value="12,8"/>
      <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource GestureRowHoverBackground}"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="GestureTitleTextBox" TargetType="TextBox" BasedOn="{StaticResource AppTextBoxStyle}">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="FontSize" Value="21"/><Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Grid>
        <StackPanel x:Name="GestureTitleDisplay" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
          <TextBlock x:Name="GestureTitleDisplayText" Text="{TemplateBinding Text}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
          <Button x:Name="GestureTitleEditButton" Style="{StaticResource QuietIconButton}" Width="30" Height="32" Margin="7,0,0,0" VerticalAlignment="Center" Focusable="False" Click="RenameGesture_Click" ToolTip="名前を編集" AutomationProperties.Name="ジェスチャー名を編集"><TextBlock x:Name="GestureTitleEditGlyph" Text="&#xE70F;" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="{DynamicResource MutedText}"/></Button>
        </StackPanel>
        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Focusable="False" Visibility="Collapsed"/>
        <Border x:Name="GestureTitleFocusLine" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource AccentBrush}" Opacity="0"/>
      </Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="GestureTitleEditGlyph" Property="Foreground" Value="{DynamicResource PrimaryText}"/></Trigger><Trigger Property="IsReadOnly" Value="False"><Setter TargetName="GestureTitleDisplay" Property="Visibility" Value="Collapsed"/><Setter TargetName="PART_ContentHost" Property="Visibility" Value="Visible"/><Setter TargetName="GestureTitleFocusLine" Property="Opacity" Value="1"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="GestureTitleFocusLine" Property="Opacity" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="20,18,20,16">
    <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="1"/><ColumnDefinition Width="26"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Grid Grid.Column="0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="一覧" FontSize="17" FontWeight="SemiBold" Margin="4,2,0,10"/>
        <ListBox x:Name="GestureList" Grid.Row="1" Style="{StaticResource FlatListBox}" SelectionChanged="GestureSelectionChanged">
          <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name,Converter={StaticResource LocalizedGeneratedNameConverter}}"/></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <UniformGrid Grid.Row="2" Columns="3" Margin="0,8,0,0">
          <Button x:Name="AddGestureButton" Style="{StaticResource QuietIconButton}" Click="AddGesture_Click" ToolTip="ジェスチャーを追加" AutomationProperties.Name="ジェスチャーを追加"><Viewbox Width="18" Height="18"><Canvas Width="18" Height="18"><Path Data="M9,3 V15 M3,9 H15" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox></Button>
          <Button x:Name="RenameGestureButton" Style="{StaticResource QuietIconButton}" Click="RenameGesture_Click" ToolTip="ジェスチャー名を編集" AutomationProperties.Name="ジェスチャー名を編集"><Viewbox Width="18" Height="18"><Canvas Width="18" Height="18"><Path Data="M3,15 L4.2,10.8 L12.6,2.4 Q13.3,1.7 14,2.4 L15.6,4 Q16.3,4.7 15.6,5.4 L7.2,13.8 Z M4.2,10.8 L7.2,13.8" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/></Canvas></Viewbox></Button>
          <Button x:Name="DeleteGestureButton" Style="{StaticResource DangerButton}" Click="DeleteGesture_Click" ToolTip="ジェスチャーを削除" AutomationProperties.Name="ジェスチャーを削除"><Viewbox Width="18" Height="18"><Canvas Width="18" Height="18"><Path Data="M3,5 H15 M6,5 V3 H12 V5 M5,5 L6,16 H12 L13,5 M8,8 V13 M10,8 V13" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/></Canvas></Viewbox></Button>
        </UniformGrid>
      </Grid>
      <Border x:Name="GesturePaneDivider" Grid.Column="1" Width="1" Background="{DynamicResource SubtleBorderBrush}" Opacity="0.7"/>
      <Grid x:Name="GestureEditor" Grid.Column="3" IsEnabled="False">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <Grid Height="44" Margin="0,0,0,16">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBox x:Name="GestureTitle" Style="{StaticResource GestureTitleTextBox}" Margin="0,0,12,0" IsReadOnly="True" PreviewKeyDown="GestureTitle_PreviewKeyDown" LostKeyboardFocus="GestureTitle_LostKeyboardFocus"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock Text="移動量" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}" ToolTip="方向を確定する移動量"/>
            <TextBox x:Name="GestureThresholdBox" Width="48" Height="32" MinHeight="0" Margin="7,0,5,0" Padding="8,0" FontSize="13" TextAlignment="Center" VerticalContentAlignment="Center" TextChanged="GestureThresholdChanged" ToolTip="3～100px" AutomationProperties.Name="方向を確定する移動量"/>
            <TextBlock Text="px" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}" Margin="0,0,18,0"/>
            <CheckBox x:Name="LockGestureCursorBox" Style="{StaticResource AppSwitchCheckBoxStyle}" Content="カーソルを固定" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="LockGestureCursorChanged" Unchecked="LockGestureCursorChanged" ToolTip="オン：固定する　オフ：カーソルを動かす" AutomationProperties.Name="ジェスチャー中にカーソルを固定"/>
          </StackPanel>
        </Grid>
        <UniformGrid Grid.Row="1" Rows="5">
          <Border Style="{StaticResource GestureRowStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition/><ColumnDefinition Width="50"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Viewbox Width="24" Height="24" Margin="0,0,13,0"><Canvas Width="20" Height="20"><Path Data="M10,17 V4 M4.5,9.5 L10,4 L15.5,9.5" Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox><TextBlock Text="上" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel><TextBlock x:Name="UpActionText" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><Button Grid.Column="2" Tag="Up" Style="{StaticResource QuietIconButton}" Click="SelectAction_Click" ToolTip="上の動作を選択" AutomationProperties.Name="上の動作を選択"><TextBlock Text="›" FontSize="25" Margin="0,-3,0,0"/></Button><Button Grid.Column="3" Tag="Up" Style="{StaticResource QuietIconButton}" Click="ClearAction_Click" ToolTip="上の動作をクリア" AutomationProperties.Name="上の動作をクリア"><TextBlock Text="×" FontSize="19"/></Button></Grid></Border>
          <Border Style="{StaticResource GestureRowStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition/><ColumnDefinition Width="50"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Viewbox Width="24" Height="24" Margin="0,0,13,0"><Canvas Width="20" Height="20"><Path Data="M10,3 V16 M4.5,10.5 L10,16 L15.5,10.5" Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox><TextBlock Text="下" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel><TextBlock x:Name="DownActionText" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><Button Grid.Column="2" Tag="Down" Style="{StaticResource QuietIconButton}" Click="SelectAction_Click" ToolTip="下の動作を選択" AutomationProperties.Name="下の動作を選択"><TextBlock Text="›" FontSize="25" Margin="0,-3,0,0"/></Button><Button Grid.Column="3" Tag="Down" Style="{StaticResource QuietIconButton}" Click="ClearAction_Click" ToolTip="下の動作をクリア" AutomationProperties.Name="下の動作をクリア"><TextBlock Text="×" FontSize="19"/></Button></Grid></Border>
          <Border Style="{StaticResource GestureRowStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition/><ColumnDefinition Width="50"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Viewbox Width="24" Height="24" Margin="0,0,13,0"><Canvas Width="20" Height="20"><Path Data="M17,10 H4 M9.5,4.5 L4,10 L9.5,15.5" Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox><TextBlock Text="左" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel><TextBlock x:Name="LeftActionText" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><Button Grid.Column="2" Tag="Left" Style="{StaticResource QuietIconButton}" Click="SelectAction_Click" ToolTip="左の動作を選択" AutomationProperties.Name="左の動作を選択"><TextBlock Text="›" FontSize="25" Margin="0,-3,0,0"/></Button><Button Grid.Column="3" Tag="Left" Style="{StaticResource QuietIconButton}" Click="ClearAction_Click" ToolTip="左の動作をクリア" AutomationProperties.Name="左の動作をクリア"><TextBlock Text="×" FontSize="19"/></Button></Grid></Border>
          <Border Style="{StaticResource GestureRowStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition/><ColumnDefinition Width="50"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Viewbox Width="24" Height="24" Margin="0,0,13,0"><Canvas Width="20" Height="20"><Path Data="M3,10 H16 M10.5,4.5 L16,10 L10.5,15.5" Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox><TextBlock Text="右" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel><TextBlock x:Name="RightActionText" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><Button Grid.Column="2" Tag="Right" Style="{StaticResource QuietIconButton}" Click="SelectAction_Click" ToolTip="右の動作を選択" AutomationProperties.Name="右の動作を選択"><TextBlock Text="›" FontSize="25" Margin="0,-3,0,0"/></Button><Button Grid.Column="3" Tag="Right" Style="{StaticResource QuietIconButton}" Click="ClearAction_Click" ToolTip="右の動作をクリア" AutomationProperties.Name="右の動作をクリア"><TextBlock Text="×" FontSize="19"/></Button></Grid></Border>
          <Border Style="{StaticResource GestureRowStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition/><ColumnDefinition Width="50"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Viewbox Width="24" Height="24" Margin="0,0,13,0"><Canvas Width="20" Height="20"><Ellipse Canvas.Left="3" Canvas.Top="3" Width="14" Height="14" Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="1.7"/><Ellipse Canvas.Left="7" Canvas.Top="7" Width="6" Height="6" Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="1.7"/></Canvas></Viewbox><TextBlock Text="短押し" FontWeight="Bold" VerticalAlignment="Center" ToolTip="方向を入力せずにボタンを離したときの動作"/></StackPanel><TextBlock x:Name="CenterActionText" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><Button Grid.Column="2" Tag="Center" Style="{StaticResource QuietIconButton}" Click="SelectAction_Click" ToolTip="短押しの動作を選択" AutomationProperties.Name="短押しの動作を選択"><TextBlock Text="›" FontSize="25" Margin="0,-3,0,0"/></Button><Button Grid.Column="3" Tag="Center" Style="{StaticResource QuietIconButton}" Click="ClearAction_Click" ToolTip="短押しの動作をクリア" AutomationProperties.Name="短押しの動作をクリア"><TextBlock Text="×" FontSize="19"/></Button></Grid></Border>
        </UniformGrid>
      </Grid>
    </Grid>
    <Grid Grid.Row="1" Margin="0,14,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center"><TextBlock Text="方向ごとの操作と短押しを設定します。" Foreground="{DynamicResource SecondaryText}" FontSize="12"/><TextBlock x:Name="StatusText" Foreground="{DynamicResource AccentTextBrush}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="キャンセル" Style="{StaticResource AppButtonStyle}" Margin="3" Click="Cancel_Click"/><Button Content="適用" Style="{StaticResource AccentAppButtonStyle}" Margin="3" Click="Apply_Click"/></StackPanel>
    </Grid>
  </Grid>
</Window>
