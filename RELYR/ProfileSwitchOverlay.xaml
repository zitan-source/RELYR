<Window x:Class="RELYR.ProfileSwitchOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="340" Height="70" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        ShowActivated="False" Topmost="True" Focusable="False"
        IsHitTestVisible="False">
  <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource AccentBrush}"
          BorderThickness="1" CornerRadius="{StaticResource SurfaceCornerRadius}" Padding="18,10" SnapsToDevicePixels="True">
    <Border.Effect>
      <DropShadowEffect Color="#80000000" BlurRadius="18" ShadowDepth="4" Opacity="0.45"/>
    </Border.Effect>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="{DynamicResource AccentBrush}" CornerRadius="2"/>
      <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="プロファイルを切り替えました" FontSize="11"
                   Foreground="{DynamicResource SecondaryText}"/>
        <TextBlock x:Name="ProfileNameText" FontSize="19" FontWeight="SemiBold"
                   Foreground="{DynamicResource PrimaryText}" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
