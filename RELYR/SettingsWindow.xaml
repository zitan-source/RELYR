<Window x:Class="RELYR.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RELYR の設定" Width="820" Height="680" MinWidth="720" MinHeight="620"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#10141C" Foreground="#EEF2F8">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="17,9"/>
      <Setter Property="Background" Value="#293245"/><Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#46536D"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#354158"/><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#72E0C1"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#176B5D"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Margin" Value="0,10"/><Setter Property="FontSize" Value="15"/>
      <Setter Property="Foreground" Value="#EEF2F8"/>
    </Style>
    <Style x:Key="SideItem" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="14,12"/><Setter Property="Margin" Value="0,2"/>
      <Setter Property="Foreground" Value="#C8D1E2"/><Setter Property="FontSize" Value="15"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#244B4A"/><Setter Property="Foreground" Value="#72E0C1"/>
          <Setter Property="FontWeight" Value="SemiBold"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="#1B2230"/><Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="22"/><Setter Property="BorderBrush" Value="#2C374A"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#7D2430"/><Setter Property="BorderBrush" Value="#E16A78"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="DangerBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="DangerBorder" Property="Background" Value="#9B3040"/><Setter TargetName="DangerBorder" Property="BorderBrush" Value="#FF8792"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="DangerBorder" Property="Background" Value="#651B26"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

    <Border Background="#171C26" BorderBrush="#2A3344" BorderThickness="0,0,1,0">
      <Grid Margin="16,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="10,0,8,18">
          <TextBlock Text="アプリ設定" FontSize="22" FontWeight="Bold"/>
          <TextBlock Text="変更する項目を選択" Foreground="#8F9BB0" Margin="0,5,0,0"/>
        </StackPanel>
        <ListBox x:Name="CategoryList" Grid.Row="1" SelectedIndex="0" Background="Transparent"
                 BorderThickness="0" SelectionChanged="Category_SelectionChanged" ItemContainerStyle="{StaticResource SideItem}">
          <ListBoxItem Content="一般" Tag="General"/>
          <ListBoxItem Content="レイヤー" Tag="Layers"/>
          <ListBoxItem Content="自動解凍" Tag="Archive"/>
          <ListBoxItem Content="データ管理" Tag="Data"/>
        </ListBox>
      </Grid>
    </Border>

    <Grid Grid.Column="1" Margin="30,24,26,20">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

      <Grid>
        <StackPanel x:Name="GeneralPanel">
          <TextBlock Text="一般" FontSize="27" FontWeight="Bold"/>
          <TextBlock Text="Windowsと保存に関する基本設定です。" Foreground="#AAB4C8" Margin="0,6,0,22"/>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Windows" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,5"/>
              <CheckBox x:Name="StartupBox" Content="サインイン時に自動で起動する"/>
              <CheckBox x:Name="DesktopNumberTrayBox" Content="通知領域に現在の仮想デスクトップ番号を表示する"/>
              <Separator Margin="0,8" Background="#344057"/>
              <TextBlock Text="ウィンドウを閉じる対象" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,5"/>
              <RadioButton x:Name="ActiveWindowTargetBox" GroupName="CloseWindowTarget" Content="アクティブなウィンドウ" Foreground="#EEF2F8" Margin="0,7,0,3"/>
              <RadioButton x:Name="CursorWindowTargetBox" GroupName="CloseWindowTarget" Content="マウスカーソル下のウィンドウ" Foreground="#EEF2F8" Margin="0,5,0,3"/>
              <TextBlock Text="「ウィンドウを閉じる」（Alt + F4）の対象を選びます。" Foreground="#AAB4C8" Margin="25,3,0,2"/>
              <Separator Margin="0,8" Background="#344057"/>
              <TextBlock Text="保存" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,5"/>
              <CheckBox x:Name="AutoSaveBox" Content="変更をすぐに保存して反映する"/>
              <Separator Margin="0,8" Background="#344057"/>
              <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center"><TextBlock Text="使い方" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="基本操作を3ページで確認できます。" Foreground="#AAB4C8" Margin="0,4,10,0"/></StackPanel>
                <Button x:Name="TutorialButton" Grid.Column="1" Content="チュートリアルを見る" Click="ShowTutorial_Click" VerticalAlignment="Center"/>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel x:Name="LayersPanel" Visibility="Collapsed">
          <TextBlock Text="レイヤー" FontSize="27" FontWeight="Bold"/>
          <TextBlock Text="レイヤーキーの動作を設定します。" Foreground="#AAB4C8" Margin="0,6,0,22"/>
          <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="CapsLock レイヤー" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock x:Name="CapsRemapStatus" Margin="0,7,0,10" TextWrapping="Wrap" Foreground="#AAB4C8"/>
              <TextBlock Text="CapsLockをF13へ割り当て、レイヤー専用キーとして使用します。変更後はWindowsの再起動が必要です。" TextWrapping="Wrap" Foreground="#F6C66A" Margin="0,0,0,10"/>
              <StackPanel Orientation="Horizontal">
                <Button x:Name="EnableCapsRemapButton" Content="CapsLockレイヤーを有効にする" Click="EnableCapsRemap_Click"/>
                <Button x:Name="DisableCapsRemapButton" Content="元のCapsLockへ戻す" Click="DisableCapsRemap_Click"/>
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Spaceの連打" FontSize="18" FontWeight="SemiBold"/>
              <CheckBox x:Name="SpaceRepeatBox" Content="Spaceを1回押し、2回目の長押しで連打する"/>
              <TextBlock Text="1回の長押しは常にSpaceレイヤーとして動作します。" Foreground="#72E0C1" Margin="25,0,0,18"/>
              <TextBlock Text="連打開始までの時間" Foreground="#C6CEDD"/>
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBox x:Name="SpaceRepeatDelayBox" Width="110" Padding="8" FontSize="15"/>
                <TextBlock Text="ms（100～2000）" VerticalAlignment="Center" Foreground="#AAB4C8" Margin="10,0,0,0"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel x:Name="ArchivePanel" Visibility="Collapsed">
          <TextBlock Text="自動解凍" FontSize="27" FontWeight="Bold"/>
          <TextBlock Text="指定したフォルダーに置かれた圧縮ファイルを自動で展開します。" Foreground="#AAB4C8" Margin="0,6,0,14"/>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="監視するフォルダー" FontSize="16" FontWeight="SemiBold"/>
              <Grid Margin="0,7,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ArchiveWatchFolderBox" MinHeight="38" Padding="9,7" VerticalContentAlignment="Center" Background="#121925" Foreground="#EEF2F8" BorderBrush="#46536D"/><Button Grid.Column="1" Content="参照…" Click="BrowseArchiveWatchFolder_Click" Margin="8,0,0,0"/></Grid>
              <TextBlock Text="解凍後の保存先" FontSize="16" FontWeight="SemiBold"/>
              <Grid Margin="0,7,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ArchiveDestinationFolderBox" MinHeight="38" Padding="9,7" VerticalContentAlignment="Center" Background="#121925" Foreground="#EEF2F8" BorderBrush="#46536D"/><Button Grid.Column="1" Content="参照…" Click="BrowseArchiveDestinationFolder_Click" Margin="8,0,0,0"/></Grid>
              <TextBlock Text="空欄の場合は監視フォルダー内へ展開します。" Foreground="#AAB4C8" Margin="0,0,0,5"/>
              <CheckBox x:Name="ExtractBox" Content="指定したフォルダーの圧縮ファイルを自動解凍する" Margin="0,5,0,4"/>
              <CheckBox x:Name="DeleteBox" Content="解凍成功後に元の圧縮ファイルを削除する" Margin="25,4,0,4"/>
              <TextBlock Text="ZIP / 7Z / RAR / TAR / GZ / BZ2 / XZ などに対応。失敗時は元ファイルを削除しません。" TextWrapping="Wrap" Foreground="#72E0C1" Margin="25,3,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel x:Name="DataPanel" Visibility="Collapsed">
          <TextBlock Text="データ管理" FontSize="27" FontWeight="Bold"/>
          <TextBlock Text="設定のバックアップや別のPCへの移行に使用します。" Foreground="#AAB4C8" Margin="0,6,0,22"/>
          <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="設定ファイル" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock Text="プロファイル、割り当て、マクロ、アプリ設定を1つのJSONファイルで保存・復元します。" TextWrapping="Wrap" Foreground="#AAB4C8" Margin="0,6,0,18"/>
              <StackPanel Orientation="Horizontal">
                <Button Content="インポート" Click="Import_Click"/>
                <Button Content="エクスポート" Click="Export_Click"/>
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" BorderBrush="#68323A">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,14,0"><TextBlock Text="すべての設定を初期化" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="全プロファイル、割り当て、マクロ、アプリ設定を初期状態へ戻します。" TextWrapping="Wrap" Foreground="#D7AAB0" Margin="0,6,0,0"/></StackPanel>
              <Button x:Name="ResetAllButton" Grid.Column="1" Content="すべてリセット" Style="{StaticResource DangerButton}" Click="ResetAll_Click" VerticalAlignment="Center"/>
            </Grid>
          </Border>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1" Margin="0,18,0,0">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="キャンセル" Click="Cancel_Click"/>
          <Button Content="保存" Background="#1F8F7B" BorderBrush="#72E0C1" Click="Save_Click"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</Window>
