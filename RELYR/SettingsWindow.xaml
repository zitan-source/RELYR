<Window x:Class="RELYR.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定" Width="860" Height="700" MinWidth="740" MinHeight="620"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource AppBackground}" Foreground="{DynamicResource PrimaryText}">
  <Window.Resources>
    <Style TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
      <Setter Property="Margin" Value="4"/>
    </Style>
    <Style TargetType="CheckBox" BasedOn="{StaticResource AppSwitchCheckBoxStyle}">
      <Setter Property="Margin" Value="0,3"/><Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>
    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource AppTextBoxStyle}">
      <Setter Property="Background" Value="{DynamicResource InputBackground}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="CaretBrush" Value="{DynamicResource PrimaryText}"/>
    </Style>
    <Style x:Key="SideItem" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="12,10"/><Setter Property="Margin" Value="0,2"/>
      <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/><Setter Property="FontSize" Value="13"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="ItemBackground" Background="{TemplateBinding Background}" CornerRadius="{StaticResource ControlCornerRadius}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBackground" Property="Background" Value="{DynamicResource ControlHoverBackground}"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBackground" Property="Background" Value="{DynamicResource AccentSoftBrush}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
          <Setter Property="FontWeight" Value="SemiBold"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="Transparent"/><Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Padding" Value="4,4,4,4"/><Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style x:Key="ThemedComboBoxItem" TargetType="ComboBoxItem">
      <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Style.Triggers>
        <Trigger Property="IsHighlighted" Value="True">
          <Setter Property="Background" Value="{DynamicResource ControlHoverBackground}"/>
          <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
        </Trigger>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
          <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ThemedComboBox" TargetType="ComboBox">
      <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="ItemContainerStyle" Value="{StaticResource ThemedComboBoxItem}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="ComboBorder" Background="{DynamicResource ControlBackground}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource ControlCornerRadius}" SnapsToDevicePixels="True">
                      <Grid>
                        <ContentPresenter Margin="10,0,34,0" VerticalAlignment="Center"
                                          HorizontalAlignment="Left"
                                          TextElement.Foreground="{DynamicResource PrimaryText}"
                                          Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"/>
                        <Path Width="8" Height="5" HorizontalAlignment="Right" VerticalAlignment="Center"
                              Margin="0,0,12,0" Fill="{DynamicResource SecondaryText}"
                              Data="M 0,0 L 8,0 L 4,5 Z"/>
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="ComboBorder" Property="Background" Value="{DynamicResource ControlHoverBackground}"/>
                        <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                     AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                        MaxHeight="250" Background="{DynamicResource ControlBackground}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource ControlCornerRadius}"
                        SnapsToDevicePixels="True">
                  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsPresenter/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource DangerActionButtonStyle}"/>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="196"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

    <Border Background="{DynamicResource PaneBackground}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,1,0">
      <Grid Margin="16,22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="10,0,8,18">
          <TextBlock Text="設定" FontSize="20" FontWeight="SemiBold"/>
        </StackPanel>
        <ListBox x:Name="CategoryList" Grid.Row="1" SelectedIndex="0" Background="Transparent"
                 BorderThickness="0" SelectionChanged="Category_SelectionChanged" ItemContainerStyle="{StaticResource SideItem}">
          <ListBoxItem Content="一般" Tag="General"/>
          <ListBoxItem Content="外観" Tag="Appearance"/>
          <ListBoxItem Content="レイヤー" Tag="Layers"/>
          <ListBoxItem Content="オーバーレイ" Tag="Overlay"/>
          <ListBoxItem Content="自動解凍" Tag="Archive"/>
          <ListBoxItem Content="データ管理" Tag="Data"/>
          <ListBoxItem Content="アップデート" Tag="Update"/>
          <ListBoxItem Content="無効" Tag="Disabled"/>
          <ListBoxItem Content="プライバシー" Tag="Privacy"/>
          <ListBoxItem Content="開発を支援" Tag="Support"/>
        </ListBox>
      </Grid>
    </Border>

    <Grid Grid.Column="1" Margin="32,26,28,20">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

      <Grid>
        <ScrollViewer x:Name="GeneralScrollPanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="GeneralPanel" Margin="0,0,10,0">
          <TextBlock Text="一般" FontSize="24" FontWeight="SemiBold"/>
          <TextBlock Text="Windowsと保存" Foreground="{DynamicResource SecondaryText}" Margin="0,5,0,18"/>
          <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,8">
            <StackPanel>
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                  <TextBlock Text="表示言語" FontSize="18" FontWeight="SemiBold"/>
                  <TextBlock Text="アプリ全体の表示言語を選びます。" Foreground="{DynamicResource SecondaryText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <ComboBox x:Name="LanguageBox" Grid.Column="1" VerticalAlignment="Center" SelectionChanged="Language_SelectionChanged">
                  <ComboBoxItem Content="日本語" Tag="ja-JP"/>
                  <ComboBoxItem Content="English" Tag="en-US"/>
                </ComboBox>
              </Grid>
              <Separator Margin="0,8" Background="{DynamicResource SubtleBorderBrush}"/>
              <TextBlock Text="Windows" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,5"/>
              <CheckBox x:Name="StartupBox" Content="サインイン時に自動で起動する"/>
              <CheckBox x:Name="DesktopNumberTrayBox" Content="通知領域に現在の仮想デスクトップ番号を表示する"/>
              <Separator Margin="0,8" Background="{DynamicResource SubtleBorderBrush}"/>
              <TextBlock Text="ウィンドウ操作の対象" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,5"/>
              <RadioButton x:Name="ActiveWindowTargetBox" GroupName="WindowActionTarget" Content="アクティブなウィンドウ" Foreground="{DynamicResource PrimaryText}" Margin="0,6"/>
              <RadioButton x:Name="CursorWindowTargetBox" GroupName="WindowActionTarget" Content="マウスカーソル下のウィンドウ" Foreground="{DynamicResource PrimaryText}" Margin="0,6"/>
              <TextBlock Text="閉じる・最大化・最小化・整列・モニター移動などの対象を選びます。" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="25,0,0,2"/>
              <Separator Margin="0,8" Background="{DynamicResource SubtleBorderBrush}"/>
              <TextBlock Text="保存" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,5"/>
              <CheckBox x:Name="AutoSaveBox" Content="変更をすぐに保存して反映する"/>
              <Separator Margin="0,8" Background="{DynamicResource SubtleBorderBrush}"/>
              <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center"><TextBlock Text="使い方" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="画像中心のクイックガイドです。" Foreground="{DynamicResource SecondaryText}" Margin="0,4,10,0"/></StackPanel>
                <Button x:Name="TutorialButton" Grid.Column="1" Content="チュートリアルを見る" Click="ShowTutorial_Click" VerticalAlignment="Center"/>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
        </ScrollViewer>

        <StackPanel x:Name="AppearancePanel" Visibility="Collapsed">
          <TextBlock Text="外観" FontSize="27" FontWeight="Bold"/>
          <TextBlock Text="RELYR全体の表示テーマを選びます。" Foreground="{DynamicResource SecondaryText}" Margin="0,6,0,22"/>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="カラーモード" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
              <RadioButton x:Name="SystemThemeBox" GroupName="ThemeMode" Content="システムに合わせる" Foreground="{DynamicResource PrimaryText}" Margin="0,8" Checked="ThemeMode_Changed"/>
              <TextBlock Text="Windowsのアプリモードに合わせて自動的に切り替えます。" Foreground="{DynamicResource SecondaryText}" Margin="25,-3,0,8"/>
              <RadioButton x:Name="LightThemeBox" GroupName="ThemeMode" Content="ライトモード" Foreground="{DynamicResource PrimaryText}" Margin="0,8" Checked="ThemeMode_Changed"/>
              <TextBlock Text="明るい背景と濃い文字で表示します。" Foreground="{DynamicResource SecondaryText}" Margin="25,-3,0,8"/>
              <RadioButton x:Name="DarkThemeBox" GroupName="ThemeMode" Content="ダークモード" Foreground="{DynamicResource PrimaryText}" Margin="0,8" Checked="ThemeMode_Changed"/>
              <TextBlock Text="暗い背景で画面のまぶしさを抑えます。" Foreground="{DynamicResource SecondaryText}" Margin="25,-3,0,0"/>
            </StackPanel>
          </Border>
          <Separator Margin="4,18,4,18" Background="{DynamicResource SubtleBorderBrush}"/>
          <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="表示効果" FontSize="18" FontWeight="SemiBold"/>
              <CheckBox x:Name="UiAnimationsBox" Content="アニメーション" Margin="0,10,0,0"/>
              <TextBlock Text="操作時の発光・移動・拡大を有効にします。" Foreground="{DynamicResource SecondaryText}" Margin="0,3,0,10"/>
              <CheckBox x:Name="ProfileOverlayBox">
                <TextBlock Text="切替時にプロファイル名を画面下部へ表示する" TextWrapping="Wrap"/>
              </CheckBox>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel x:Name="OverlayPanel" Visibility="Collapsed">
          <TextBlock Text="オーバーレイ" FontSize="27" FontWeight="Bold"/>
          <TextBlock Text="入力パネルの透過率と、クロック画面の表示を設定します。" Foreground="{DynamicResource SecondaryText}" Margin="0,6,0,14"/>
          <Border Style="{StaticResource Card}" Padding="4" Margin="0,0,0,12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="64"/>
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="入力パネルの透過率" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="数字が大きいほど濃く表示します" Foreground="{DynamicResource SecondaryText}" Margin="0,4,0,0"/>
              </StackPanel>
              <Slider x:Name="InputPanelOpacitySlider" Grid.Column="1" Minimum="40" Maximum="100"
                      TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                      ValueChanged="InputPanelOpacity_Changed" Margin="8,0,12,0"/>
              <TextBlock x:Name="InputPanelOpacityValueText" Grid.Column="2" VerticalAlignment="Center"
                         HorizontalAlignment="Right" FontWeight="SemiBold"/>
            </Grid>
          </Border>
          <Border Style="{StaticResource Card}" Padding="4" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="背景" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,7"/>
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="ClockFrostedBackgroundBox" GroupName="ClockBackground" Content="現在の画面をすりガラス風にする" Margin="0,7,18,7" Checked="ClockBackground_Changed"/>
                <RadioButton x:Name="ClockImageBackgroundBox" GroupName="ClockBackground" Content="画像" Margin="0,7,18,7" Checked="ClockBackground_Changed"/>
                <RadioButton x:Name="ClockSolidBackgroundBox" GroupName="ClockBackground" Content="単色" Margin="0,7" Checked="ClockBackground_Changed"/>
              </StackPanel>
              <Grid x:Name="ClockSolidPicker" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="150"/>
                  <ColumnDefinition Width="42"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ClockSolidColorBox" VerticalContentAlignment="Center"
                         TextChanged="ClockSolidColor_Changed" ToolTip="#RRGGBB形式で入力します"/>
                <Border x:Name="ClockSolidColorSample" Grid.Column="1" Width="32" Height="32" Margin="8,0,0,0"
                        CornerRadius="{StaticResource ControlCornerRadius}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" SnapsToDevicePixels="True"/>
                <WrapPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0">
                  <Button Width="34" Height="30" Margin="2" Padding="0" Tag="#101F2E" Background="#101F2E" ToolTip="ネイビー" Click="ClockColorPreset_Click"/>
                  <Button Width="34" Height="30" Margin="2" Padding="0" Tag="#111827" Background="#111827" ToolTip="チャコール" Click="ClockColorPreset_Click"/>
                  <Button Width="34" Height="30" Margin="2" Padding="0" Tag="#0F3D3E" Background="#0F3D3E" ToolTip="ディープグリーン" Click="ClockColorPreset_Click"/>
                  <Button Width="34" Height="30" Margin="2" Padding="0" Tag="#312E81" Background="#312E81" ToolTip="インディゴ" Click="ClockColorPreset_Click"/>
                  <Button Width="34" Height="30" Margin="2" Padding="0" Tag="#4A1D2A" Background="#4A1D2A" ToolTip="ボルドー" Click="ClockColorPreset_Click"/>
                  <Button Width="34" Height="30" Margin="2" Padding="0" Tag="#000000" Background="#000000" ToolTip="ブラック" Click="ClockColorPreset_Click"/>
                </WrapPanel>
              </Grid>
              <Grid x:Name="ClockImagePicker" Margin="0,8,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="ClockBackgroundImageBox" VerticalContentAlignment="Center" IsReadOnly="True"/>
                <Button Grid.Column="1" Content="参照…" Click="BrowseClockBackground_Click" Margin="8,0,0,0"/>
              </Grid>
              <TextBlock Text="すりガラスでは、起動直前の各モニター画面をぼかして表示します。" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Padding="4">
            <StackPanel>
              <StackPanel>
                <TextBlock Text="時計の表示" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,7"/>
                <ComboBox x:Name="ClockDisplayModeBox" MinHeight="38" Padding="10,6"
                          Style="{StaticResource ThemedComboBox}"/>
              </StackPanel>
              <Separator Margin="0,16,0,16" Background="{DynamicResource SubtleBorderBrush}"/>
              <StackPanel>
                <TextBlock Text="表示するモニター" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,3"/>
                <CheckBox x:Name="ClockAllMonitorsBox" Content="すべてのモニターに時計を表示する"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel x:Name="UpdatePanel" Visibility="Collapsed">
          <TextBlock Text="アップデート" FontSize="27" FontWeight="Bold"/>
          <TextBlock Text="最新版の確認とインストールを行います。" Foreground="{DynamicResource SecondaryText}" Margin="0,6,0,22"/>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="RELYRを最新の状態に保つ" FontSize="18" FontWeight="SemiBold"/>
              <Grid Margin="0,14,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="現在のバージョン" Foreground="{DynamicResource SecondaryText}" Margin="0,3"/>
                <TextBlock x:Name="CurrentVersionText" Grid.Column="1" FontWeight="SemiBold" Margin="0,3"/>
                <TextBlock Grid.Row="1" Text="最新バージョン" Foreground="{DynamicResource SecondaryText}" Margin="0,3"/>
                <TextBlock x:Name="LatestVersionText" Grid.Row="1" Grid.Column="1" FontWeight="SemiBold" Margin="0,3"/>
                <TextBlock Grid.Row="2" Text="最後に確認した日時" Foreground="{DynamicResource SecondaryText}" Margin="0,3"/>
                <TextBlock x:Name="LastCheckedText" Grid.Row="2" Grid.Column="1" Margin="0,3"/>
              </Grid>
              <TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" Margin="0,7,0,8"/>
              <ProgressBar x:Name="UpdateProgressBar" Height="8" Minimum="0" Maximum="100" Visibility="Collapsed"
                           Foreground="{DynamicResource AccentStrongBrush}" Background="{DynamicResource ControlBackground}"/>
              <TextBlock x:Name="UpdateProgressText" Visibility="Collapsed" Foreground="{DynamicResource SecondaryText}" Margin="0,6,0,2"/>
              <CheckBox x:Name="CheckForUpdatesBox" Content="メイン画面を開いたときに自動でアップデートを確認する"/>
              <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="CheckForUpdatesButton" Content="アップデートを確認" Click="CheckForUpdates_Click"/>
                <Button x:Name="InstallUpdateButton" Content="今すぐアップデート" Click="InstallUpdate_Click"
                        Visibility="Collapsed" Background="{DynamicResource AccentStrongBrush}" Foreground="{DynamicResource AccentButtonText}" BorderBrush="{DynamicResource AccentBrush}"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel x:Name="DisabledPanel" Visibility="Collapsed">
          <TextBlock Text="無効" FontSize="27" FontWeight="Bold"/>
          <TextBlock Text="指定したアプリではRELYRの入力処理を停止します。" Foreground="{DynamicResource SecondaryText}" Margin="0,6,0,22"/>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="RELYRを無効にするアプリ" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock Text="登録したアプリがアクティブな間は、キーボードとマウスの処理を止め、入力をそのままアプリへ渡します。" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" Margin="0,6,0,12"/>
              <ListBox x:Name="InputDisabledApplicationList" Height="126" MinHeight="84" MouseDoubleClick="RemoveInputDisabledApplication_Click">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="8,6">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <Image Source="{Binding Icon}" Width="28" Height="28" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Value}" Foreground="{DynamicResource SecondaryText}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <WrapPanel HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="外す" ToolTip="選択したアプリを一覧から外します" Click="RemoveInputDisabledApplication_Click"/>
                <Button Content="起動中から追加…" ToolTip="現在起動中のアプリから選びます" Click="AddRunningInputDisabledApplication_Click"/>
                <Button Content="アプリを選ぶ…" ToolTip="インストール済みのアプリから選びます" Click="AddInstalledInputDisabledApplication_Click"/>
              </WrapPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel x:Name="PrivacyPanel" Visibility="Collapsed">
          <TextBlock Text="プライバシー" FontSize="27" FontWeight="Bold"/>
          <TextBlock Text="診断情報の保存内容を確認・管理します。" Foreground="{DynamicResource SecondaryText}" Margin="0,6,0,22"/>
          <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="通常の診断ログ" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock Text="起動・終了・接続状態などのイベント名だけを、このPC内へ保存します。キー入力や割り当て内容は記録しません。"
                         TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" Margin="0,7,0,0"/>
              <TextBlock Text="ログがRELYRから外部へ送信されることはありません。各ファイルは最大512KBで、14日以上更新されていないログは自動的に消去されます。"
                         TextWrapping="Wrap" Foreground="{DynamicResource AccentTextBrush}" Margin="0,8,0,0"/>
              <TextBlock Text="保存先: %AppData%\RELYR と %LocalAppData%\RELYR"
                         TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" FontSize="12" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="問題調査用の詳細ログ" FontSize="18" FontWeight="SemiBold"/>
              <CheckBox x:Name="DetailedDiagnosticsBox" Content="詳細な診断ログを記録する" Margin="0,10,0,0"/>
              <TextBlock Text="問題の再現を調べるときだけ有効にしてください。実行した割り当ての入力名・内容や、前面アプリのパスが記録される場合があります。通常のキー入力を連続して記録する機能ではありません。"
                         TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}" Margin="25,5,0,0"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,14,0">
                <TextBlock Text="保存済みログを削除" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="通常ログと詳細ログを、このPCからまとめて削除します。" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" Margin="0,6,0,0"/>
              </StackPanel>
              <Button Grid.Column="1" Content="診断ログを削除" Click="DeleteDiagnosticLogs_Click" VerticalAlignment="Center"/>
            </Grid>
          </Border>
        </StackPanel>

        <StackPanel x:Name="SupportPanel" Visibility="Collapsed">
          <TextBlock Text="開発を支援" FontSize="27" FontWeight="Bold"/>
          <TextBlock Text="RELYRの継続的な開発と保守を任意で支援できます。" Foreground="{DynamicResource SecondaryText}" Margin="0,6,0,22"/>
          <Border Style="{StaticResource Card}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Width="48" Height="48" HorizontalAlignment="Left" VerticalAlignment="Top"
                      Background="{DynamicResource AccentSoftBrush}" CornerRadius="{StaticResource ControlCornerRadius}">
                <Viewbox Width="24" Height="24">
                  <Canvas Width="24" Height="24">
                    <Path Data="M12,20.2 L10.55,18.88 C5.4,14.2 2,11.12 2,7.35 C2,4.27 4.42,2 7.5,2 C9.24,2 10.91,2.81 12,4.09 C13.09,2.81 14.76,2 16.5,2 C19.58,2 22,4.27 22,7.35 C22,11.12 18.6,14.2 13.45,18.88 Z"
                          Fill="{DynamicResource AccentBrush}"/>
                  </Canvas>
                </Viewbox>
              </Border>
              <StackPanel Grid.Column="1">
                <TextBlock Text="RELYRの開発を支援" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="RELYRは無料で提供しています。役に立ったと感じた方は、今後の開発・保守を支援していただけます。"
                           TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" Margin="0,7,0,0"/>
                <TextBlock Text="支援は完全に任意です。支援の有無による機能差はありません。"
                           TextWrapping="Wrap" Foreground="{DynamicResource PrimaryText}" FontWeight="SemiBold" Margin="0,10,0,0"/>
                <Button x:Name="OpenSupportPageButton" Content="支援ページを開く" Click="OpenSupportPage_Click"
                        HorizontalAlignment="Left" MinWidth="168" Margin="0,18,0,0"
                        Background="{DynamicResource AccentStrongBrush}" Foreground="{DynamicResource AccentButtonText}" BorderBrush="{DynamicResource AccentBrush}"/>
                <TextBlock Text="既定のブラウザーでKo-fiを開きます。RELYRが決済情報を収集・保存することはありません。"
                           TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" FontSize="12" Margin="0,10,0,0"/>
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>

        <ScrollViewer x:Name="LayersScrollPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="LayersPanel" Margin="0,0,10,0">
          <TextBlock Text="レイヤー" FontSize="27" FontWeight="Bold"/>
          <TextBlock Text="レイヤーキーと切替表示を設定します。" Foreground="{DynamicResource SecondaryText}" Margin="0,6,0,16"/>
          <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="CapsLock レイヤー" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock x:Name="CapsRemapStatus" Margin="0,7,0,10" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}"/>
              <TextBlock Text="CapsLockをF13へ割り当て、レイヤー専用キーとして使用します。変更後はWindowsの再起動が必要です。" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,10"/>
              <StackPanel Orientation="Horizontal">
                <Button x:Name="EnableCapsRemapButton" Content="CapsLockレイヤーを有効にする" Click="EnableCapsRemap_Click"/>
                <Button x:Name="DisableCapsRemapButton" Content="元のCapsLockへ戻す" Click="DisableCapsRemap_Click"/>
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Padding="4">
            <StackPanel>
              <StackPanel>
                <TextBlock Text="Spaceキーのリピート" FontSize="18" FontWeight="SemiBold"/>
                <CheckBox x:Name="SpaceRepeatBox">
                  <TextBlock Text="1回押した後、もう一度長押しして連続入力" TextWrapping="Wrap"/>
                </CheckBox>
                <TextBlock Text="リピート開始までの時間" Foreground="{DynamicResource PrimaryText}"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                  <TextBox x:Name="SpaceRepeatDelayBox" Width="82" FontSize="15"/>
                  <TextBlock Text="ms（100～2000）" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}" Margin="8,0,0,0"/>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
        </ScrollViewer>

        <StackPanel x:Name="ArchivePanel" Visibility="Collapsed">
          <TextBlock Text="自動解凍" FontSize="27" FontWeight="Bold"/>
          <TextBlock Text="指定したフォルダーに置かれた圧縮ファイルを自動で展開します。" Foreground="{DynamicResource SecondaryText}" Margin="0,6,0,14"/>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="監視するフォルダー" FontSize="16" FontWeight="SemiBold"/>
              <Grid Margin="0,7,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ArchiveWatchFolderBox" VerticalContentAlignment="Center"/><Button Grid.Column="1" Content="参照…" Click="BrowseArchiveWatchFolder_Click" Margin="8,0,0,0"/></Grid>
              <TextBlock Text="解凍後の保存先" FontSize="16" FontWeight="SemiBold"/>
              <Grid Margin="0,7,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ArchiveDestinationFolderBox" VerticalContentAlignment="Center"/><Button Grid.Column="1" Content="参照…" Click="BrowseArchiveDestinationFolder_Click" Margin="8,0,0,0"/></Grid>
              <TextBlock Text="空欄の場合は監視フォルダー内へ展開します。" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,5"/>
              <CheckBox x:Name="ExtractBox" Content="指定したフォルダーの圧縮ファイルを自動解凍する" Margin="0,5,0,4"/>
              <CheckBox x:Name="DeleteBox" Content="解凍成功後に元の圧縮ファイルを削除する" Margin="25,4,0,4"/>
              <CheckBox x:Name="ArchiveOverlayBox" Content="解凍状況を画面下に表示する" Margin="25,4,0,4"/>
              <TextBlock Text="ZIP / 7Z / RAR / TAR / GZ / BZ2 / XZ などに対応。失敗時は元ファイルを削除しません。" TextWrapping="Wrap" Foreground="{DynamicResource AccentTextBrush}" Margin="25,3,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel x:Name="DataPanel" Visibility="Collapsed">
          <TextBlock Text="データ管理" FontSize="27" FontWeight="Bold"/>
          <TextBlock Text="設定のバックアップや別のPCへの移行に使用します。" Foreground="{DynamicResource SecondaryText}" Margin="0,6,0,22"/>
          <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="設定ファイル" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock Text="プロファイル、割り当て、マクロ、アプリ設定を1つのJSONファイルで保存・復元します。" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" Margin="0,6,0,18"/>
              <StackPanel Orientation="Horizontal">
                <Button Content="インポート" Click="Import_Click"/>
                <Button Content="エクスポート" Click="Export_Click"/>
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" BorderBrush="{DynamicResource DangerBrush}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,14,0"><TextBlock Text="すべての設定を初期化" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="全プロファイル、割り当て、マクロ、アプリ設定を初期状態へ戻します。" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" Margin="0,6,0,0"/></StackPanel>
              <Button x:Name="ResetAllButton" Grid.Column="1" Content="すべてリセット" Style="{StaticResource DangerButton}" Click="ResetAll_Click" VerticalAlignment="Center"/>
            </Grid>
          </Border>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1" Margin="0,18,0,0">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="キャンセル" Click="Cancel_Click"/>
          <Button Content="保存" Background="{DynamicResource AccentStrongBrush}" Foreground="{DynamicResource AccentButtonText}" BorderBrush="{DynamicResource AccentBrush}" Click="Save_Click"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</Window>
