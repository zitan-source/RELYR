<Window x:Class="RELYR.MacroWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RELYR"
        Title="マクロ" Width="1180" Height="760" MinWidth="940" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackground}" Foreground="{DynamicResource PrimaryText}"
        Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>
    <Style TargetType="Expander">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
      <Setter Property="Margin" Value="3"/>
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource AppTextBoxStyle}">
      <Setter Property="Background" Value="{DynamicResource InputBackground}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    </Style>
    <Style x:Key="FormStackButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Margin" Value="0,2,0,0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="MinHeight" Value="46"/>
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="CommandSurface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CommandSurface" Property="Background" Value="{DynamicResource ControlHoverBackground}"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="CommandSurface" Property="Background" Value="{DynamicResource ControlPressedBackground}"/><Setter TargetName="CommandSurface" Property="Opacity" Value="0.78"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CommandSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="CommandSurface" Property="BorderThickness" Value="1"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="CommandSurface" Property="Opacity" Value="0.42"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="0"/><Setter Property="Padding" Value="8"/>
    </Style>
    <Style x:Key="MacroFlatButton" TargetType="Button" BasedOn="{StaticResource FormStackButton}">
      <Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="MinHeight" Value="40"/><Setter Property="Padding" Value="12,0"/><Setter Property="Margin" Value="2"/>
    </Style>
    <Style x:Key="MacroIconButton" TargetType="Button" BasedOn="{StaticResource MacroFlatButton}">
      <Setter Property="Height" Value="40"/><Setter Property="MinWidth" Value="40"/><Setter Property="Padding" Value="0"/><Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource MacroFlatButton}">
      <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
      <Style.Triggers>
        <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsEnabled" Value="True"/><Condition Property="IsMouseOver" Value="True"/></MultiTrigger.Conditions><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></MultiTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="MacroModeButton" TargetType="Button" BasedOn="{StaticResource MacroFlatButton}">
      <Setter Property="Height" Value="42"/><Setter Property="Margin" Value="1"/><Setter Property="Padding" Value="7,0"/><Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Grid SnapsToDevicePixels="True">
          <Border x:Name="ModeSurface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <Border x:Name="ModeLine" Width="24" Height="2" Margin="0,0,0,2" VerticalAlignment="Bottom" Background="{DynamicResource AccentBrush}" CornerRadius="1" Opacity="0"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ModeSurface" Property="Background" Value="{DynamicResource ControlHoverBackground}"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="ModeSurface" Property="Opacity" Value="0.76"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ModeLine" Property="Opacity" Value="1"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ModeSurface" Property="Opacity" Value="0.42"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="MacroCommandIcon" TargetType="TextBlock">
      <Setter Property="Tag" Value="MacroCommandIcon"/><Setter Property="Width" Value="28"/><Setter Property="Height" Value="22"/>
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/><Setter Property="FontSize" Value="16"/>
      <Setter Property="LineHeight" Value="22"/><Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
    </Style>
    <Style x:Key="MacroListItemStyle" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,1"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="ListRow" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ListRow" Property="Background" Value="{DynamicResource ControlHoverBackground}"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="ListRow" Property="Background" Value="{DynamicResource AccentSoftBrush}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ListRow" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="ListRow" Property="BorderThickness" Value="1"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="MacroStepItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource MacroListItemStyle}">
      <Setter Property="Padding" Value="6,4"/><Setter Property="Margin" Value="0,1"/>
    </Style>
    <Style x:Key="MacroStepKindBar" TargetType="Border">
      <Setter Property="Width" Value="3"/>
      <Setter Property="CornerRadius" Value="1.5"/>
      <Setter Property="Margin" Value="0,4,10,4"/>
      <Setter Property="Background" Value="{DynamicResource EditingKeyBorderBrush}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding VisualKind}" Value="{x:Static local:MacroStepVisualKind.Mouse}">
          <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding VisualKind}" Value="{x:Static local:MacroStepVisualKind.Wait}">
          <Setter Property="Background" Value="{DynamicResource MutedText}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding VisualKind}" Value="{x:Static local:MacroStepVisualKind.Action}">
          <Setter Property="Background" Value="{DynamicResource ActionShortcutIconBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding VisualKind}" Value="{x:Static local:MacroStepVisualKind.Macro}">
          <Setter Property="Background" Value="{DynamicResource ActionLaunchIconBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding VisualKind}" Value="{x:Static local:MacroStepVisualKind.Text}">
          <Setter Property="Background" Value="{DynamicResource ActionKeyIconBrush}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="MacroTitleTextBox" TargetType="TextBox" BasedOn="{StaticResource AppTextBoxStyle}">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0,0,34,0"/><Setter Property="FontSize" Value="21"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Grid SnapsToDevicePixels="True">
          <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Focusable="False"/>
          <Button x:Name="EditMacroNameButton" Style="{StaticResource AppButtonStyle}" Width="30" Height="32" MinWidth="0" MinHeight="0" Padding="0" Margin="0"
                  Background="Transparent" BorderBrush="Transparent" BorderThickness="0" HorizontalAlignment="Right" VerticalAlignment="Center"
                  Focusable="False" Click="EditMacro_Click" ToolTip="マクロ名を編集" AutomationProperties.Name="マクロ名を編集">
            <TextBlock x:Name="EditMacroNameGlyph" Text="&#xE70F;" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="{DynamicResource MutedText}"/>
          </Button>
          <Border x:Name="MacroNameFocusLine" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource AccentBrush}" Opacity="0"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="EditMacroNameGlyph" Property="Foreground" Value="{DynamicResource PrimaryText}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="MacroNameFocusLine" Property="Opacity" Value="1"/><Setter TargetName="EditMacroNameGlyph" Property="Foreground" Value="{DynamicResource AccentTextBrush}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TabControl">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="MinWidth" Value="82"/>
      <Setter Property="Margin" Value="0,0,6,8"/>
      <Setter Property="Padding" Value="11,8"/>
      <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
      <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource ControlCornerRadius}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource ControlHoverBackground}"/>
                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="TabBorder" Property="Opacity" Value="0.45"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="190"/><ColumnDefinition Width="16"/><ColumnDefinition MinWidth="380"/><ColumnDefinition Width="16"/><ColumnDefinition Width="300"/>
      </Grid.ColumnDefinitions>

      <Border x:Name="MacroListPane" Style="{StaticResource Card}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="マクロ一覧" FontSize="16" FontWeight="Bold"/>
          <TextBox x:Name="MacroSearchBox" Grid.Row="1" Height="{StaticResource ControlHeight}" Margin="0,8,0,8" TextChanged="MacroSearchChanged" ToolTip="マクロ名を検索"/>
          <ListBox x:Name="MacroList" Grid.Row="2" SelectionChanged="MacroChanged" Background="Transparent" Foreground="{DynamicResource PrimaryText}" BorderBrush="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource MacroListItemStyle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="2,0">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding Steps.Count, Converter={StaticResource LocalizedMacroStepCountConverter}}" Foreground="{DynamicResource SecondaryText}" FontSize="10"/>
            </StackPanel></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <Grid Grid.Row="3" Margin="0,7,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Button x:Name="NewMacroButton" Grid.Column="0" Style="{StaticResource MacroIconButton}" Margin="0" Click="New_Click" ToolTip="新規マクロを追加"><TextBlock FontFamily="Segoe MDL2 Assets" FontSize="15" Text="&#xE710;"/></Button>
            <Button x:Name="DuplicateMacroButton" Grid.Column="1" Style="{StaticResource MacroIconButton}" Margin="0" Click="DuplicateMacro_Click" IsEnabled="False" ToolTip="選択したマクロを複製"><TextBlock FontFamily="Segoe MDL2 Assets" FontSize="15" Text="&#xE8C8;"/></Button>
            <Button x:Name="EditMacroButton" Grid.Column="2" Style="{StaticResource MacroIconButton}" Margin="0" Click="EditMacro_Click" IsEnabled="False" ToolTip="選択したマクロの名前を変更"><TextBlock FontFamily="Segoe MDL2 Assets" FontSize="15" Text="&#xE70F;"/></Button>
            <Button x:Name="DeleteMacroButton" Grid.Column="3" Height="40" MinWidth="40" Margin="0" HorizontalAlignment="Stretch" Click="DeleteMacro_Click" IsEnabled="False" Style="{StaticResource DangerButton}" ToolTip="選択したマクロを削除" Padding="0"><TextBlock FontFamily="Segoe MDL2 Assets" FontSize="15" Text="&#xE74D;"/></Button>
          </Grid>
        </Grid>
      </Border>

      <Border x:Name="MacroStepsPane" Grid.Column="2" Style="{StaticResource Card}">
        <Grid>
          <TextBlock x:Name="EmptyHint" Text="［＋ 新規］を押して、最初のマクロを作成してください。" Foreground="{DynamicResource WarningBrush}" FontSize="16" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30"/>
          <Grid x:Name="EditorPanel" IsEnabled="False" Opacity="0.45">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <Grid Margin="0,0,0,6">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox x:Name="NameBox" Style="{StaticResource MacroTitleTextBox}" Height="44" IsReadOnly="True" TextChanged="NameChanged" KeyDown="NameBox_KeyDown"/>
              <Button x:Name="ConfirmNameButton" Grid.Column="1" Content="確定" Click="ConfirmName_Click" Margin="8,2,0,2" Visibility="Collapsed"
                      Background="{DynamicResource AccentStrongBrush}" Foreground="{DynamicResource AccentButtonText}" BorderBrush="{DynamicResource AccentBrush}"/>
            </Grid>

            <Grid Grid.Row="1" Margin="0,12,0,7">
              <TextBlock Text="手順" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
              <TextBlock x:Name="StepSummary" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}"/>
            </Grid>

            <ListBox x:Name="StepList" Grid.Row="2" Margin="0,0,0,7" Background="Transparent" Foreground="{DynamicResource PrimaryText}" BorderBrush="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource MacroStepItemStyle}"
                     SelectionMode="Extended" SelectionChanged="StepSelectionChanged" MouseDoubleClick="StepList_DoubleClick" AllowDrop="True"
                     PreviewMouseLeftButtonDown="StepList_PreviewMouseLeftButtonDown" PreviewMouseRightButtonDown="StepList_PreviewMouseRightButtonDown"
                     PreviewMouseMove="StepList_PreviewMouseMove" DragOver="StepList_DragOver" DragLeave="StepList_DragLeave" Drop="StepList_Drop" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ContextMenu>
                <ContextMenu Opened="StepContextMenu_Opened">
                  <MenuItem x:Name="CopyStepsMenuItem" Header="コピー" Click="CopySteps_Click" InputGestureText="Ctrl+C"/>
                  <MenuItem x:Name="PasteStepsMenuItem" Header="貼り付け" Click="PasteSteps_Click" InputGestureText="Ctrl+V"/>
                  <Separator/>
                  <MenuItem x:Name="DeleteStepsMenuItem" Header="削除" Click="DeleteStep_Click" InputGestureText="Delete"/>
                </ContextMenu>
              </ListBox.ContextMenu>
              <ListBox.ItemTemplate><DataTemplate><Border Padding="2,3"><Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="44"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource MacroStepKindBar}"/>
                <Border Grid.Column="1" Tag="MacroStepNumber" Width="34" Height="34" HorizontalAlignment="Left" VerticalAlignment="Center" Background="Transparent" BorderBrush="Transparent" BorderThickness="0">
                  <TextBlock Text="{Binding Number}" Foreground="{DynamicResource PrimaryText}" FontFamily="Cascadia Mono, Consolas" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="2"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" Foreground="{DynamicResource SecondaryText}" FontSize="10" TextTrimming="CharacterEllipsis"/></StackPanel>
                <TextBlock Grid.Column="3" Text="{Binding DelayLabel}" Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <Border Grid.Column="4" Tag="MacroStepDragHandle" Width="28" Height="34" Margin="6,0,0,0" Background="Transparent" CornerRadius="7" Cursor="SizeAll" ToolTip="ドラッグして並べ替え">
                  <TextBlock Text="&#xE712;" FontFamily="Segoe Fluent Icons" FontSize="15" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
              </Grid></Border></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <Border x:Name="DropIndicator" Grid.Row="2" Height="3" Margin="5,0,5,0" VerticalAlignment="Top" Background="{DynamicResource AccentBrush}" CornerRadius="2" Visibility="Collapsed" IsHitTestVisible="False" Panel.ZIndex="20"/>
            <Popup x:Name="StepDragPreviewPopup" Grid.Row="2" Placement="Relative" PlacementTarget="{Binding ElementName=StepList}" AllowsTransparency="True" IsHitTestVisible="False" Opened="StepDragPreviewPopup_Opened">
              <Border Width="330" Padding="10,8" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="10" Opacity="0.95" Effect="{DynamicResource GroupCardShadowEffect}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Width="32" Height="32" Background="{DynamicResource ControlBackground}" CornerRadius="8"><TextBlock x:Name="StepDragPreviewNumber" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/></Border>
                  <StackPanel Grid.Column="1"><TextBlock x:Name="StepDragPreviewTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="StepDragPreviewDetail" Foreground="{DynamicResource SecondaryText}" FontSize="10" TextTrimming="CharacterEllipsis"/></StackPanel>
                  <TextBlock Grid.Column="2" Text="&#xE712;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </Grid>
              </Border>
            </Popup>

            <WrapPanel Grid.Row="3" HorizontalAlignment="Right">
              <Button x:Name="UndoButton" Style="{StaticResource MacroFlatButton}" Content="↶ 元に戻す" Click="Undo_Click" IsEnabled="False"/>
              <Button x:Name="MoveUpButton" Style="{StaticResource MacroFlatButton}" Content="↑ 上へ" Click="MoveUp_Click" IsEnabled="False"/>
              <Button x:Name="MoveDownButton" Style="{StaticResource MacroFlatButton}" Content="↓ 下へ" Click="MoveDown_Click" IsEnabled="False"/>
              <Button x:Name="DeleteStepButton" Content="選択した手順を削除" Click="DeleteStep_Click" IsEnabled="False" Style="{StaticResource DangerButton}"/>
              <Button x:Name="ClearStepsButton" Content="すべて消去" Click="Clear_Click" IsEnabled="False" Style="{StaticResource DangerButton}"/>
            </WrapPanel>
          </Grid>
        </Grid>
      </Border>

      <Border x:Name="MacroToolsPane" Grid.Column="4" Style="{StaticResource Card}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
          <UniformGrid Columns="3" Margin="0,0,0,8">
            <Button x:Name="ManualModeButton" Style="{StaticResource MacroModeButton}" Click="EditorModeButton_Click" Tag="0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" Margin="0,0,5,0"/><TextBlock Text="追加"/></StackPanel></Button>
            <Button x:Name="RecordModeButton" Style="{StaticResource MacroModeButton}" Click="EditorModeButton_Click" Tag="1"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="&#xE7C8;" FontFamily="Segoe Fluent Icons" Margin="0,0,5,0"/><TextBlock Text="記録"/></StackPanel></Button>
            <Button x:Name="StepEditModeButton" Style="{StaticResource MacroModeButton}" Click="EditorModeButton_Click" Tag="2"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons" Margin="0,0,5,0"/><TextBlock Text="編集"/></StackPanel></Button>
          </UniformGrid>
        <TabControl x:Name="EditorTabs" Grid.Row="1" Background="Transparent" BorderThickness="0" SelectedIndex="0" SelectionChanged="EditorTabs_SelectionChanged">
          <TabControl.Template>
            <ControlTemplate TargetType="TabControl">
              <ContentPresenter ContentSource="SelectedContent" Margin="0"/>
            </ControlTemplate>
          </TabControl.Template>
          <TabItem Header="手動追加">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="4,10,4,4">
              <TextBlock Text="キーを追加" FontSize="16" FontWeight="Bold"/>
              <Button x:Name="KeypadInputButton" Click="KeypadInput_Click" Style="{StaticResource FormStackButton}"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Style="{StaticResource MacroCommandIcon}" Text="&#xE765;"/><TextBlock Text="キーパッドから入力" VerticalAlignment="Center"/></StackPanel></Button>
              <Button x:Name="ManualCaptureButton" PreviewKeyDown="ManualCapture_KeyDown" PreviewKeyUp="ManualCapture_KeyUp" Click="ManualCapture_Click" LostKeyboardFocus="ManualCapture_LostKeyboardFocus" Style="{StaticResource FormStackButton}" Background="{DynamicResource AccentSoftBrush}"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Style="{StaticResource MacroCommandIcon}" Text="&#xE768;"/><TextBlock x:Name="ManualCaptureLabel" Text="手動追加を開始" VerticalAlignment="Center"/></StackPanel></Button>
              <Grid Margin="8,7,8,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="ManualStatus" Text="停止中" Foreground="{DynamicResource AccentTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Ctrl + Shift + F12" Foreground="{DynamicResource SecondaryText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
              </Grid>

              <TextBlock Text="手順を追加" FontSize="16" FontWeight="Bold" Margin="0,4,0,2"/>
              <Button Click="AddCatalogAction_Click" Style="{StaticResource FormStackButton}"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Style="{StaticResource MacroCommandIcon}" Text="&#xE734;"/><TextBlock Text="定番アクション" VerticalAlignment="Center"/></StackPanel></Button>
              <Button Click="AddApplicationAction_Click" Style="{StaticResource FormStackButton}"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Style="{StaticResource MacroCommandIcon}" Text="&#xE71B;"/><TextBlock Text="アプリ・ファイル・URL" VerticalAlignment="Center"/></StackPanel></Button>
              <Button x:Name="CoordinateCaptureButton" Click="CoordinateCapture_Click" Style="{StaticResource FormStackButton}"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Style="{StaticResource MacroCommandIcon}" Text="&#xE81D;"/><TextBlock x:Name="CoordinateCaptureLabel" Text="座標を記録" VerticalAlignment="Center"/></StackPanel></Button>
              <TextBlock Text="文字列" FontWeight="SemiBold" Margin="0,16,0,6"/>
              <TextBox x:Name="ManualTextBox" AcceptsReturn="True" MinHeight="58" Padding="12,10" VerticalContentAlignment="Top" TextWrapping="Wrap"/>
              <Button x:Name="AddTextActionButton" Click="AddTextAction_Click" Style="{StaticResource FormStackButton}"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Style="{StaticResource MacroCommandIcon}" Text="T" FontFamily="Segoe UI Variable Display" FontWeight="SemiBold"/><TextBlock Text="文字列を手順へ追加" VerticalAlignment="Center"/></StackPanel></Button>

              <TextBlock Text="待機時間を追加" FontWeight="SemiBold" Margin="0,24,0,6"/>
              <Grid>
                <TextBox x:Name="WaitBox" Text="500" Padding="12,0,44,0"/>
                <TextBlock Text="ms" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" IsHitTestVisible="False"/>
              </Grid>
              <Button x:Name="AddWaitButton" Click="AddWait_Click" Style="{StaticResource FormStackButton}"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Style="{StaticResource MacroCommandIcon}" Text="&#xE823;"/><TextBlock Text="待機時間を手順へ追加" VerticalAlignment="Center"/></StackPanel></Button>
            </StackPanel></ScrollViewer>
          </TabItem>

          <TabItem Header="自動記録">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="4,12,4,8">
              <TextBlock Text="自動記録" FontSize="16" FontWeight="Bold"/>
              <TextBlock Text="現在の手順の末尾へ追加します。" Foreground="{DynamicResource SecondaryText}" Margin="0,4,0,18"/>
              <CheckBox x:Name="RecordKeyboardBox" Content="キーボード操作を記録する" Foreground="{DynamicResource PrimaryText}" Margin="2,0,2,0" Checked="RecordKeyboardChanged" Unchecked="RecordKeyboardChanged"/>
              <TextBlock Text="キー操作の記録方法" Foreground="{DynamicResource SecondaryText}" Margin="0,20,0,6"/>
              <StackPanel Margin="4,0,2,0">
                <RadioButton x:Name="RecordMappedActionsBox" GroupName="KeyRecordingMode" Content="割り当て済みの操作を記録" Foreground="{DynamicResource PrimaryText}" Margin="0,3" Checked="KeyRecordingModeChanged"/>
                <RadioButton x:Name="RecordPhysicalInputBox" GroupName="KeyRecordingMode" Content="押した物理キーを記録" Foreground="{DynamicResource PrimaryText}" Margin="0,3" Checked="KeyRecordingModeChanged"/>
              </StackPanel>

              <Expander Header="マウスの記録" Margin="0,20,0,0">
                <StackPanel Margin="8,6,2,2">
                  <CheckBox x:Name="RecordMouseMovesBox" Content="カーソルの移動軌跡も記録" Foreground="{DynamicResource PrimaryText}" Margin="2,3,2,7" Checked="RecordMouseMovesChanged" Unchecked="RecordMouseMovesChanged"/>
                  <StackPanel x:Name="MouseMovementModePanel" Margin="18,0,0,3">
                    <RadioButton x:Name="RelativeMouseMovementBox" GroupName="MouseMovementMode" Content="開始位置からの動き" Foreground="{DynamicResource PrimaryText}" Margin="2" Checked="MouseMovementModeChanged"/>
                    <RadioButton x:Name="FixedMousePositionBox" GroupName="MouseMovementMode" Content="画面上の同じ位置" Foreground="{DynamicResource PrimaryText}" Margin="2" Checked="MouseMovementModeChanged"/>
                  </StackPanel>
                </StackPanel>
              </Expander>
              <TextBlock Text="すべてのマクロに共通の設定です。" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" FontSize="10" Margin="2,8,2,0"/>
              <Button x:Name="RecordButton" Click="Record_Click" Style="{StaticResource DangerButton}" Padding="8,10" Margin="0,22,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Style="{StaticResource MacroCommandIcon}" Text="&#xE7C8;"/><TextBlock x:Name="RecordButtonLabel" Text="記録を開始" VerticalAlignment="Center"/></StackPanel>
              </Button>
              <TextBlock x:Name="RecordStatus" Text="停止中" TextAlignment="Center" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="2,8,2,0"/>
            </StackPanel></ScrollViewer>
          </TabItem>

          <TabItem Header="手順編集">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="4,12,4,8">
              <TextBlock Text="手順編集" FontSize="16" FontWeight="Bold"/>
              <TextBlock x:Name="SelectedStepTitle" Text="中央の一覧から手順を選択してください。" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,4,0,20"/>
              <Separator Margin="0,0,0,16" Background="{DynamicResource SubtleBorderBrush}"/>
              <TextBlock Text="開始前の待機" FontWeight="SemiBold"/>
              <Grid Margin="0,7,0,0">
                <TextBox x:Name="SelectedStepDelayBox" Text="0" IsEnabled="False" Padding="12,0,44,0"/>
                <TextBlock Text="ms" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" IsHitTestVisible="False"/>
              </Grid>
              <Button x:Name="ApplyStepEditButton" Style="{StaticResource FormStackButton}" Content="変更を反映" Click="ApplyStepEdit_Click" IsEnabled="False" Background="{DynamicResource AccentSoftBrush}" Margin="0,16,0,0" HorizontalContentAlignment="Center"/>
              <Button x:Name="ReplaceStepActionButton" Style="{StaticResource FormStackButton}" Content="定番アクションに変更…" Click="ReplaceStepAction_Click" IsEnabled="False" Margin="0,2,0,0" HorizontalContentAlignment="Center"/>
              <TextBlock Text="手順をダブルクリックすると、ここで編集できます。" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="2,20,2,0"/>
            </StackPanel></ScrollViewer>
          </TabItem>
        </TabControl>
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.Row="1" Margin="2,12,2,0">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
        <TextBlock x:Name="AssignmentTargetText" Foreground="{DynamicResource SecondaryText}" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="UnsavedStatus" Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold"/>
        <TextBlock x:Name="FooterStatus" Foreground="{DynamicResource AccentTextBrush}" TextWrapping="Wrap"/>
      </StackPanel>
      <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
        <Button x:Name="TestButton" Style="{StaticResource MacroFlatButton}" Content="▶ テスト実行" Click="TestMacro_Click" IsEnabled="False"/>
        <Button x:Name="StopTestButton" Style="{StaticResource MacroFlatButton}" Content="■ 停止" Click="StopTest_Click" IsEnabled="False"/>
        <Button x:Name="ShortcutButton" Style="{StaticResource MacroFlatButton}" Content="デスクトップに実行アイコンを作成" Click="CreateShortcut_Click" IsEnabled="False"/>
        <Button x:Name="SaveButton" Style="{StaticResource AccentAppButtonStyle}" Height="40" Content="保存" Click="Save_Click" BorderThickness="0" IsEnabled="False"/>
        <Button x:Name="UseButton" Content="このマクロを割り当て" Click="Use_Click"
                Background="{DynamicResource AccentStrongBrush}" Foreground="{DynamicResource AccentButtonText}" BorderBrush="{DynamicResource AccentBrush}"
                Visibility="Collapsed" IsEnabled="False"/>
        <Button Style="{StaticResource MacroFlatButton}" Content="閉じる" Click="Close_Click"/>
      </WrapPanel>
    </Grid>
  </Grid>
</Window>
