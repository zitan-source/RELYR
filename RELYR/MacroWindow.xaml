<Window x:Class="RELYR.MacroWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="マクロの作成と編集" Width="980" Height="720" MinWidth="820" MinHeight="580"
        WindowStartupLocation="CenterOwner" Background="#11141B" Foreground="#E8ECF4"
        Closing="Window_Closing">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="11,7"/>
      <Setter Property="Background" Value="#293142"/><Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#465168"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#354158"/><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#72E0C1"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#176B5D"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#1D2330"/><Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#465168"/><Setter Property="Padding" Value="7"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="#202938"/><Setter Property="BorderBrush" Value="#3C4960"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="5"/>
      <Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
  </Window.Resources>

  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="マクロ" FontSize="26" FontWeight="Bold" Foreground="#72E0C1"/>
      <TextBlock Text="手動でキーを順番に追加できます。必要な場面だけ記録を開始すると、現在の手順の末尾へ追記します。" Foreground="#AAB4C8" Margin="0,4,0,14"/>
    </StackPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Grid>
        <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ListBox x:Name="MacroList" DisplayMemberPath="Name" SelectionChanged="MacroChanged" Background="#171D27" Foreground="White" BorderBrush="#465168"/>
        <WrapPanel Grid.Row="1" Margin="0,6,0,0">
          <Button x:Name="NewMacroButton" Content="＋ 新規" Click="New_Click"/>
          <Button x:Name="EditMacroButton" Content="編集" Click="EditMacro_Click" IsEnabled="False"/>
          <Button x:Name="DeleteMacroButton" Content="削除" Click="DeleteMacro_Click" IsEnabled="False"/>
        </WrapPanel>
      </Grid>

      <Grid Grid.Column="2">
        <TextBlock x:Name="EmptyHint" Text="左下の［＋ 新規］を押して、最初のマクロを作成してください。" Foreground="#FFD58A" FontSize="16" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40"/>
        <ScrollViewer x:Name="EditorScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
          <StackPanel x:Name="EditorPanel" IsEnabled="False" Opacity="0.45">
            <TextBlock Text="マクロ名"/>
            <Grid Margin="0,4,0,12">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox x:Name="NameBox" IsReadOnly="True" TextChanged="NameChanged" KeyDown="NameBox_KeyDown"/>
              <Button x:Name="ConfirmNameButton" Grid.Column="1" Content="名前を確定" Click="ConfirmName_Click" Margin="8,0,0,0" Visibility="Collapsed" Background="#176B5D"/>
            </Grid>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="1. 手動入力／マクロの記録" FontSize="17" FontWeight="Bold"/>
                <TextBlock Text="最初は手動入力です。下のボタンを選んで実際にキーを押すと、押す・離すの順番が手順へ追加されます。" Foreground="#AAB4C8" TextWrapping="Wrap" Margin="0,3,0,7"/>
                <Button x:Name="ManualCaptureButton" Content="ここを選択して、追加するキーを押してください" HorizontalContentAlignment="Center" Padding="12,10" PreviewKeyDown="ManualCapture_KeyDown" PreviewKeyUp="ManualCapture_KeyUp" GotKeyboardFocus="ManualCapture_GotKeyboardFocus" LostKeyboardFocus="ManualCapture_LostKeyboardFocus"/>
                <TextBlock x:Name="ManualStatus" Text="手動入力では、キーを1つずつ手順の末尾へ追加します。" Foreground="#72E0C1" TextWrapping="Wrap" Margin="3,3,3,10"/>
                <Separator Margin="0,4,0,10" Background="#3C4960"/>
                <TextBlock Text="自動で記録する場合" FontWeight="SemiBold"/>
                <TextBlock Text="記録開始後の操作を現在の手順の末尾へ追記します。終了は Ctrl + Shift + F12 です。終了操作自体は記録されません。" Foreground="#AAB4C8" TextWrapping="Wrap" Margin="0,3,0,7"/>
                <CheckBox x:Name="RecordKeyboardBox" Content="キーボード操作を記録する" Foreground="White" Margin="2,3,2,5" Checked="RecordKeyboardChanged" Unchecked="RecordKeyboardChanged"/>
                <StackPanel Margin="22,0,0,8">
                  <TextBlock Text="キー割り当ての記録方法" Foreground="#AAB4C8" Margin="0,0,0,3"/>
                  <RadioButton x:Name="RecordMappedActionsBox" GroupName="KeyRecordingMode" Content="このツールで割り当てたアクションを記録（おすすめ）" Foreground="White" Margin="2" Checked="KeyRecordingModeChanged"/>
                  <RadioButton x:Name="RecordPhysicalInputBox" GroupName="KeyRecordingMode" Content="押した物理キーをそのまま記録" Foreground="White" Margin="2" Checked="KeyRecordingModeChanged"/>
                </StackPanel>
                <CheckBox x:Name="RecordMouseMovesBox" Content="マウスカーソルの移動軌跡も記録する（記録量が増えます）" Foreground="White" Margin="2,3,2,8" Checked="RecordMouseMovesChanged" Unchecked="RecordMouseMovesChanged"/>
                <StackPanel x:Name="MouseMovementModePanel" Margin="22,0,0,8">
                  <TextBlock Text="カーソル移動の再現方法" Foreground="#AAB4C8" Margin="0,0,0,3"/>
                  <RadioButton x:Name="RelativeMouseMovementBox" GroupName="MouseMovementMode" Content="開始位置からの動きを再現（相対移動）" Foreground="White" Margin="2" Checked="MouseMovementModeChanged"/>
                  <RadioButton x:Name="FixedMousePositionBox" GroupName="MouseMovementMode" Content="画面上の同じ位置を再現（固定位置）" Foreground="White" Margin="2" Checked="MouseMovementModeChanged"/>
                </StackPanel>
                <Button x:Name="RecordButton" Content="● マクロの記録を開始（末尾へ追記）" Click="Record_Click" Background="#8B3341"/>
                <TextBlock x:Name="RecordStatus" Text="停止中" HorizontalAlignment="Center" Foreground="#AAB4C8"/>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="2. 待機時間を追加" FontSize="17" FontWeight="Bold"/>
                <WrapPanel>
                  <TextBox x:Name="WaitBox" Text="500" Width="110" Margin="0,5,5,5"/>
                  <TextBlock Text="ミリ秒" VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <Button Content="待機を追加" Click="AddWait_Click"/>
                </WrapPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0">
              <StackPanel>
                <TextBlock Text="3. 登録された手順" FontSize="17" FontWeight="Bold"/>
                <ListBox x:Name="StepList" Height="210" Margin="0,8,0,4" Background="#171D27" Foreground="White" BorderBrush="#465168" SelectionMode="Extended"/>
                <WrapPanel HorizontalAlignment="Right">
                  <Button Content="↑ 上へ" Click="MoveUp_Click"/><Button Content="↓ 下へ" Click="MoveDown_Click"/>
                  <Button Content="選択した手順を削除" Click="DeleteStep_Click"/><Button Content="すべて消去" Click="Clear_Click"/>
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>

    <Grid Grid.Row="2" Margin="0,14,0,0">
      <StackPanel VerticalAlignment="Center">
        <TextBlock x:Name="AssignmentTargetText" Foreground="#AAB4C8"/>
        <TextBlock x:Name="FooterStatus" Foreground="#72E0C1" TextWrapping="Wrap"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="閉じる" Click="Close_Click"/>
        <Button x:Name="ShortcutButton" Content="ショートカット作成" Click="CreateShortcut_Click" IsEnabled="False"/>
        <Button x:Name="SaveButton" Content="適応" Click="Save_Click" Background="#244B4A" IsEnabled="False"/>
        <Button x:Name="UseButton" Content="このマクロを割り当て" Click="Use_Click" Background="#1F8F7B" Visibility="Collapsed" IsEnabled="False"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
