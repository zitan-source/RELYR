<Window x:Class="RELYR.MacroWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RELYR"
        Title="マクロ" Width="1180" Height="760" MinWidth="940" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackground}" Foreground="{DynamicResource PrimaryText}"
        Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>
    <Style TargetType="Expander">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="11,7"/>
      <Setter Property="Background" Value="{DynamicResource ControlBackground}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ControlHoverBackground}"/><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ControlPressedBackground}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource InputBackground}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="Padding" Value="7"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource CardBackground}"/><Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="12"/>
    </Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource DangerBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource DangerForeground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="DangerBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter TargetName="DangerBorder" Property="Background" Value="{DynamicResource DangerHoverBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerHoverForeground}"/>
          </Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="DangerBorder" Property="Opacity" Value="0.8"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="DangerBorder" Property="Opacity" Value="0.42"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="MacroStepKindBar" TargetType="Border">
      <Setter Property="Width" Value="4"/>
      <Setter Property="CornerRadius" Value="2"/>
      <Setter Property="Margin" Value="0,1,8,1"/>
      <Setter Property="Background" Value="{DynamicResource EditingKeyBorderBrush}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding VisualKind}" Value="{x:Static local:MacroStepVisualKind.Mouse}">
          <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding VisualKind}" Value="{x:Static local:MacroStepVisualKind.Wait}">
          <Setter Property="Background" Value="{DynamicResource MutedText}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding VisualKind}" Value="{x:Static local:MacroStepVisualKind.Action}">
          <Setter Property="Background" Value="{DynamicResource ActionShortcutIconBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding VisualKind}" Value="{x:Static local:MacroStepVisualKind.Macro}">
          <Setter Property="Background" Value="{DynamicResource ActionLaunchIconBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding VisualKind}" Value="{x:Static local:MacroStepVisualKind.Text}">
          <Setter Property="Background" Value="{DynamicResource ActionKeyIconBrush}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="TabControl">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="MinWidth" Value="82"/>
      <Setter Property="Margin" Value="0,0,6,8"/>
      <Setter Property="Padding" Value="11,8"/>
      <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
      <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
              <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource ControlHoverBackground}"/>
                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="TabBorder" Property="Opacity" Value="0.45"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <Grid Margin="2,0,2,12">
      <StackPanel>
        <TextBlock Text="マクロ" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
        <TextBlock Text="左でマクロを選び、中央の手順を編集します。追加・記録・詳細編集は右側から行えます。" Foreground="{DynamicResource SecondaryText}" Margin="0,3,0,0"/>
      </StackPanel>
      <TextBlock x:Name="UnsavedStatus" Text="" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold"/>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="190"/><ColumnDefinition Width="12"/><ColumnDefinition MinWidth="380"/><ColumnDefinition Width="12"/><ColumnDefinition Width="300"/>
      </Grid.ColumnDefinitions>

      <Border Style="{StaticResource Card}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="マクロ一覧" FontSize="16" FontWeight="Bold"/>
          <TextBox x:Name="MacroSearchBox" Grid.Row="1" Margin="0,8,0,8" TextChanged="MacroSearchChanged" ToolTip="マクロ名を検索"/>
          <ListBox x:Name="MacroList" Grid.Row="2" SelectionChanged="MacroChanged" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource BorderBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="7,5">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding Steps.Count, StringFormat={}{0} 手順}" Foreground="{DynamicResource SecondaryText}" FontSize="10"/>
            </StackPanel></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <UniformGrid Grid.Row="3" Columns="2" Margin="0,7,0,0">
            <Button x:Name="NewMacroButton" Content="＋ 新規" Click="New_Click"/>
            <Button x:Name="DuplicateMacroButton" Content="複製" Click="DuplicateMacro_Click" IsEnabled="False"/>
            <Button x:Name="EditMacroButton" Content="名前変更" Click="EditMacro_Click" IsEnabled="False"/>
            <Button x:Name="DeleteMacroButton" Content="削除" Click="DeleteMacro_Click" IsEnabled="False" Style="{StaticResource DangerButton}"/>
          </UniformGrid>
        </Grid>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource Card}">
        <Grid>
          <TextBlock x:Name="EmptyHint" Text="［＋ 新規］を押して、最初のマクロを作成してください。" Foreground="{DynamicResource WarningBrush}" FontSize="16" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30"/>
          <Grid x:Name="EditorPanel" IsEnabled="False" Opacity="0.45">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="マクロ名" Foreground="{DynamicResource SecondaryText}"/><TextBox x:Name="NameBox" Margin="0,4,0,0" IsReadOnly="True" TextChanged="NameChanged" KeyDown="NameBox_KeyDown"/></StackPanel>
              <Button x:Name="ConfirmNameButton" Grid.Column="1" Content="名前を確定" Click="ConfirmName_Click" Margin="8,21,0,0" Visibility="Collapsed"
                      Background="{DynamicResource AccentStrongBrush}" Foreground="{DynamicResource AccentButtonText}" BorderBrush="{DynamicResource AccentBrush}"/>
            </Grid>

            <Grid Grid.Row="1" Margin="0,12,0,7">
              <TextBlock Text="登録された手順" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
              <TextBlock x:Name="StepSummary" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}"/>
            </Grid>

            <ListBox x:Name="StepList" Grid.Row="2" Margin="0,0,0,7" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource BorderBrush}"
                     SelectionMode="Extended" SelectionChanged="StepSelectionChanged" MouseDoubleClick="StepList_DoubleClick" AllowDrop="True"
                     PreviewMouseLeftButtonDown="StepList_PreviewMouseLeftButtonDown" PreviewMouseRightButtonDown="StepList_PreviewMouseRightButtonDown"
                     PreviewMouseMove="StepList_PreviewMouseMove" DragOver="StepList_DragOver" DragLeave="StepList_DragLeave" Drop="StepList_Drop" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ContextMenu>
                <ContextMenu Opened="StepContextMenu_Opened">
                  <MenuItem x:Name="CopyStepsMenuItem" Header="コピー" Click="CopySteps_Click" InputGestureText="Ctrl+C"/>
                  <MenuItem x:Name="PasteStepsMenuItem" Header="貼り付け" Click="PasteSteps_Click" InputGestureText="Ctrl+V"/>
                  <Separator/>
                  <MenuItem x:Name="DeleteStepsMenuItem" Header="削除" Click="DeleteStep_Click" InputGestureText="Delete"/>
                </ContextMenu>
              </ListBox.ContextMenu>
              <ListBox.ItemTemplate><DataTemplate><Border Padding="7,5"><Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="30"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource MacroStepKindBar}"/>
                <TextBlock Grid.Column="1" Text="{Binding Number}" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" Foreground="{DynamicResource SecondaryText}" FontSize="10" TextTrimming="CharacterEllipsis"/></StackPanel>
                <TextBlock Grid.Column="3" Text="{Binding DelayLabel}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
              </Grid></Border></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <Border x:Name="DropIndicator" Grid.Row="2" Height="3" Margin="5,0,5,0" VerticalAlignment="Top" Background="{DynamicResource AccentBrush}" CornerRadius="2" Visibility="Collapsed" IsHitTestVisible="False" Panel.ZIndex="20"/>

            <WrapPanel Grid.Row="3" HorizontalAlignment="Right">
              <Button x:Name="UndoButton" Content="↶ 元に戻す" Click="Undo_Click" IsEnabled="False"/>
              <Button x:Name="MoveUpButton" Content="↑ 上へ" Click="MoveUp_Click" IsEnabled="False"/>
              <Button x:Name="MoveDownButton" Content="↓ 下へ" Click="MoveDown_Click" IsEnabled="False"/>
              <Button x:Name="DeleteStepButton" Content="選択した手順を削除" Click="DeleteStep_Click" IsEnabled="False"/>
              <Button x:Name="ClearStepsButton" Content="すべて消去" Click="Clear_Click" IsEnabled="False" Style="{StaticResource DangerButton}"/>
            </WrapPanel>
          </Grid>
        </Grid>
      </Border>

      <Border Grid.Column="4" Style="{StaticResource Card}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
          <UniformGrid Columns="3" Margin="0,0,0,8">
            <Button x:Name="ManualModeButton" Content="手動追加" Click="EditorModeButton_Click" Tag="0"/>
            <Button x:Name="RecordModeButton" Content="自動記録" Click="EditorModeButton_Click" Tag="1"/>
            <Button x:Name="StepEditModeButton" Content="手順編集" Click="EditorModeButton_Click" Tag="2"/>
          </UniformGrid>
        <TabControl x:Name="EditorTabs" Grid.Row="1" Background="Transparent" BorderThickness="0" SelectedIndex="0" SelectionChanged="EditorTabs_SelectionChanged">
          <TabControl.Template>
            <ControlTemplate TargetType="TabControl">
              <ContentPresenter ContentSource="SelectedContent" Margin="0"/>
            </ControlTemplate>
          </TabControl.Template>
          <TabItem Header="手動追加">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="4,10,4,4">
              <TextBlock Text="キーを追加" FontSize="16" FontWeight="Bold"/>
              <TextBlock Text="画面上のキーボード・マウスから選ぶか、実際のキー入力を記録できます。" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,3,0,7"/>
              <Button x:Name="KeypadInputButton" Content="キーパッドから入力…" Click="KeypadInput_Click" HorizontalContentAlignment="Left" Padding="12,10"/>
              <Button x:Name="ManualCaptureButton" Content="手動追加を開始" PreviewKeyDown="ManualCapture_KeyDown" PreviewKeyUp="ManualCapture_KeyUp" Click="ManualCapture_Click" LostKeyboardFocus="ManualCapture_LostKeyboardFocus" Padding="12,10" Background="{DynamicResource AccentSoftBrush}"/>
              <TextBlock x:Name="ManualStatus" Text="停止中" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="3,3,3,12"/>
              <TextBlock Text="自動記録は Ctrl + Shift + F12 でも停止できます。" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="2,0,2,10"/>

              <Separator Margin="0,2,0,10" Background="{DynamicResource SubtleBorderBrush}"/>
              <Button Content="定番アクションを追加…" Click="AddCatalogAction_Click" HorizontalContentAlignment="Left"/>
              <Button Content="アプリ・ファイル・URLを追加…" Click="AddApplicationAction_Click" HorizontalContentAlignment="Left"/>
              <Button x:Name="CoordinateCaptureButton" Content="座標を記録" Click="CoordinateCapture_Click" HorizontalContentAlignment="Left"/>
              <TextBlock Text="文字列を追加" FontWeight="SemiBold" Margin="3,10,3,3"/>
              <TextBox x:Name="ManualTextBox" AcceptsReturn="True" MinHeight="58" TextWrapping="Wrap"/>
              <Button Content="文字列を手順へ追加" Click="AddTextAction_Click"/>

              <TextBlock Text="待機時間を追加" FontWeight="SemiBold" Margin="3,12,3,3"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="WaitBox" Text="500"/><TextBlock Grid.Column="1" Text="ms" VerticalAlignment="Center" Margin="7,0,0,0"/></Grid>
              <Button Content="選択位置の後ろへ待機を追加" Click="AddWait_Click"/>
            </StackPanel></ScrollViewer>
          </TabItem>

          <TabItem Header="自動記録">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="4,10,4,4">
              <TextBlock Text="自動で記録" FontSize="16" FontWeight="Bold"/>
              <TextBlock Text="現在の手順の末尾へ追記します。終了は Ctrl + Shift + F12 です。" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,3,0,8"/>
              <CheckBox x:Name="RecordKeyboardBox" Content="キーボード操作を記録する" Foreground="{DynamicResource PrimaryText}" Margin="2,3,2,7" Checked="RecordKeyboardChanged" Unchecked="RecordKeyboardChanged"/>
              <TextBlock Text="キー割り当ての記録方法" Foreground="{DynamicResource SecondaryText}"/>
              <RadioButton x:Name="RecordMappedActionsBox" GroupName="KeyRecordingMode" Content="割り当て済みのアクションを記録" Foreground="{DynamicResource PrimaryText}" Margin="2,5,2,2" Checked="KeyRecordingModeChanged"/>
              <RadioButton x:Name="RecordPhysicalInputBox" GroupName="KeyRecordingMode" Content="押した物理キーを記録" Foreground="{DynamicResource PrimaryText}" Margin="2" Checked="KeyRecordingModeChanged"/>

              <Expander Header="マウス記録の詳細" Margin="0,10,0,7">
                <StackPanel Margin="8,6,2,2">
                  <CheckBox x:Name="RecordMouseMovesBox" Content="カーソルの移動軌跡も記録" Foreground="{DynamicResource PrimaryText}" Margin="2,3,2,7" Checked="RecordMouseMovesChanged" Unchecked="RecordMouseMovesChanged"/>
                  <StackPanel x:Name="MouseMovementModePanel" Margin="18,0,0,3">
                    <RadioButton x:Name="RelativeMouseMovementBox" GroupName="MouseMovementMode" Content="開始位置からの動き" Foreground="{DynamicResource PrimaryText}" Margin="2" Checked="MouseMovementModeChanged"/>
                    <RadioButton x:Name="FixedMousePositionBox" GroupName="MouseMovementMode" Content="画面上の同じ位置" Foreground="{DynamicResource PrimaryText}" Margin="2" Checked="MouseMovementModeChanged"/>
                  </StackPanel>
                </StackPanel>
              </Expander>
              <TextBlock Text="※ ここで選ぶ記録方法は、すべてのマクロで共通です。" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" FontSize="10" Margin="2,0,2,8"/>
              <Button x:Name="RecordButton" Content="● 記録を開始（末尾へ追記）" Click="Record_Click"
                      Style="{StaticResource DangerButton}" Padding="12,10"/>
              <TextBlock x:Name="RecordStatus" Text="停止中" TextAlignment="Center" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="2,5"/>
            </StackPanel></ScrollViewer>
          </TabItem>

          <TabItem Header="手順編集">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="4,10,4,4">
              <TextBlock Text="選択した手順" FontSize="16" FontWeight="Bold"/>
              <TextBlock x:Name="SelectedStepTitle" Text="中央から手順を選択してください。" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,4,0,12"/>
              <TextBlock Text="実行前の待機時間" FontWeight="SemiBold"/>
              <Grid Margin="0,4,0,7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SelectedStepDelayBox" Text="0" IsEnabled="False"/><TextBlock Grid.Column="1" Text="ms" VerticalAlignment="Center" Margin="7,0,0,0"/></Grid>
              <Button x:Name="ApplyStepEditButton" Content="変更を反映" Click="ApplyStepEdit_Click" IsEnabled="False" Background="{DynamicResource AccentSoftBrush}"/>
              <Button x:Name="ReplaceStepActionButton" Content="別の定番アクションへ変更…" Click="ReplaceStepAction_Click" IsEnabled="False"/>
              <TextBlock Text="手順をダブルクリックすると、ここへ移動します。複数の手順は Shift または Ctrl を押しながら選択できます。" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="2,12,2,0"/>
            </StackPanel></ScrollViewer>
          </TabItem>
        </TabControl>
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.Row="2" Margin="2,12,2,0">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
        <TextBlock x:Name="AssignmentTargetText" Foreground="{DynamicResource SecondaryText}" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="FooterStatus" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"/>
      </StackPanel>
      <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
        <Button x:Name="TestButton" Content="▶ テスト実行" Click="TestMacro_Click" IsEnabled="False"/>
        <Button x:Name="StopTestButton" Content="■ 停止" Click="StopTest_Click" IsEnabled="False"/>
        <Button x:Name="ShortcutButton" Content="デスクトップに実行アイコンを作成" Click="CreateShortcut_Click" IsEnabled="False"/>
        <Button x:Name="SaveButton" Content="保存" Click="Save_Click" Background="{DynamicResource AccentSoftBrush}" IsEnabled="False"/>
        <Button x:Name="UseButton" Content="このマクロを割り当て" Click="Use_Click"
                Background="{DynamicResource AccentStrongBrush}" Foreground="{DynamicResource AccentButtonText}" BorderBrush="{DynamicResource AccentBrush}"
                Visibility="Collapsed" IsEnabled="False"/>
        <Button Content="閉じる" Click="Close_Click"/>
      </WrapPanel>
    </Grid>
  </Grid>
</Window>
