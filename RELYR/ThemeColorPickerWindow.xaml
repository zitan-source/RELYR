<Window x:Class="RELYR.ThemeColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="色を選択" Width="580" Height="530" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource AppBackground}" Foreground="{DynamicResource PrimaryText}">
  <Window.Resources>
    <Style TargetType="TextBox" BasedOn="{StaticResource AppTextBoxStyle}">
      <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style x:Key="ColorSlider" TargetType="Slider">
      <Setter Property="Height" Value="28"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" VerticalAlignment="Center">
                <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Background="Transparent" BorderThickness="0"/></Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Width="18" Height="18">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Ellipse Fill="{DynamicResource PrimaryText}" Stroke="{DynamicResource AppBackground}" StrokeThickness="3"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Background="Transparent" BorderThickness="0"/></Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="24,20,24,22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Margin="0,0,0,16">
      <TextBlock Text="色を選択" FontSize="23" FontWeight="SemiBold"/>
      <TextBlock Text="プリセットを選ぶか、色相・彩度・明度を調整してください" Foreground="{DynamicResource SecondaryText}" Margin="0,5,0,0"/>
    </StackPanel>

    <Border Grid.Row="1" Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource SubtleBorderBrush}"
            BorderThickness="1" CornerRadius="{StaticResource SurfaceCornerRadius}" Padding="14" Margin="0,0,0,16" SnapsToDevicePixels="True">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border x:Name="ColorPreview" Width="78" Height="78" CornerRadius="{StaticResource ControlCornerRadius}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" SnapsToDevicePixels="True"/>
        <StackPanel Grid.Column="2" VerticalAlignment="Center">
          <TextBlock Text="選択中の色" Foreground="{DynamicResource SecondaryText}" FontSize="12"/>
          <TextBox x:Name="HexBox" Width="150" HorizontalAlignment="Left" Margin="0,7,0,0"
                   FontFamily="Cascadia Mono, Consolas" FontWeight="SemiBold" MaxLength="7"
                   TextChanged="HexBox_TextChanged" PreviewKeyDown="HexBox_PreviewKeyDown"/>
          <TextBlock x:Name="HexError" Text="#RRGGBBで入力してください" Foreground="{DynamicResource DangerBrush}" FontSize="11" Margin="0,4,0,0" Visibility="Collapsed"/>
        </StackPanel>
      </Grid>
    </Border>

    <StackPanel Grid.Row="2" Margin="0,0,0,16">
      <TextBlock Text="プリセット" FontWeight="SemiBold" Margin="0,0,0,9"/>
      <WrapPanel x:Name="PresetPanel"/>
    </StackPanel>

    <Border Grid.Row="3" Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource SubtleBorderBrush}"
            BorderThickness="1" CornerRadius="{StaticResource SurfaceCornerRadius}" Padding="16,13" SnapsToDevicePixels="True">
      <Grid>
        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>

        <TextBlock Text="色相" VerticalAlignment="Center"/>
        <Grid Grid.Column="1" Margin="8,0">
          <Border Height="8" CornerRadius="4" VerticalAlignment="Center">
            <Border.Background><LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop Color="#FF453A" Offset="0"/><GradientStop Color="#FFD60A" Offset="0.17"/><GradientStop Color="#32D74B" Offset="0.34"/><GradientStop Color="#64D2FF" Offset="0.5"/><GradientStop Color="#0A84FF" Offset="0.67"/><GradientStop Color="#BF5AF2" Offset="0.84"/><GradientStop Color="#FF453A" Offset="1"/></LinearGradientBrush></Border.Background>
          </Border>
          <Slider x:Name="HueSlider" Style="{StaticResource ColorSlider}" Minimum="0" Maximum="360" ValueChanged="Slider_ValueChanged"/>
        </Grid>
        <TextBlock x:Name="HueValue" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas"/>

        <TextBlock Grid.Row="1" Text="彩度" VerticalAlignment="Center"/>
        <Grid Grid.Row="1" Grid.Column="1" Margin="8,0">
          <Border x:Name="SaturationTrack" Height="8" CornerRadius="4" VerticalAlignment="Center"/>
          <Slider x:Name="SaturationSlider" Style="{StaticResource ColorSlider}" Minimum="0" Maximum="100" ValueChanged="Slider_ValueChanged"/>
        </Grid>
        <TextBlock x:Name="SaturationValue" Grid.Row="1" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas"/>

        <TextBlock Grid.Row="2" Text="明度" VerticalAlignment="Center"/>
        <Grid Grid.Row="2" Grid.Column="1" Margin="8,0">
          <Border x:Name="BrightnessTrack" Height="8" CornerRadius="4" VerticalAlignment="Center"/>
          <Slider x:Name="BrightnessSlider" Style="{StaticResource ColorSlider}" Minimum="0" Maximum="100" ValueChanged="Slider_ValueChanged"/>
        </Grid>
        <TextBlock x:Name="BrightnessValue" Grid.Row="2" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas"/>
      </Grid>
    </Border>

    <Grid Grid.Row="4" Margin="0,18,0,0">
      <TextBlock Text="Enterで適用 / Escでキャンセル" Foreground="{DynamicResource MutedText}" FontSize="11" VerticalAlignment="Center"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Style="{StaticResource AppButtonStyle}" Content="キャンセル" Width="104" Margin="0,0,8,0" IsCancel="True"/>
        <Button Style="{StaticResource AccentAppButtonStyle}" Content="この色を使う" Width="126" IsDefault="True" Click="Apply_Click"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
