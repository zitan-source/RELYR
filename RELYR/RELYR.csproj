<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AppHostDotNetSearch>Global</AppHostDotNetSearch>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>RELYR</AssemblyName>
    <Product>RELYR</Product>
    <Description>キーボードとマウスの入力を自由に割り当てるWindowsアプリ</Description>
    <Version>0.1.383</Version>
    <Authors>RELYR</Authors>
    <Copyright>Copyright (c) 2026 RELYR contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Assets\RELYR.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\RELYR.ico" />
    <Resource Include="Assets\Tutorial\*.png"
              Exclude="Assets\Tutorial\tutorial-deck-editor.png;Assets\Tutorial\tutorial-macro-editor.png" />
    <EmbeddedResource Include="Localization\*.json" />
    <Content Include="Assets\RELYR-Macro.ico" Link="RELYR-Macro.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <None Include="VirtualDesktopAccessor.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <None Include="..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <None Include="..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <PackageReference Include="SharpCompress" Version="0.49.1" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="System.IO.Pipes.AccessControl" Version="6.0.0-preview.5.21301.5" />
    <PackageReference Include="System.Management" Version="10.0.11" />
  </ItemGroup>

  <PropertyGroup Condition="'$(ProductionPublish)' == 'true'">
    <DefineConstants>$(DefineConstants);PRODUCTION_PUBLISH</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(HookDiagnostics)' == 'true'">
    <DefineConstants>$(DefineConstants);HOOK_DIAGNOSTICS</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(ProductionPublish)' == 'true'">
    <Compile Remove="SelfTest.cs;ConfigurationMatrixTest.cs;AdminDeckIntegrationTest.cs;EngineIntegrationTest.cs;ModifierClickScenarioTest.cs;ProfileSwitchRuntimeTest.cs;UiIntegrationTest.cs;ShellDropIntegrationTest.cs;StartupIntegrationTest.cs;ShutdownIntegrationTest.cs;UpdateIntegrationTest.cs;VirtualDesktopIntegrationTest.cs" />
  </ItemGroup>

</Project>
