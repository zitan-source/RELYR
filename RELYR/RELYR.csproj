<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>RELYR</AssemblyName>
    <Product>RELYR</Product>
    <Description>キーボードとマウスの入力を自由に割り当てるWindowsアプリ</Description>
    <Version>0.1.144</Version>
    <Authors>RELYR</Authors>
    <Copyright>Copyright (c) 2026 RELYR contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Assets\RELYR.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\RELYR.ico" />
    <Content Include="Assets\RELYR-Macro.ico" Link="RELYR-Macro.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <None Include="VirtualDesktopAccessor.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <None Include="..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <None Include="..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <PackageReference Include="SharpCompress" Version="0.49.1" />
  </ItemGroup>

  <PropertyGroup Condition="'$(ProductionPublish)' == 'true'">
    <DefineConstants>$(DefineConstants);PRODUCTION_PUBLISH</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(ProductionPublish)' == 'true'">
    <Compile Remove="SelfTest.cs;EngineIntegrationTest.cs;UiIntegrationTest.cs;StartupIntegrationTest.cs;ShutdownIntegrationTest.cs;UpdateIntegrationTest.cs;VirtualDesktopIntegrationTest.cs" />
  </ItemGroup>

</Project>
