<Window x:Class="RELYR.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RELYR チュートリアル"
        Width="1160" Height="800" MinWidth="920" MinHeight="680"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource PrimaryText}">
  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>
    <Style x:Key="PageTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="30"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="PageSubtitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
      <Setter Property="Margin" Value="0,5,0,0"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="TutorialCard" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="{StaticResource SurfaceCornerRadius}"/>
      <Setter Property="Padding" Value="18"/>
    </Style>
    <Style x:Key="ScreenshotFrame" TargetType="Border">
      <Setter Property="Background" Value="#111315"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="ClipToBounds" Value="True"/>
    </Style>
    <Style x:Key="StepNumber" TargetType="Border">
      <Setter Property="Width" Value="30"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="CornerRadius" Value="15"/>
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="KeyCap" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource KeyBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}"/>
      <Setter Property="Padding" Value="16,11"/>
    </Style>
    <Style x:Key="TutorialButton" TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
      <Setter Property="MinWidth" Value="104"/>
      <Setter Property="Height" Value="42"/>
      <Setter Property="Margin" Value="8,0,0,0"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource AccentAppButtonStyle}">
      <Setter Property="MinWidth" Value="148"/>
      <Setter Property="Height" Value="42"/>
      <Setter Property="Margin" Value="8,0,0,0"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
  </Window.Resources>

  <Grid Background="{DynamicResource AppBackground}">
    <Grid.RowDefinitions>
      <RowDefinition Height="68"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="76"/>
    </Grid.RowDefinitions>
    <Border Background="{DynamicResource HeaderBackground}"
            BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,0,1">
      <Grid Margin="26,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image x:Name="TutorialAppIcon" Width="32" Height="32" Source="Assets/RELYR.ico"
                 Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock Text="RELYR" FontSize="20" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
          <TextBlock Text="クイックガイド" Foreground="{DynamicResource SecondaryText}"
                     FontSize="13" Margin="12,2,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse x:Name="Dot1" Width="8" Height="8" Margin="5,0"/>
          <Ellipse x:Name="Dot2" Width="8" Height="8" Margin="5,0"/>
          <Ellipse x:Name="Dot3" Width="8" Height="8" Margin="5,0"/>
          <Ellipse x:Name="Dot4" Width="8" Height="8" Margin="5,0"/>
          <Ellipse x:Name="Dot5" Width="8" Height="8" Margin="5,0"/>
        </StackPanel>
        <TextBlock x:Name="PageCounterText" Grid.Column="2" Text="1 / 5"
                   HorizontalAlignment="Right" VerticalAlignment="Center"
                   Foreground="{DynamicResource SecondaryText}" FontSize="13"/>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="30,22,30,20">
      <Grid x:Name="PageOne">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="66"/></Grid.RowDefinitions>
        <StackPanel Margin="2,0,0,16">
          <TextBlock Style="{StaticResource PageTitle}" Text="Actionをキーへ"/>
          <TextBlock Style="{StaticResource PageSubtitle}" Text="左から順に、3つだけ。"/>
        </StackPanel>
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions><ColumnDefinition Width="3.4*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource ScreenshotFrame}">
            <Image Source="Assets/Tutorial/tutorial-main-window.png" Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="RELYRのメイン画面"/>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource ScreenshotFrame}">
            <Image Source="Assets/Tutorial/tutorial-action-library.png" Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Action一覧"/>
          </Border>
        </Grid>
        <UniformGrid Grid.Row="2" Columns="3" Margin="0,14,0,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
            <Border Style="{StaticResource StepNumber}"><TextBlock Text="1" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <TextBlock Text="レイヤーを選ぶ" FontSize="16" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
            <Border Style="{StaticResource StepNumber}"><TextBlock Text="2" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <TextBlock Text="Actionを開く" FontSize="16" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
            <Border Style="{StaticResource StepNumber}"><TextBlock Text="3" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <TextBlock Text="キーへドラッグ" FontSize="16" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
        </UniformGrid>
      </Grid>

      <Grid x:Name="PageTwo" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="58"/></Grid.RowDefinitions>
        <StackPanel Margin="2,0,0,16">
          <TextBlock Style="{StaticResource PageTitle}" Text="クリックで細かく設定"/>
          <TextBlock Style="{StaticResource PageSubtitle}" Text="割り当てたキーをクリック。"/>
        </StackPanel>
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource TutorialCard}" Padding="14">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <TextBlock Text="Actionを絞り込む" FontSize="16" FontWeight="SemiBold"/>
              <Border Grid.Row="1" Style="{StaticResource ScreenshotFrame}">
                <Image Source="Assets/Tutorial/tutorial-action-categories.png" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Actionカテゴリ"/>
              </Border>
            </Grid>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource TutorialCard}" Padding="14">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <TextBlock Text="短押し・長押しを調整" FontSize="16" FontWeight="SemiBold"/>
              <Border Grid.Row="1" Style="{StaticResource ScreenshotFrame}">
                <Image Source="Assets/Tutorial/tutorial-assignment-detail.png" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="割り当ての詳細"/>
              </Border>
            </Grid>
          </Border>
        </Grid>
        <UniformGrid Grid.Row="2" Columns="3" Margin="90,13,90,0">
          <TextBlock Text="短押し" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center"/>
          <TextBlock Text="長押し" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center"/>
          <TextBlock Text="パス・文字列" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center"/>
        </UniformGrid>
      </Grid>

      <Grid x:Name="PageThree" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="2,0,0,16">
          <TextBlock Style="{StaticResource PageTitle}" Text="Space連打とCapsLock"/>
          <TextBlock Style="{StaticResource PageSubtitle}" Text="ここだけは最初に確認。"/>
        </StackPanel>
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions><ColumnDefinition Width="1.55*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource ScreenshotFrame}">
            <Image Source="Assets/Tutorial/tutorial-settings-layer.png" Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="レイヤー設定"/>
          </Border>
          <Grid Grid.Column="2">
            <Grid.RowDefinitions><RowDefinition Height="1.25*"/><RowDefinition Height="16"/><RowDefinition Height="0.75*"/></Grid.RowDefinitions>
            <Border Style="{StaticResource TutorialCard}">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Spaceを連続入力" FontSize="20" FontWeight="Bold"/>
                <StackPanel Orientation="Horizontal" Margin="0,18,0,15">
                  <Border Style="{StaticResource KeyCap}"><TextBlock Text="Space" FontSize="16" FontWeight="SemiBold"/></Border>
                  <TextBlock Text="→" FontSize="23" Foreground="{DynamicResource AccentTextBrush}" Margin="12,0" VerticalAlignment="Center"/>
                  <Border Style="{StaticResource KeyCap}">
                    <StackPanel>
                      <TextBlock Text="Space" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                      <TextBlock Text="2回目を長押し" FontSize="11" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Center"/>
                    </StackPanel>
                  </Border>
                </StackPanel>
                <TextBlock Text="Spaceを2回続けて押し、2回目を押したままにする"
                           FontSize="15" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}"/>
              </StackPanel>
            </Border>
            <Border Grid.Row="2" Style="{StaticResource TutorialCard}">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="CapsLockレイヤー" FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="変更後はWindowsを再起動" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource WarningBrush}" Margin="0,10,0,0"/>
              </StackPanel>
            </Border>
          </Grid>
        </Grid>
      </Grid>

      <Grid x:Name="PageFour" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="54"/></Grid.RowDefinitions>
        <StackPanel Margin="2,0,0,16">
          <TextBlock Style="{StaticResource PageTitle}" Text="保存と安全"/>
          <TextBlock Style="{StaticResource PageSubtitle}" Text="初期値は自動保存オン。"/>
        </StackPanel>
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions><ColumnDefinition Width="1.55*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource ScreenshotFrame}">
            <Image Source="Assets/Tutorial/tutorial-settings-general.png" Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="一般設定の保存項目"/>
          </Border>
          <Grid Grid.Column="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Style="{StaticResource ScreenshotFrame}" Height="152">
              <Image Source="Assets/Tutorial/tutorial-sidebar-status.png" Stretch="Uniform"
                     RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="左下の自動保存表示"/>
            </Border>
            <Border Grid.Row="2" Style="{StaticResource TutorialCard}">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="自動保存をオフにする" FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="左下の「自動保存 オン」をクリック" FontSize="15" Margin="0,15,0,0"/>
                <TextBlock Text="または  設定 → 一般 → 保存" FontSize="15" Margin="0,9,0,0"/>
                <TextBlock Text="オフ時は上部の「保存」で反映" FontSize="14" Foreground="{DynamicResource SecondaryText}" Margin="0,14,0,0"/>
              </StackPanel>
            </Border>
          </Grid>
        </Grid>
        <Border Grid.Row="2" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="1" CornerRadius="{StaticResource ControlCornerRadius}" Margin="0,13,0,0" Padding="14,8">
          <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14">
            <Run Text="一時停止：左下の「エンジン稼働中」"/><Run Text="   ／   "/><Run Text="緊急停止：Ctrl + Alt + Shift + F12"/>
          </TextBlock>
        </Border>
      </Grid>

      <Grid x:Name="PageFive" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="2,0,0,16">
          <TextBlock Style="{StaticResource PageTitle}" Text="必要になったら、さらに便利"/>
          <TextBlock Style="{StaticResource PageSubtitle}" Text="すべて左メニューから。"/>
        </StackPanel>
        <Grid Grid.Row="1">
          <Grid.RowDefinitions><RowDefinition Height="1.45*"/><RowDefinition Height="14"/><RowDefinition Height="0.75*"/></Grid.RowDefinitions>
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource ScreenshotFrame}">
            <Grid>
              <Image Source="Assets/Tutorial/tutorial-profile-manager.png" Stretch="Uniform"
                     RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="プロファイル画面"/>
              <Border Background="#DB111315" CornerRadius="7" Padding="10,6" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10">
                <TextBlock Text="アプリ別プロファイル" Foreground="White" FontWeight="SemiBold"/>
              </Border>
            </Grid>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource ScreenshotFrame}">
            <Grid>
              <Image Source="Assets/Tutorial/tutorial-gesture-manager.png" Stretch="Uniform"
                     RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="ジェスチャー画面"/>
              <Border Background="#DB111315" CornerRadius="7" Padding="10,6" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10">
                <TextBlock Text="ジェスチャー" Foreground="White" FontWeight="SemiBold"/>
              </Border>
            </Grid>
          </Border>
          <Border Grid.Row="2" Style="{StaticResource ScreenshotFrame}">
            <Grid>
              <Image Source="Assets/Tutorial/tutorial-deck-overlay.png" Stretch="Uniform"
                     RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Deckオーバーレイ"/>
              <Border Background="#DB111315" CornerRadius="7" Padding="10,6" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10">
                <TextBlock Text="Deck" Foreground="White" FontWeight="SemiBold"/>
              </Border>
            </Grid>
          </Border>
          <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource ScreenshotFrame}">
            <Grid>
              <Image Source="Assets/Tutorial/tutorial-macro-steps.png" Stretch="Uniform"
                     RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="マクロ手順"/>
              <Border Background="#DB111315" CornerRadius="7" Padding="10,6" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10">
                <TextBlock Text="マクロ" Foreground="White" FontWeight="SemiBold"/>
              </Border>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Grid>

    <Border Grid.Row="2" Background="{DynamicResource FooterBackground}"
            BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,1,0,0">
      <Grid Margin="26,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <CheckBox x:Name="DoNotShowAgainBox" Content="次回から表示しない" IsChecked="True"
                    Foreground="{DynamicResource PrimaryText}" FontSize="13"/>
          <Button x:Name="SkipButton" Content="スキップ" Click="Skip_Click"
                  Background="Transparent" BorderThickness="0" Foreground="{DynamicResource AccentTextBrush}"
                  HorizontalAlignment="Left" Padding="0" Margin="0,5,0,0" Cursor="Hand"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="BackButton" Content="戻る" Style="{StaticResource TutorialButton}" Click="Back_Click" Visibility="Collapsed"/>
          <Button x:Name="NextButton" Content="次へ" Style="{StaticResource PrimaryButton}" Click="Next_Click" IsDefault="True"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
