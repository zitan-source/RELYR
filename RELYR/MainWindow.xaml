<Window x:Class="RELYR.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RELYR" Height="780" Width="1100" MinHeight="620" MinWidth="800" WindowStartupLocation="CenterScreen"
        Background="#0B1118" Foreground="#F1F5F7" Closing="Window_Closing" PreviewMouseDown="MainWindow_PreviewMouseDown">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="10,7"/>
      <Setter Property="Background" Value="#1B2733"/><Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#33465A"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#5E748C"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#146B5C"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Height" Value="40"/><Setter Property="MinWidth" Value="80"/>
      <Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="12,0"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style TargetType="ToggleButton"><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="10,7"/><Setter Property="Background" Value="#293142"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#465168"/><Setter Property="Cursor" Value="Hand"/><Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="#1F8F7B"/><Setter Property="BorderBrush" Value="#72E0C1"/></Trigger></Style.Triggers></Style>
    <Style x:Key="ToolbarToggleStyle" TargetType="ToggleButton"><Setter Property="Height" Value="40"/><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="13,0"/><Setter Property="MinWidth" Value="116"/><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#293142"/><Setter Property="BorderBrush" Value="#465168"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="ToggleBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="#176B5D"/><Setter Property="BorderBrush" Value="#72E0C1"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#B7C5DB"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ToggleBorder" Property="Opacity" Value="0.78"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="EngineToggleStyle" TargetType="ToggleButton">
      <Setter Property="Height" Value="40"/><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="16,0"/>
      <Setter Property="MinWidth" Value="128"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#F4F7FB"/><Setter Property="Background" Value="#343D50"/>
      <Setter Property="BorderBrush" Value="#71809B"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="ToolTip" Value="クリックして入力変換を一時停止・再開します"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
        <Border x:Name="EngineBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse x:Name="StateLamp" Width="10" Height="10" Margin="0,0,8,0" Fill="#AAB4C8"/>
            <TextBlock x:Name="StateText" Text="エンジン停止中" Foreground="{TemplateBinding Foreground}" FontWeight="{TemplateBinding FontWeight}" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True">
            <Setter Property="Background" Value="#176B5D"/><Setter Property="BorderBrush" Value="#72E0C1"/>
            <Setter TargetName="StateLamp" Property="Fill" Value="#8FFFD9"/><Setter TargetName="StateText" Property="Text" Value="エンジン稼働中"/>
          </Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="EngineBorder" Property="BorderBrush" Value="#B7C5DB"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="EngineBorder" Property="Opacity" Value="0.78"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="EngineBorder" Property="Opacity" Value="0.5"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="KeyButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="MinWidth" Value="48"/><Setter Property="Height" Value="48"/><Setter Property="FontSize" Value="12"/>
      <EventSetter Event="PreviewMouseLeftButtonDown" Handler="DestinationButton_PreviewMouseDown"/>
      <EventSetter Event="PreviewMouseRightButtonDown" Handler="InputButton_RightClick"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="KeyBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4"><Grid><Border Height="1" Margin="3,1,3,0" VerticalAlignment="Top" Background="#24FFFFFF" IsHitTestVisible="False"/><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="KeyBorder" Property="BorderBrush" Value="#72E0C1"/><Setter TargetName="KeyBorder" Property="Opacity" Value="0.94"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="KeyBorder" Property="Background" Value="#178D79"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="LayerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Padding" Value="8,0"/>
    </Style>
    <Style x:Key="MouseHotspot" TargetType="Button">
      <Setter Property="Background" Value="#E6293446"/><Setter Property="BorderBrush" Value="#72E0C1"/>
      <Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="2"/><Setter Property="Margin" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="9"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="MouseButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="MouseButtonBorder" Property="Background" Value="#176B5D"/><Setter TargetName="MouseButtonBorder" Property="BorderBrush" Value="#B7FFE9"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="MouseButtonBorder" Property="Background" Value="#0F4F45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
      <EventSetter Event="PreviewMouseLeftButtonDown" Handler="DestinationButton_PreviewMouseDown"/>
      <EventSetter Event="PreviewMouseRightButtonDown" Handler="InputButton_RightClick"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Margin" Value="0,4,0,10"/><Setter Property="Padding" Value="7"/>
      <Setter Property="Background" Value="#1D2330"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#3B465C"/>
    </Style>
    <Style TargetType="ComboBox"><Setter Property="Margin" Value="0,4,0,10"/><Setter Property="Padding" Value="6"/><Setter Property="Foreground" Value="#11141B"/><Setter Property="Background" Value="#E8ECF4"/></Style>
    <Style x:Key="ToolbarComboBoxStyle" TargetType="ComboBox">
      <Setter Property="Height" Value="40"/><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="11,0,34,0"/>
      <Setter Property="Foreground" Value="#F4F7FB"/><Setter Property="Background" Value="#242D3C"/>
      <Setter Property="BorderBrush" Value="#465168"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="#F4F7FB"/><Setter Property="Background" Value="#202836"/><Setter Property="Padding" Value="10,7"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#176B5D"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#1F8F7B"/></Trigger></Style.Triggers>
      </Style></Setter.Value></Setter>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <Border x:Name="ComboBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"/>
          <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" IsHitTestVisible="False"/>
          <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0" Fill="#B7C5DB" Data="M 0 0 L 8 0 L 4 5 Z" IsHitTestVisible="False"/>
          <ToggleButton Background="Transparent" BorderThickness="0" Focusable="False" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
            <Border Margin="0,3,0,0" Width="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="320" Background="#202836" BorderBrush="#526079" BorderThickness="1" CornerRadius="4">
              <ScrollViewer><ItemsPresenter/></ScrollViewer>
            </Border>
          </Popup>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboBorder" Property="BorderBrush" Value="#71809B"/></Trigger>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboBorder" Property="BorderBrush" Value="#72E0C1"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ComboBorder" Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E8ECF4"/></Style>
    <Style TargetType="Expander"><Setter Property="Foreground" Value="#E8ECF4"/></Style>
    <Style TargetType="ListBox"><Setter Property="Foreground" Value="#E8ECF4"/></Style>
    <Style x:Key="ActionChoice" TargetType="ListBoxItem"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#293142"/><Setter Property="BorderBrush" Value="#465168"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="2"/><Setter Property="Cursor" Value="Hand"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#1F8F7B"/><Setter Property="BorderBrush" Value="#72E0C1"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="#72E0C1"/></Trigger></Style.Triggers></Style>
    <Style x:Key="LowerGroupFrame" TargetType="Border">
      <Setter Property="Background" Value="#24121B25"/><Setter Property="BorderBrush" Value="#7533465A"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="7"/>
    </Style>
    <Style x:Key="LowerGroupTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#8FA0B2"/><Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="10,4,0,0"/>
    </Style>
  </Window.Resources>

  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#101720" Padding="10">
       <WrapPanel x:Name="ToolbarPanel" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock x:Name="ProductNameText" Text="RELYR" FontWeight="Bold" FontSize="19" Margin="4,5,12,0" Foreground="#72E0C1" VerticalAlignment="Center"/>
        <TextBlock x:Name="VersionText" Text="v—" Visibility="Collapsed" Width="0" Height="0" Margin="0"/>
        <TextBlock Text="配列" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#AAB4C8"/><ComboBox x:Name="KeyboardLayoutBox" Style="{StaticResource ToolbarComboBoxStyle}" Width="82" SelectionChanged="KeyboardLayoutChanged"><ComboBoxItem Content="JIS"/><ComboBoxItem Content="US"/></ComboBox>
        <TextBlock Text="プロファイル" VerticalAlignment="Center" Margin="8,0,6,0" Foreground="#AAB4C8"/>
        <ComboBox x:Name="ProfileBox" Style="{StaticResource ToolbarComboBoxStyle}" Width="180" SelectionChanged="ProfileChanged"/>
        <Button x:Name="NewProfileButton" Style="{StaticResource ToolbarButtonStyle}" Content="＋" Width="40" MinWidth="40" Padding="0" Click="NewProfile_Click" ToolTip="新しいプロファイルを追加"/><Button Style="{StaticResource ToolbarButtonStyle}" Content="名前変更" Click="RenameProfile_Click"/>
        <Button Style="{StaticResource ToolbarButtonStyle}" Content="割り当てコピー" Click="CopyProfile_Click"/><Button Style="{StaticResource ToolbarButtonStyle}" Content="自動切替" Click="ConfigureProfileAutoSwitch_Click"/>
        <Button Style="{StaticResource ToolbarButtonStyle}" Content="削除" Click="DeleteProfile_Click"/><Button Style="{StaticResource ToolbarButtonStyle}" Content="保存して反映" Click="Save_Click" Background="#1F8F7B" BorderBrush="#72E0C1"/>
        <Button Style="{StaticResource ToolbarButtonStyle}" Content="● マクロ" Click="OpenMacros_Click" ToolTip="操作を記録してキーへ割り当てます"/>
        <ToggleButton x:Name="AutoSaveToggle" Style="{StaticResource ToolbarToggleStyle}" Content="自動保存 オフ" Checked="AutoSaveChanged" Unchecked="AutoSaveChanged" ToolTip="オンにすると変更を自動保存してすぐ反映します"/>
       </WrapPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="#101720" Padding="12">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <TextBlock x:Name="EngineStatus" Text="● エンジン稼働中" Foreground="#72E0C1"/>
        <TextBlock x:Name="ProfileStatus" Grid.Column="1"/><TextBlock x:Name="AdminStatus" Grid.Column="2"/>
        <TextBlock x:Name="LastInput" Grid.Column="3" Text="入力: —"/>
      </Grid>
    </Border>

    <Grid x:Name="MainContentGrid" ClipToBounds="True" SizeChanged="MainContent_SizeChanged">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="LayerNavigationColumn" Width="150"/><ColumnDefinition Width="*" MinWidth="0"/><ColumnDefinition x:Name="AssignmentPaneColumn" Width="300"/></Grid.ColumnDefinitions>

      <Border Background="#101720" Padding="10">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <ScrollViewer x:Name="LayerNavigationScrollViewer" Grid.Row="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
           <StackPanel>
            <Button x:Name="DetectInputButton" Content="押した入力を検出" Click="Detect_Click" Margin="3,0,3,8"/>
            <StackPanel x:Name="LayerNavigationHost" Margin="0,4,0,0">
              <TextBlock x:Name="LayerNavigationTitle" Text="レイヤー選択" FontSize="17" FontWeight="SemiBold" Margin="8,0,8,4" TextWrapping="NoWrap"/>
              <TextBlock x:Name="LayerNavigationHint" Text="操作モードを切り替えます" Foreground="#8F9CB2" FontSize="10" Margin="8,0,8,5"/>
            </StackPanel>
            <Grid x:Name="MousePanel" Width="168" Height="260" HorizontalAlignment="Center">
            <Canvas Width="168" Height="260" ClipToBounds="False">
              <Border Canvas.Left="6" Canvas.Top="8" Width="156" Height="238" CornerRadius="74" BorderBrush="#71809A" BorderThickness="2">
                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#30394A" Offset="0"/><GradientStop Color="#171D27" Offset="0.55"/><GradientStop Color="#252E3D" Offset="1"/></LinearGradientBrush></Border.Background>
              </Border>
              <Line X1="84" Y1="10" X2="84" Y2="82" Stroke="#71809A" StrokeThickness="2"/>
              <Line X1="8" Y1="82" X2="160" Y2="82" Stroke="#71809A" StrokeThickness="2"/>
              <Button Style="{StaticResource MouseHotspot}" Tag="MouseLeft" Content="左" ToolTip="左クリック" Click="InputButton_Click" Canvas.Left="14" Canvas.Top="16" Width="56" Height="54" FontSize="11"/>
              <Button Style="{StaticResource MouseHotspot}" Tag="MouseRight" Content="右" ToolTip="右クリック／右クリックレイヤー" Click="InputButton_Click" Canvas.Left="98" Canvas.Top="16" Width="56" Height="54" FontSize="11"/>
              <Button Style="{StaticResource MouseHotspot}" Tag="WheelUp" Content="▲" ToolTip="ホイール上回転" Click="InputButton_Click" Canvas.Left="72" Canvas.Top="18" Width="24" Height="20" FontSize="9"/>
              <Button Style="{StaticResource MouseHotspot}" Tag="MouseMiddle" Content="●" ToolTip="ホイールクリック（中央ボタン）" Click="InputButton_Click" Canvas.Left="72" Canvas.Top="40" Width="24" Height="16" FontSize="8"/>
              <Button Style="{StaticResource MouseHotspot}" Tag="WheelDown" Content="▼" ToolTip="ホイール下回転" Click="InputButton_Click" Canvas.Left="72" Canvas.Top="58" Width="24" Height="20" FontSize="9"/>
              <TextBlock Canvas.Left="0" Canvas.Top="96" Width="168" Text="TILT" TextAlignment="Center" Foreground="#8794AA" FontSize="8" FontWeight="Bold"/>
              <Button Style="{StaticResource MouseHotspot}" Tag="TiltLeft" Content="◀" ToolTip="チルトホイール左" Click="InputButton_Click" Canvas.Left="44" Canvas.Top="108" Width="38" Height="28" FontSize="11"/>
              <Button Style="{StaticResource MouseHotspot}" Tag="TiltRight" Content="▶" ToolTip="チルトホイール右" Click="InputButton_Click" Canvas.Left="86" Canvas.Top="108" Width="38" Height="28" FontSize="11"/>
              <Button Style="{StaticResource MouseHotspot}" Tag="MouseBack" Content="戻る" ToolTip="戻るボタン／戻るレイヤー" Click="InputButton_Click" Canvas.Left="20" Canvas.Top="151" Width="48" Height="31" FontSize="11"/>
              <Button Style="{StaticResource MouseHotspot}" Tag="MouseForward" Content="進む" ToolTip="進むボタン／進むレイヤー" Click="InputButton_Click" Canvas.Left="20" Canvas.Top="186" Width="48" Height="31" FontSize="11"/>
              <Button Style="{StaticResource MouseHotspot}" Tag="MouseX" Content="X1" ToolTip="追加マウスボタン" Click="InputButton_Click" Canvas.Left="112" Canvas.Top="151" Width="36" Height="66" FontSize="11"/>
            </Canvas>
            </Grid>
           </StackPanel>
          </ScrollViewer>
          <StackPanel x:Name="LeftBottomActions" Grid.Row="1" Margin="0,8,0,0">
            <ToggleButton x:Name="EngineToggle" Style="{StaticResource EngineToggleStyle}" HorizontalAlignment="Stretch" IsChecked="True" Checked="EngineChanged" Unchecked="EngineChanged"/>
            <Button x:Name="AppSettingsButton" Style="{StaticResource ToolbarButtonStyle}" HorizontalAlignment="Stretch" Content="⚙ アプリ設定" Click="OpenSettings_Click" ToolTip="自動起動や自動解凍を設定します"/>
          </StackPanel>
        </Grid>
      </Border>

      <Grid x:Name="WorkspaceGrid" Grid.Column="1" MinWidth="0" Margin="16">
        <StackPanel x:Name="WorkspaceIntroPanel" Visibility="Collapsed">
          <StackPanel Margin="0,0,0,16">
           <StackPanel x:Name="LayerButtonsPanel" HorizontalAlignment="Stretch" SizeChanged="LayerButtonsPanel_SizeChanged">
            <TextBlock x:Name="KeyboardLayerCategory" Text="キーボード" Foreground="#72E0C1" FontSize="12" FontWeight="SemiBold" Margin="8,5,8,3"/>
            <Button x:Name="NormalLayerButton" Style="{StaticResource LayerButton}" Tag="通常" Click="LayerButton_Click">
              <StackPanel><TextBlock Text="通常レイヤー"/><TextBlock Text="そのまま押す" FontSize="11" Foreground="#B8C2D8"/></StackPanel>
            </Button>
            <Button x:Name="SpaceLayerButton" Style="{StaticResource LayerButton}" Tag="Space" Click="LayerButton_Click">
              <StackPanel><TextBlock Text="Space レイヤー"/><TextBlock Text="Spaceを押しながら" FontSize="11" Foreground="#B8C2D8"/></StackPanel>
            </Button>
            <Button x:Name="CapsLockLayerButton" Style="{StaticResource LayerButton}" Tag="CapsLock" Click="LayerButton_Click">
              <StackPanel><TextBlock Text="CapsLock レイヤー"/><TextBlock Text="F13リマップ設定が必要" FontSize="9" Foreground="#F6C66A"/></StackPanel>
            </Button>
            <TextBlock x:Name="MouseLayerCategory" Text="マウス" Foreground="#72E0C1" FontSize="12" FontWeight="SemiBold" Margin="8,8,8,3"/>
            <Button x:Name="RightMouseLayerButton" Style="{StaticResource LayerButton}" Tag="MouseRight" Click="LayerButton_Click"><StackPanel><TextBlock Text="右クリック レイヤー"/><TextBlock Text="右クリックを押しながら" FontSize="10" Foreground="#B8C2D8"/></StackPanel></Button>
            <Button x:Name="BackMouseLayerButton" Style="{StaticResource LayerButton}" Tag="MouseBack" Click="LayerButton_Click"><StackPanel><TextBlock Text="戻る レイヤー"/><TextBlock Text="戻るを押しながら" FontSize="10" Foreground="#B8C2D8"/></StackPanel></Button>
            <Button x:Name="ForwardMouseLayerButton" Style="{StaticResource LayerButton}" Tag="MouseForward" Click="LayerButton_Click"><StackPanel><TextBlock Text="進む レイヤー"/><TextBlock Text="進むを押しながら" FontSize="10" Foreground="#B8C2D8"/></StackPanel></Button>
            <TextBlock x:Name="WindowsLayerCategory" Text="Windows" Foreground="#72E0C1" FontSize="12" FontWeight="SemiBold" Margin="8,8,8,3"/>
            <Button x:Name="TaskbarLayerButton" Style="{StaticResource LayerButton}" Tag="Taskbar" Click="LayerButton_Click">
              <StackPanel><TextBlock Text="タスクバー上"/><TextBlock Text="カーソルがタスクバーにある時" FontSize="10" Foreground="#B8C2D8"/></StackPanel>
            </Button>
           </StackPanel>
          </StackPanel>

        </StackPanel>
        <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition x:Name="LowerInputRow" Height="320"/></Grid.RowDefinitions>
          <Viewbox x:Name="KeyboardViewbox" MaxWidth="1220" Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Canvas x:Name="KeyboardPanel" Width="960" Height="364"/>
          </Viewbox>
          <Grid x:Name="LowerInputGrid" Grid.Row="1" Width="{Binding ActualWidth,ElementName=KeyboardViewbox}" HorizontalAlignment="Left" Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="MouseColumn" Width="300"/></Grid.ColumnDefinitions>
            <Viewbox x:Name="SecondaryKeyboardViewbox" Margin="0,0,12,0" Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Left" VerticalAlignment="Stretch"><Canvas x:Name="SecondaryKeyboardPanel" Width="654" Height="312"/></Viewbox>
            <Border Grid.Column="1" Style="{StaticResource LowerGroupFrame}" Margin="0,0,0,2" Panel.ZIndex="0"/>
            <TextBlock Grid.Column="1" Text="マウス" Style="{StaticResource LowerGroupTitle}" Panel.ZIndex="2" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <Viewbox x:Name="MouseHost" Grid.Column="1" Margin="8,22,8,8" Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Center" VerticalAlignment="Stretch" Panel.ZIndex="1"/>
          </Grid>
        </Grid>
      </Grid>

      <Border x:Name="AssignmentPane" Grid.Column="2" Panel.ZIndex="20" Visibility="Visible" Background="#111923" BorderBrush="#33465A" BorderThickness="1,0,0,0" Padding="16">
        <Border.RenderTransform><TranslateTransform x:Name="AssignmentPaneTransform" X="0"/></Border.RenderTransform>
        <ScrollViewer x:Name="AssignmentScrollViewer" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly" IsDeferredScrollingEnabled="False" PreviewMouseWheel="AssignmentPane_PreviewMouseWheel">
          <StackPanel>
            <TextBlock Text="割り当て" FontSize="20" FontWeight="Bold"/>
            <Border Background="#222A38" Padding="10" Margin="0,12,0,8" CornerRadius="4">
              <StackPanel><TextBlock Text="現在のレイヤー" Foreground="#9EABC2"/><TextBlock x:Name="CurrentLayerText" Text="通常" FontSize="18" FontWeight="Bold" Foreground="#72E0C1"/></StackPanel>
            </Border>
            <TextBlock Text="入力元"/><TextBox x:Name="InputName" IsReadOnly="True"/>
            <TextBlock x:Name="SelectInputHint" Text="← 最初に中央のキーボード、または左のマウスから設定するボタンを選んでください。" Foreground="#FFD58A" TextWrapping="Wrap" Margin="0,2,0,10"/>
            <StackPanel x:Name="AssignmentEditor" IsEnabled="False" Opacity="0.55">
            <Border Background="#202938" BorderBrush="#3C4960" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,5,0,10">
              <StackPanel>
                <TextBlock Text="短押し" FontSize="15" FontWeight="Bold"/>
                <TextBlock Text="空欄の場合、標準レイヤーでは元のキーをそのまま入力します。" Foreground="#AAB4C8" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,4"/>
                <TextBlock Text="短押しの動作"/>
                <ListBox x:Name="KindBox" SelectionChanged="EditorChanged" PreviewMouseLeftButtonUp="ActionKind_PreviewMouseLeftButtonUp" ItemContainerStyle="{StaticResource ActionChoice}" Background="Transparent" BorderThickness="0" Margin="0,4,0,10" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"/></DataTemplate></ListBox.ItemTemplate></ListBox>
                <TextBlock Text="実行内容"/><TextBox x:Name="ValueBox" TextChanged="EditorChanged" ToolTip="文字列入力では、ここに入力した文字をそのまま入力します"/>
                <Button Content="定番アクションから選ぶ…" Tag="Short" Click="ChooseCatalogAction_Click"/><Button Content="プロファイル切替を選ぶ…" Tag="Short" Click="ChooseProfileAction_Click"/><Button Content="記録したマクロを選ぶ…" Tag="Short" Click="ChooseMacro_Click"/>
                <WrapPanel HorizontalAlignment="Right"><Button x:Name="BrowseApplicationButton" Content="アプリを選ぶ…" Click="BrowseApplication_Click" ToolTip="選択すると動作が『アプリ・ファイル・URLを開く』になります"/><Button Content="入力完了" Click="DestinationInputDone_Click" Background="#1F8F7B"/></WrapPanel>
                <Button Content="短押しは通常入力にする（長押しのみ設定）" Click="LongPressOnly_Click" Margin="0,4,0,2"/>
              </StackPanel>
            </Border>
            <Expander x:Name="LongPressExpander" Header="＋ 長押し動作を追加（任意）" Expanded="LongPressExpander_Expanded" Background="#202938" BorderBrush="#3C4960" BorderThickness="1" Padding="10" Margin="0,0,0,10">
              <StackPanel><TextBlock Text="長押しした時だけ実行" FontSize="15" FontWeight="Bold" Foreground="#72E0C1"/><TextBlock Text="短押しとは別の動作を選べます。例：短押しはキー、長押しはアプリ起動。" Foreground="#AAB4C8" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,4"/><TextBlock Text="長押しの動作"/><ListBox x:Name="LongKindBox" SelectionChanged="EditorChanged" PreviewMouseLeftButtonUp="ActionKind_PreviewMouseLeftButtonUp" ItemContainerStyle="{StaticResource ActionChoice}" Background="Transparent" BorderThickness="0" Margin="0,4,0,10" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"/></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Text="実行内容"/><TextBox x:Name="LongValueBox" TextChanged="EditorChanged" ToolTip="文字列入力では、ここに入力した文字をそのまま入力します"/><Button Content="定番アクションから選ぶ…" Tag="Long" Click="ChooseCatalogAction_Click"/><Button x:Name="LongChooseProfileButton" Content="プロファイル切替を選ぶ…" Tag="Long" Click="ChooseProfileAction_Click"/><Button Content="記録したマクロを選ぶ…" Tag="Long" Click="ChooseMacro_Click"/><Button x:Name="LongBrowseApplicationButton" Content="長押しで起動するアプリを選ぶ…" Tag="Long" Click="BrowseApplication_Click" ToolTip="選択すると長押しの動作がアプリ起動になります"/><Button Content="入力完了" HorizontalAlignment="Right" Click="DestinationInputDone_Click" Background="#1F8F7B"/><TextBlock Text="長押し判定時間 (ms)" Margin="0,5,0,0"/><TextBox x:Name="LongPressBox" Text="500" TextChanged="EditorChanged"/></StackPanel>
            </Expander>
            <CheckBox x:Name="EnabledBox" Content="この割り当てを有効にする" IsChecked="True" Checked="EditorChanged" Unchecked="EditorChanged"/>
            <Button Content="割り当てを削除" Margin="0,18,0,0" Click="Delete_Click"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </DockPanel>
</Window>
