<Window x:Class="RELYR.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RELYR"
        Title="RELYR" Icon="Assets/RELYR.ico" Height="900" Width="1280" MinHeight="640" MinWidth="880" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackground}" Foreground="{DynamicResource PrimaryText}" Closing="Window_Closing" PreviewMouseDown="MainWindow_PreviewMouseDown">
  <Window.Resources>
    <Style TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
      <Setter Property="Margin" Value="3"/><Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Height" Value="44"/><Setter Property="MinWidth" Value="44"/>
      <Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="12,0"/>
      <Setter Property="FontWeight" Value="Normal"/>
    </Style>
    <Style x:Key="ToolbarToggleStyle" TargetType="ToggleButton">
      <Setter Property="Height" Value="44"/><Setter Property="MinWidth" Value="44"/>
      <Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="12,0"/>
      <Setter Property="Background" Value="{DynamicResource ControlBackground}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
        <Border x:Name="ToggleBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource ControlCornerRadius}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="0,0,0,1"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource ControlHoverBackground}"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource ControlPressedBackground}"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ToggleBorder" Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="AssignmentDragButtonBase" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="AllowDrop" Value="True"/>
      <EventSetter Event="PreviewMouseLeftButtonDown" Handler="InputAssignmentDragStarted"/>
      <EventSetter Event="PreviewMouseMove" Handler="InputAssignmentDragMoved"/>
      <EventSetter Event="PreviewMouseLeftButtonUp" Handler="InputAssignmentDragEnded"/>
      <EventSetter Event="PreviewDragEnter" Handler="InputAssignmentDragOver"/>
      <EventSetter Event="PreviewDragOver" Handler="InputAssignmentDragOver"/>
      <EventSetter Event="PreviewDragLeave" Handler="InputAssignmentDragLeave"/>
      <EventSetter Event="PreviewDrop" Handler="InputAssignmentDropped"/>
      <EventSetter Event="MouseEnter" Handler="InputButtonHoverEntered"/>
      <EventSetter Event="MouseLeave" Handler="InputButtonHoverExited"/>
    </Style>
    <Style x:Key="SidebarButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
      <Setter Property="Height" Value="42"/><Setter Property="Margin" Value="0,1"/>
      <Setter Property="Padding" Value="8,0"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style x:Key="SidebarLabel" TargetType="TextBlock">
      <Setter Property="Margin" Value="10,0,0,0"/><Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="LineHeight" Value="18"/>
      <Setter Property="TextAlignment" Value="Left"/><Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <Style x:Key="SidebarCommandIconCanvas" TargetType="Canvas">
      <Setter Property="Width" Value="32"/><Setter Property="Height" Value="20"/>
      <Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    <Style x:Key="SidebarSectionDivider" TargetType="Separator">
      <Setter Property="Margin" Value="8,10,8,3"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Background="{DynamicResource SubtleBorderBrush}"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource DangerBackground}"/><Setter Property="Foreground" Value="{DynamicResource DangerForeground}"/><Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="DangerBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource ControlCornerRadius}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="DangerBorder" Property="Background" Value="{DynamicResource DangerHoverBackground}"/><Setter Property="Foreground" Value="{DynamicResource DangerHoverForeground}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="DangerBorder" Property="Opacity" Value="0.8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="StatusToggleStyle" TargetType="ToggleButton">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="6,2"/><Setter Property="Margin" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="StatusBorder" Background="Transparent" CornerRadius="{StaticResource ControlCornerRadius}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="StatusBorder" Property="Background" Value="{DynamicResource ControlHoverBackground}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="StatusBorder" Property="Opacity" Value="0.72"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ToggleButton"><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="10,7"/><Setter Property="Background" Value="{DynamicResource ControlBackground}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="Cursor" Value="Hand"/><Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="{DynamicResource AccentStrongBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentButtonText}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger></Style.Triggers></Style>
    <Style x:Key="KeyButton" TargetType="Button" BasedOn="{StaticResource AssignmentDragButtonBase}">
      <Setter Property="MinWidth" Value="48"/><Setter Property="MinHeight" Value="36"/><Setter Property="Height" Value="48"/><Setter Property="FontSize" Value="12"/>
      <EventSetter Event="PreviewMouseRightButtonDown" Handler="InputButton_RightClick"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Grid SnapsToDevicePixels="True">
          <Border Background="{DynamicResource KeyDepthBrush}" CornerRadius="{StaticResource ControlCornerRadius}" Margin="0,1,0,0" IsHitTestVisible="False"/>
          <Border x:Name="KeyBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource ControlCornerRadius}" Margin="0,0,0,1" SnapsToDevicePixels="True">
            <Grid>
              <Border x:Name="SelectionTint" Background="{DynamicResource AccentSoftBrush}" CornerRadius="{StaticResource ControlCornerRadius}" Margin="1" Opacity="0" IsHitTestVisible="False"/>
              <Border x:Name="DropTargetTint" Background="{DynamicResource AccentStrongBrush}" CornerRadius="{StaticResource ControlCornerRadius}" Margin="1" Opacity="0" IsHitTestVisible="False"/>
              <Border x:Name="SelectionPulse" Height="3" Margin="6,0,6,4" Background="{Binding Path=(local:MainWindow.SelectionPulseBrush), RelativeSource={RelativeSource TemplatedParent}}" CornerRadius="2" VerticalAlignment="Bottom" Opacity="0" IsHitTestVisible="False"/>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1"/>
              <Border x:Name="MultiSelectBadge" Width="17" Height="17" CornerRadius="9" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0" Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AppBackground}" BorderThickness="1" Opacity="0" IsHitTestVisible="False"><TextBlock Text="✓" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentButtonText}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              <Border x:Name="DropTargetBadge" Width="26" Height="26" CornerRadius="13" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentButtonText}" BorderThickness="2" Opacity="0" IsHitTestVisible="False"><TextBlock Text="↓" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource AccentButtonText}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/></Border>
            </Grid>
          </Border>
        </Grid>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="KeyBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="KeyBorder" Property="Opacity" Value="0.97"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="KeyBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="KeyBorder" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="KeyBorder" Property="Background" Value="{DynamicResource ControlPressedBackground}"/><Setter TargetName="KeyBorder" Property="RenderTransform"><Setter.Value><TranslateTransform Y="1"/></Setter.Value></Setter></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="JisEnterButton" TargetType="Button" BasedOn="{StaticResource KeyButton}">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Grid SnapsToDevicePixels="True">
          <Path Data="M8,0 H152 A8,8 0 0 1 160,8 V98.86 A8,8 0 0 1 152,106.86 H32 A8,8 0 0 1 24,98.86 V60 C24,55.582 20.418,52 16,52 H8 A8,8 0 0 1 0,44 V8 A8,8 0 0 1 8,0 Z" Fill="{DynamicResource KeyDepthBrush}" Stroke="Transparent" IsHitTestVisible="False">
            <Path.RenderTransform><TranslateTransform Y="1"/></Path.RenderTransform>
          </Path>
          <Path x:Name="EnterShape" Data="M8,0 H152 A8,8 0 0 1 160,8 V98.86 A8,8 0 0 1 152,106.86 H32 A8,8 0 0 1 24,98.86 V60 C24,55.582 20.418,52 16,52 H8 A8,8 0 0 1 0,44 V8 A8,8 0 0 1 8,0 Z" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="{TemplateBinding BorderThickness}" StrokeLineJoin="Round"/>
          <Path x:Name="EnterSelectionTint" Data="M8,0 H152 A8,8 0 0 1 160,8 V98.86 A8,8 0 0 1 152,106.86 H32 A8,8 0 0 1 24,98.86 V60 C24,55.582 20.418,52 16,52 H8 A8,8 0 0 1 0,44 V8 A8,8 0 0 1 8,0 Z" Fill="{DynamicResource AccentSoftBrush}" Stroke="Transparent" IsHitTestVisible="False" Margin="1" Opacity="0"/>
          <Path x:Name="DropTargetTint" Data="M8,0 H152 A8,8 0 0 1 160,8 V98.86 A8,8 0 0 1 152,106.86 H32 A8,8 0 0 1 24,98.86 V60 C24,55.582 20.418,52 16,52 H8 A8,8 0 0 1 0,44 V8 A8,8 0 0 1 8,0 Z" Fill="{DynamicResource AccentStrongBrush}" Stroke="Transparent" IsHitTestVisible="False" Margin="1" Opacity="0"/>
          <Path x:Name="SelectionPulse" Data="M 27,105 L 154,105 Q 158,105 158,101" Stroke="{Binding Path=(local:MainWindow.SelectionPulseBrush), RelativeSource={RelativeSource TemplatedParent}}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0" IsHitTestVisible="False"/>
          <ContentPresenter Margin="18,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <Border x:Name="MultiSelectBadge" Width="17" Height="17" CornerRadius="9" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0" Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AppBackground}" BorderThickness="1" Opacity="0" IsHitTestVisible="False"><TextBlock Text="✓" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentButtonText}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <Border x:Name="DropTargetBadge" Width="28" Height="28" CornerRadius="14" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentButtonText}" BorderThickness="2" Opacity="0" IsHitTestVisible="False"><TextBlock Text="↓" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentButtonText}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/></Border>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="EnterShape" Property="Stroke" Value="{DynamicResource AccentBrush}"/><Setter TargetName="EnterShape" Property="Opacity" Value="0.94"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="EnterShape" Property="Fill" Value="{DynamicResource ControlPressedBackground}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="DeckButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/><Setter Property="FontSize" Value="11"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="DeckKeyBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource ControlCornerRadius}" SnapsToDevicePixels="True"><Grid><Border x:Name="SelectionTint" Background="{DynamicResource AccentSoftBrush}" CornerRadius="{StaticResource ControlCornerRadius}" Margin="1" Opacity="0" IsHitTestVisible="False"/><Border x:Name="DropTargetTint" Background="{DynamicResource AccentStrongBrush}" CornerRadius="{StaticResource ControlCornerRadius}" Margin="1" Opacity="0" IsHitTestVisible="False"/><Border x:Name="SelectionPulse" Height="4" Margin="6,0,6,4" Background="{Binding Path=(local:MainWindow.SelectionPulseBrush), RelativeSource={RelativeSource TemplatedParent}}" CornerRadius="2" VerticalAlignment="Bottom" Opacity="0" IsHitTestVisible="False"/><ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/><Border x:Name="MultiSelectBadge" Width="17" Height="17" CornerRadius="9" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0" Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AppBackground}" BorderThickness="1" Opacity="0" IsHitTestVisible="False"><TextBlock Text="✓" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentButtonText}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Border x:Name="DropTargetBadge" Width="26" Height="26" CornerRadius="13" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentButtonText}" BorderThickness="2" Opacity="0" IsHitTestVisible="False"><TextBlock Text="↓" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource AccentButtonText}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/></Border></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="DeckKeyBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="DeckKeyBorder" Property="Opacity" Value="0.97"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="DeckKeyBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="DeckKeyBorder" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="DeckKeyBorder" Property="Background" Value="{DynamicResource ControlPressedBackground}"/><Setter TargetName="DeckKeyBorder" Property="RenderTransform"><Setter.Value><TranslateTransform Y="1"/></Setter.Value></Setter></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="LayerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="MinHeight" Value="50"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="LayerIconFrame" TargetType="Border">
      <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/><Setter Property="CornerRadius" Value="9"/>
      <Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/><Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,10,0"/>
    </Style>
    <Style x:Key="LayerIconStroke" TargetType="Path"><Setter Property="Stroke" Value="{DynamicResource PrimaryText}"/><Setter Property="StrokeThickness" Value="1.7"/><Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/><Setter Property="StrokeLineJoin" Value="Round"/><Setter Property="Fill" Value="Transparent"/></Style>
    <Style x:Key="LayerTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="TextWrapping" Value="NoWrap"/></Style>
    <Style x:Key="LayerDescription" TargetType="TextBlock"><Setter Property="FontSize" Value="10.5"/><Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/><Setter Property="TextWrapping" Value="NoWrap"/></Style>
    <Style x:Key="LayerCategoryHeading" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedText}"/><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="8,10,8,5"/></Style>
    <Style x:Key="LayerActiveDot" TargetType="Ellipse"><Setter Property="Width" Value="8"/><Setter Property="Height" Value="8"/><Setter Property="Fill" Value="{DynamicResource AccentBrush}"/><Setter Property="Margin" Value="8,0,4,0"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Visibility" Value="Collapsed"/></Style>
    <Style x:Key="MouseHotspot" TargetType="Button" BasedOn="{StaticResource AssignmentDragButtonBase}">
      <Setter Property="Background" Value="{DynamicResource ControlBackground}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="2"/><Setter Property="Margin" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="9"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid SnapsToDevicePixels="True"><Border Background="{DynamicResource KeyDepthBrush}" CornerRadius="{StaticResource ControlCornerRadius}" Margin="0,1,0,0" IsHitTestVisible="False"/><Border x:Name="MouseButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource ControlCornerRadius}" Margin="0,0,0,1" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True"><Grid><Border x:Name="SelectionTint" Background="{DynamicResource AccentSoftBrush}" CornerRadius="{StaticResource ControlCornerRadius}" Margin="1" Opacity="0" IsHitTestVisible="False"/><Border x:Name="DropTargetTint" Background="{DynamicResource AccentStrongBrush}" CornerRadius="{StaticResource ControlCornerRadius}" Margin="1" Opacity="0" IsHitTestVisible="False"/><Border x:Name="SelectionPulse" Height="4" Margin="5,0,5,4" Background="{Binding Path=(local:MainWindow.SelectionPulseBrush), RelativeSource={RelativeSource TemplatedParent}}" CornerRadius="2" VerticalAlignment="Bottom" Opacity="0" IsHitTestVisible="False"/><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1"/><Border x:Name="MultiSelectBadge" Width="17" Height="17" CornerRadius="9" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0" Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AppBackground}" BorderThickness="1" Opacity="0" IsHitTestVisible="False"><TextBlock Text="✓" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentButtonText}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Border x:Name="DropTargetBadge" Width="26" Height="26" CornerRadius="13" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentButtonText}" BorderThickness="2" Opacity="0" IsHitTestVisible="False"><TextBlock Text="↓" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource AccentButtonText}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/></Border></Grid></Border></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="MouseButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="MouseButtonBorder" Property="Opacity" Value="0.97"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="MouseButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="MouseButtonBorder" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="MouseButtonBorder" Property="Background" Value="{DynamicResource ControlPressedBackground}"/><Setter TargetName="MouseButtonBorder" Property="RenderTransform"><Setter.Value><TranslateTransform Y="1"/></Setter.Value></Setter></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
      <EventSetter Event="PreviewMouseRightButtonDown" Handler="InputButton_RightClick"/>
      <EventSetter Event="MouseDoubleClick" Handler="InputButton_DoubleClick"/>
    </Style>
    <Style x:Key="DeckColorSwatch" TargetType="Button">
      <Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/><Setter Property="MinHeight" Value="28"/>
      <Setter Property="Margin" Value="0,0,7,0"/><Setter Property="Padding" Value="0"/>
      <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="SwatchBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource ControlCornerRadius}" SnapsToDevicePixels="True">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SwatchBorder" Property="BorderBrush" Value="{DynamicResource PrimaryText}"/><Setter TargetName="SwatchBorder" Property="BorderThickness" Value="2"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SwatchBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="SwatchBorder" Property="BorderThickness" Value="2"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="SwatchBorder" Property="Opacity" Value="0.72"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="DeckAppearanceAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Height" Value="40"/><Setter Property="MinHeight" Value="40"/><Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="13,0"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="DeckActionBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource ControlCornerRadius}" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="DeckActionBorder" Property="Background" Value="{DynamicResource ControlHoverBackground}"/><Setter TargetName="DeckActionBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="DeckActionBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="DeckActionBorder" Property="BorderThickness" Value="2"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="DeckActionBorder" Property="Opacity" Value="0.76"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="DeckRoundedTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Background" Value="{DynamicResource InputBackground}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/><Setter Property="CaretBrush" Value="{DynamicResource AccentTextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Border x:Name="DeckTextBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource ControlCornerRadius}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
          <ScrollViewer x:Name="PART_ContentHost" Focusable="False" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="DeckTextBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="DeckTextBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="DeckTextBorder" Property="BorderThickness" Value="2"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="DeckTitleTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource AccentTextBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0,0,28,0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Grid SnapsToDevicePixels="True">
          <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Focusable="False"/>
