            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
            <StackPanel MinWidth="0">
              <TextBlock Text="Action" FontSize="18" FontWeight="SemiBold" TextWrapping="NoWrap"/>
              <TextBlock Text="ドラッグして割り当て" FontSize="10.5" Foreground="{DynamicResource SecondaryText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Width="30" Height="30" MinHeight="30" Padding="0" Margin="2,0,0,0" VerticalAlignment="Top" Click="CloseActionPalette_Click" ToolTip="Action一覧を閉じる" AutomationProperties.Name="Action一覧を閉じる"><TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="13"/></Button>
          </Grid>
          <Grid Grid.Row="1" Height="{StaticResource ControlHeight}" Margin="0,0,0,8">
            <TextBox x:Name="ActionPaletteSearchBox" Height="{StaticResource ControlHeight}" Margin="0" Padding="30,0,34,0" VerticalContentAlignment="Center" TextChanged="ActionPaletteSearchChanged" PreviewMouseLeftButtonDown="ActionPaletteSearchPreviewMouseLeftButtonDown" ToolTip="名前・説明・ショートカットを検索"/>
            <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="{DynamicResource MutedText}" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
            <TextBlock x:Name="ActionPaletteSearchHint" Text="Actionを検索" FontSize="11" Foreground="{DynamicResource MutedText}" Margin="31,0,8,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
            <Button x:Name="ActionPaletteSearchClearButton" Width="26" Height="26" MinWidth="26" MinHeight="26" Margin="0,0,5,0" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Visibility="Collapsed" Click="ClearActionPaletteSearch_Click" ToolTip="検索を消去" AutomationProperties.Name="Action検索を消去"><TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="11"/></Button>
          </Grid>
          <Grid Grid.Row="2" Margin="0,0,0,8">
            <ComboBox x:Name="ActionPaletteCategoryBox" Style="{StaticResource ToolbarComboBoxStyle}" Height="36" MaxDropDownHeight="520" Margin="0" Padding="9,0,28,0" SelectionChanged="ActionPaletteCategoryChanged" AutomationProperties.Name="Actionカテゴリ"/>
            <TextBlock x:Name="ActionPaletteResultCount" Visibility="Collapsed" IsHitTestVisible="False"/>
          </Grid>
          <Button x:Name="ActionPaletteCustomShortcutButton" Grid.Row="3" Height="36" MinHeight="36" Margin="0,0,0,8" Padding="9,0" Visibility="Collapsed" Click="CreateActionPaletteShortcut_Click" AutomationProperties.Name="任意のショートカットを作成">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="任意のショートカットを作成" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="2" Text="›" FontSize="18" Foreground="{DynamicResource AccentTextBrush}" Margin="8,-1,1,0" VerticalAlignment="Center"/>
            </Grid>
          </Button>
          <Grid Grid.Row="4" MinHeight="0">
            <ListBox x:Name="ActionPaletteList" Background="Transparent" BorderThickness="0" Padding="0" ItemContainerStyle="{StaticResource ActionPaletteItemStyle}" ItemTemplate="{StaticResource ActionPaletteItemTemplate}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" PreviewMouseLeftButtonDown="ActionPaletteItem_PreviewMouseLeftButtonDown" PreviewMouseMove="ActionPaletteItem_PreviewMouseMove" PreviewMouseLeftButtonUp="ActionPaletteItem_PreviewMouseLeftButtonUp"/>
            <TextBlock x:Name="ActionPaletteEmptyText" Text="一致するActionはありません" FontSize="11" Foreground="{DynamicResource MutedText}" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"/>
          </Grid>
          <Border x:Name="ActionPaletteUndoBar" Grid.Row="5" Visibility="Collapsed" Background="{DynamicResource AccentSoftBrush}" CornerRadius="7" Padding="9,7" Margin="0,8,0,0">
            <Border.RenderTransform><TranslateTransform Y="0"/></Border.RenderTransform>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ActionPaletteUndoText" Text="割り当てました" FontSize="10.5" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/><Button Grid.Column="1" Content="元に戻す" MinHeight="28" Padding="8,3" Margin="8,0,0,0" Click="UndoActionPaletteAssignment_Click"/></Grid>
          </Border>
        </Grid>
        </Grid>
      </Border>
      <Border x:Name="RightPaneSoftDivider" Grid.Column="2" Panel.ZIndex="19" Width="1" HorizontalAlignment="Left" VerticalAlignment="Stretch"
              Margin="0,36,0,36" Background="{DynamicResource SubtleBorderBrush}" Opacity="0.58" IsHitTestVisible="False"/>
    </Grid>
  </DockPanel>
</Window>
