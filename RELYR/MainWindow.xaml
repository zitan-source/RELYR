              <TextBlock x:Name="MouseLayerCategory" Text="MOUSE LAYER" Style="{StaticResource LayerCategoryHeading}"/>
             <Button x:Name="RightMouseLayerButton" Style="{StaticResource LayerButton}" Tag="MouseRight" Click="LayerButton_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource LayerIconFrame}"><Viewbox Width="18" Height="18"><Canvas Width="18" Height="18"><Path Style="{StaticResource LayerIconStroke}" Data="M4,9 V6 Q4,2 9,2 Q14,2 14,6 V12 Q14,16 9,16 Q4,16 4,12 Z M9,2 V8 M9,8 H14"/></Canvas></Viewbox></Border><TextBlock Grid.Column="1" VerticalAlignment="Center" Text="右クリック" Style="{StaticResource LayerTitle}"/></Grid></Button>
             <Button x:Name="ForwardMouseLayerButton" Style="{StaticResource LayerButton}" Tag="MouseForward" Click="LayerButton_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource LayerIconFrame}"><Viewbox Width="18" Height="18"><Canvas Width="18" Height="18"><Path Style="{StaticResource LayerIconStroke}" Data="M3,15 L15,3 M8,3 H15 V10"/></Canvas></Viewbox></Border><TextBlock Grid.Column="1" VerticalAlignment="Center" Text="進む" Style="{StaticResource LayerTitle}"/></Grid></Button>
             <Button x:Name="BackMouseLayerButton" Style="{StaticResource LayerButton}" Tag="MouseBack" Click="LayerButton_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource LayerIconFrame}"><Viewbox Width="18" Height="18"><Canvas Width="18" Height="18"><Path Style="{StaticResource LayerIconStroke}" Data="M15,3 L3,15 M3,8 V15 H10"/></Canvas></Viewbox></Border><TextBlock Grid.Column="1" VerticalAlignment="Center" Text="戻る" Style="{StaticResource LayerTitle}"/></Grid></Button>
              <Separator x:Name="MouseLayerDivider" Style="{StaticResource SidebarSectionDivider}"/>
              <TextBlock x:Name="WindowsLayerCategory" Text="SYSTEM" Style="{StaticResource LayerCategoryHeading}"/>
            <Button x:Name="TaskbarLayerButton" Style="{StaticResource LayerButton}" Tag="Taskbar" Click="LayerButton_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource LayerIconFrame}"><Viewbox Width="18" Height="18"><Canvas Width="18" Height="18"><Path Style="{StaticResource LayerIconStroke}" Data="M2,3 H16 V15 H2 Z M2,11 H16 M5,13 H7"/></Canvas></Viewbox></Border><TextBlock Grid.Column="1" VerticalAlignment="Center" Text="タスクバー" Style="{StaticResource LayerTitle}"/></Grid></Button>
           </StackPanel>
          </StackPanel>

        </StackPanel>
        <Grid x:Name="KeyboardWorkspace" Grid.Row="1" VerticalAlignment="Top"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition x:Name="LowerInputRow" Height="Auto"/></Grid.RowDefinitions>
          <Border x:Name="KeyboardSurfaceCard" Style="{StaticResource WorkspaceCardFrame}" Padding="18,16" HorizontalAlignment="Left" VerticalAlignment="Top"
                  Background="Transparent" BorderThickness="0" CornerRadius="0" Effect="{x:Null}">
            <Viewbox x:Name="KeyboardViewbox" MaxWidth="1220" Stretch="Uniform" StretchDirection="Both" UseLayoutRounding="True" SnapsToDevicePixels="True" HorizontalAlignment="Left" VerticalAlignment="Top" SizeChanged="KeyboardViewbox_SizeChanged">
              <Canvas x:Name="KeyboardPanel" Width="960" Height="364" UseLayoutRounding="True" SnapsToDevicePixels="True"/>
            </Viewbox>
          </Border>
          <Grid x:Name="LowerInputGrid" Grid.Row="1" Width="{Binding ActualWidth,ElementName=KeyboardSurfaceCard}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="MouseColumn" Width="300"/></Grid.ColumnDefinitions>
            <Viewbox x:Name="SecondaryKeyboardViewbox" Margin="18,0,14,0" Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Left" VerticalAlignment="Top"><Canvas x:Name="SecondaryKeyboardPanel" Width="654" Height="312"/></Viewbox>
             <Border x:Name="MouseFrame" Grid.Column="1" Style="{StaticResource LowerGroupFrame}" Height="{Binding ActualHeight,ElementName=MouseHost}" VerticalAlignment="Top" Margin="0" Panel.ZIndex="0"
                    Background="Transparent" BorderThickness="0" CornerRadius="0" Effect="{x:Null}"/>
            <TextBlock Grid.Column="1" Text="マウス" Style="{StaticResource LowerGroupTitle}" Panel.ZIndex="2" HorizontalAlignment="Left" VerticalAlignment="Top"/>
             <Viewbox x:Name="MouseHost" Grid.Column="1" Margin="8,14,8,0" Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Center" VerticalAlignment="Top" Panel.ZIndex="1"/>
          </Grid>
        </Grid>
        <Grid x:Name="DeckWorkspace" Grid.Row="1" Visibility="Collapsed" MinWidth="0">
          <ScrollViewer x:Name="DeckLayoutListWorkspace" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
            <WrapPanel x:Name="DeckLayoutCardsPanel" HorizontalAlignment="Left" VerticalAlignment="Top"/>
          </ScrollViewer>
          <Grid x:Name="DeckEditorWorkspace" Visibility="Collapsed" MinWidth="0" SizeChanged="DeckEditorWorkspace_SizeChanged">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Button x:Name="DeckBackButton" Style="{StaticResource DeckAppearanceAction}" Click="DeckBack_Click" Width="44" Height="44" MinWidth="44" MinHeight="44" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="0" Margin="0,0,12,0" ToolTip="Deck一覧へ戻る">
                <TextBlock Text="&#xE72B;" FontFamily="Segoe Fluent Icons" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Button>
              <TextBox x:Name="DeckLayoutNameBox" Style="{StaticResource DeckRoundedTextBox}" Grid.Column="1" Height="44" Margin="0,0,12,0" Padding="14,0" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" VerticalContentAlignment="Center" TextChanged="DeckLayoutNameChanged" ToolTip="Deckの名前"/>
              <Button x:Name="DeckSaveButton" Style="{StaticResource DeckAppearanceAction}" Grid.Column="2" Content="保存" Click="DeckSave_Click" Width="88" Height="44" MinHeight="44" VerticalAlignment="Center" Margin="0" Padding="18,0" Background="{DynamicResource AccentStrongBrush}" Foreground="{DynamicResource AccentButtonText}" BorderBrush="{DynamicResource AccentBrush}"/>
            </Grid>
            <WrapPanel x:Name="DeckSettingsPanel" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,0,10">
              <Border x:Name="DeckCoreSettingsCard" Style="{StaticResource DeckEditorSettingsCard}">
                <StackPanel>
                  <TextBlock Text="DECK" Style="{StaticResource DeckEditorSettingsCaption}"/>
                  <StackPanel Orientation="Horizontal">
                    <ToggleButton x:Name="DeckProfileSwitchBox" Style="{StaticResource DeckEditorCompactToggle}" Content="プロファイル連動" Checked="DeckProfileSwitchChanged" Unchecked="DeckProfileSwitchChanged" ToolTip="プロファイルごとに同じDeckの内容を切り替えます"/>
                    <Button x:Name="DeckOverlayToggleButton" Style="{StaticResource DeckEditorCompactAction}" Content="表示を切替" Click="DeckOverlayToggle_Click" Margin="8,0,0,0" ToolTip="このDeckオーバーレイだけを表示または非表示にします"/>
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border x:Name="DeckLayoutSettingsCard" Style="{StaticResource DeckEditorSettingsCard}">
                <StackPanel x:Name="DeckSizeSettingsGroup">
                  <TextBlock Text="レイアウト" Style="{StaticResource DeckEditorSettingsCaption}"/>
                  <WrapPanel x:Name="DeckSizeControlsWrap" VerticalAlignment="Center">
                    <ComboBox x:Name="DeckSizePresetBox" Style="{StaticResource ToolbarComboBoxStyle}" Width="148" Height="36" Margin="0" SelectionChanged="DeckSizePresetChanged">
                      <ComboBoxItem Content="コンパクト  3×3" Tag="3x3"/><ComboBoxItem Content="標準  9×5" Tag="9x5"/><ComboBoxItem Content="ワイド  8×2" Tag="8x2"/><ComboBoxItem Content="カスタム" Tag="custom"/>
                    </ComboBox>
                    <StackPanel x:Name="DeckCustomSizePanel" Orientation="Horizontal" Margin="8,0,0,0" Visibility="Collapsed" ToolTip="1～18列 × 1～18行">
                      <TextBox x:Name="DeckColumnsBox" Style="{StaticResource DeckRoundedTextBox}" Width="54" Height="36" Margin="0" Padding="8,0" MaxLength="2" FontSize="14" VerticalContentAlignment="Center" TextAlignment="Center" PreviewKeyDown="DeckCustomSizeKeyDown" LostKeyboardFocus="DeckCustomSizeLostKeyboardFocus"/>
                      <TextBlock Text=" × " VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}"/>
                      <TextBox x:Name="DeckRowsBox" Style="{StaticResource DeckRoundedTextBox}" Width="54" Height="36" Margin="0" Padding="8,0" MaxLength="2" FontSize="14" VerticalContentAlignment="Center" TextAlignment="Center" PreviewKeyDown="DeckCustomSizeKeyDown" LostKeyboardFocus="DeckCustomSizeLostKeyboardFocus"/>
                    </StackPanel>
                  </WrapPanel>
                </StackPanel>
              </Border>
              <Border x:Name="DeckAppearanceSettingsCard" Style="{StaticResource DeckEditorSettingsCard}">
                <StackPanel x:Name="DeckAppearanceSettingsGroup">
                  <TextBlock Text="外観" Style="{StaticResource DeckEditorSettingsCaption}"/>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Slider x:Name="DeckOpacitySlider" Width="100" Minimum="40" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="DeckOpacityChanged" ToolTip="Deckの透過率"/>
                    <TextBlock x:Name="DeckOpacityValueText" Width="42" Text="96%" Margin="8,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    <StackPanel x:Name="DeckPanelColorControls" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                      <Border x:Name="DeckPanelColorPreview" Width="36" Height="36" CornerRadius="{StaticResource ControlCornerRadius}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,8,0" Cursor="Hand" ToolTip="背景色を選択" MouseLeftButtonDown="DeckPanelColorChoose_Click" SnapsToDevicePixels="True"/>
                      <Button Style="{StaticResource DeckEditorCompactAction}" Width="36" Padding="0" Click="DeckPanelColorReset_Click" ToolTip="背景色をテーマ標準に戻す">
                        <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="15"/>
                      </Button>
                    </StackPanel>
                    <StackPanel x:Name="DeckDisplaySettingsGroup" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                      <ToggleButton x:Name="DeckHoverPreviewBox" Style="{StaticResource DeckEditorCompactToggle}" Content="プレビュー" Checked="DeckHoverPreviewChanged" Unchecked="DeckHoverPreviewChanged" ToolTip="動画・音声ファイルのホバープレビュー"/>
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border x:Name="DeckAutoHideSettingsCard" Style="{StaticResource DeckEditorSettingsCard}" ToolTip="ピン留め中のDeckには適用されません">
                <StackPanel x:Name="DeckAutoHideSettingsGroup">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="自動収納" Style="{StaticResource DeckEditorSettingsCaption}"/>
                    <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource MutedText}" Margin="6,0,0,7"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <ToggleButton x:Name="DeckAutoHideAfterActionBox" Style="{StaticResource DeckEditorCompactToggle}" Content="ボタン実行後" Checked="DeckAutoHideChanged" Unchecked="DeckAutoHideChanged" ToolTip="Deckボタンを実行したあと画面端へ収納します"/>
                    <ToggleButton x:Name="DeckAutoHideOnPointerLeaveBox" Style="{StaticResource DeckEditorCompactToggle}" Content="マウス離脱後" Margin="8,0,0,0" Checked="DeckAutoHideChanged" Unchecked="DeckAutoHideChanged" ToolTip="マウスがDeckから離れたあと画面端へ収納します"/>
                  </StackPanel>
                </StackPanel>
              </Border>
            </WrapPanel>
            <Viewbox x:Name="DeckGridViewbox" Grid.Row="2" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Top">
              <UniformGrid x:Name="DeckManagementGrid" Rows="5" Columns="9" Width="522" Height="350"/>
            </Viewbox>
          </Grid>
        </Grid>
      </Grid>

      <Border x:Name="AssignmentPane" Grid.Column="2" Panel.ZIndex="20" Visibility="Visible" Background="{DynamicResource AppBackground}" BorderThickness="0" CornerRadius="0" Margin="10,16,14,16" Padding="22" ClipToBounds="True">
        <Border.RenderTransform><TranslateTransform x:Name="AssignmentPaneTransform" X="0"/></Border.RenderTransform>
        <Grid>
        <ScrollViewer x:Name="AssignmentScrollViewer" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly" IsDeferredScrollingEnabled="False" PreviewMouseWheel="AssignmentPane_PreviewMouseWheel">
          <StackPanel>
            <TextBlock Text="インスペクター" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
            <Button x:Name="DetectInputButton" Content="入力を検出" Click="Detect_Click" Margin="0,0,0,12" ToolTip="押したキーまたはマウス入力を検出"/>
            <StackPanel x:Name="SelectionHeader" Visibility="Collapsed" Margin="0,0,0,14">
              <TextBlock Text="入力元" FontSize="11" Foreground="{DynamicResource SecondaryText}"/>
              <TextBlock x:Name="InputDisplayText" Text="キーを選択してください" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" TextWrapping="Wrap" Margin="0,3,0,0"/>
            </StackPanel>
            <TextBox x:Name="InputName" IsReadOnly="True" Visibility="Collapsed"/>
            <StackPanel x:Name="AssignmentEditor" Visibility="Collapsed">
            <StackPanel x:Name="DeckNameEditorPanel" Visibility="Collapsed" Margin="0,0,0,16">
              <TextBlock Text="名前" Foreground="{DynamicResource SecondaryText}"/>
              <TextBox x:Name="DeckNameBox" TextChanged="DeckNameBox_TextChanged" ToolTip="Deckボタンの下に表示する名前"/>
              <TextBlock Text="ファイル" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,4"/>
              <Button x:Name="DeckFileDropTarget" Height="72" MinHeight="72" Margin="0,0,0,4" Padding="10" AllowDrop="True" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" Click="DeckFileSelect_Click" PreviewDragEnter="DeckFileDropTarget_DragOver" PreviewDragOver="DeckFileDropTarget_DragOver" PreviewDrop="DeckFileDropTarget_Drop" DragEnter="DeckFileDropTarget_DragOver" DragOver="DeckFileDropTarget_DragOver" DragLeave="DeckFileDropTarget_DragLeave" Drop="DeckFileDropTarget_Drop" ToolTip="クリックしてファイルを選択、またはエクスプローラーからファイルをドロップ"/>
              <TextBlock Text="アクセントカラー" Foreground="{DynamicResource SecondaryText}" Margin="0,12,0,6"/>
              <StackPanel Orientation="Horizontal" x:Name="DeckColorSwatches">
                <Button Style="{StaticResource DeckColorSwatch}" Background="#1D6FA5" Tag="#1D6FA5" Click="DeckColorSwatch_Click" ToolTip="ブルー"/>
                <Button Style="{StaticResource DeckColorSwatch}" Background="#187F6A" Tag="#187F6A" Click="DeckColorSwatch_Click" ToolTip="ティール"/>
                <Button Style="{StaticResource DeckColorSwatch}" Background="#8A5B25" Tag="#8A5B25" Click="DeckColorSwatch_Click" ToolTip="アンバー"/>
                <Button Style="{StaticResource DeckColorSwatch}" Background="#9A465B" Tag="#9A465B" Click="DeckColorSwatch_Click" ToolTip="ローズ"/>
                <Button Style="{StaticResource DeckColorSwatch}" Background="#6C579C" Tag="#6C579C" Click="DeckColorSwatch_Click" ToolTip="バイオレット"/>
                <Button Style="{StaticResource DeckColorSwatch}" Background="#5B6872" Tag="#5B6872" Click="DeckColorSwatch_Click" ToolTip="スレート"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="標準に戻す" Click="DeckColorReset_Click" Padding="9,4" MinHeight="28" Margin="0,0,8,0"/>
                <Button Content="カスタム…" Click="DeckColorCustom_Click" Padding="9,4" MinHeight="28" Margin="0"/>
              </StackPanel>
              <TextBlock x:Name="DeckColorStatus" FontSize="11" Foreground="{DynamicResource MutedText}" Margin="0,7,0,0"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="実行する操作" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <ListBox x:Name="KindBox" Style="{StaticResource ActionChoiceList}" SelectionChanged="EditorChanged" PreviewMouseLeftButtonDown="ActionKind_PreviewMouseLeftButtonDown" ItemContainerStyle="{StaticResource ActionChoice}" ItemTemplate="{StaticResource ActionChoiceTemplate}" Margin="0,0,0,7"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox>
                <TextBlock Text="内容" Foreground="{DynamicResource SecondaryText}"/><TextBox x:Name="ValueBox" TextChanged="EditorChanged" GotKeyboardFocus="ExecutionValue_GotKeyboardFocus" ToolTip="内容を直接入力するか、右側のキーパッドからキーを選べます"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button x:Name="DestinationClearButton" Content="削除" Visibility="Collapsed" Click="ExecutionValueClear_Click" Background="Transparent" Foreground="{DynamicResource DangerBrush}"/>
                  <Button x:Name="DestinationConfirmButton" Content="確定" Visibility="Collapsed" Click="DestinationInputDone_Click" Background="{DynamicResource AccentStrongBrush}" Foreground="{DynamicResource AccentButtonText}"/>
                </StackPanel>
                <Button x:Name="LongPressOnlyButton" Content="短押しを元の入力にする" Click="LongPressOnly_Click" Margin="0,4,0,2"/>
              </StackPanel>
            </StackPanel>
            <Separator Margin="0,2,0,12"/>
            <Expander x:Name="LongPressExpander" Header="長押しを追加" Expanded="LongPressExpander_Expanded" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Text="長押しの操作" FontSize="13" FontWeight="SemiBold" Margin="0,10,0,8"/>
                <ListBox x:Name="LongKindBox" Style="{StaticResource ActionChoiceList}" SelectionChanged="EditorChanged" PreviewMouseLeftButtonDown="ActionKind_PreviewMouseLeftButtonDown" ItemContainerStyle="{StaticResource ActionChoice}" ItemTemplate="{StaticResource ActionChoiceTemplate}" Margin="0,0,0,7"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox>
                <TextBlock Text="内容" Foreground="{DynamicResource SecondaryText}"/><TextBox x:Name="LongValueBox" TextChanged="EditorChanged" GotKeyboardFocus="ExecutionValue_GotKeyboardFocus" ToolTip="内容を直接入力するか、右側のキーパッドからキーを選べます"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button x:Name="LongDestinationClearButton" Content="削除" Visibility="Collapsed" Click="ExecutionValueClear_Click" Background="Transparent" Foreground="{DynamicResource DangerBrush}"/>
                  <Button x:Name="LongDestinationConfirmButton" Content="確定" Visibility="Collapsed" Click="DestinationInputDone_Click" Background="{DynamicResource AccentStrongBrush}" Foreground="{DynamicResource AccentButtonText}"/>
                </StackPanel>
                <TextBlock Text="判定時間（ms）" Margin="0,8,0,0" Foreground="{DynamicResource SecondaryText}"/><TextBox x:Name="LongPressBox" Text="500" TextChanged="EditorChanged"/>
              </StackPanel>
            </Expander>
            <Button x:Name="AssignmentDeleteButton" Content="割り当てを削除" Background="Transparent" Foreground="{DynamicResource DangerBrush}" BorderBrush="Transparent" HorizontalAlignment="Left" Margin="-3,14,0,0" Click="Delete_Click"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
        <StackPanel x:Name="InspectorEmptyState" Margin="0,28,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
          <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,18">
            <TextBlock Text="⌘" FontFamily="Segoe UI Symbol" FontSize="27" Foreground="{DynamicResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="キーを選択" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
          <TextBlock Margin="8,6,8,0" MaxWidth="270" Foreground="{DynamicResource SecondaryText}" TextAlignment="Center" TextWrapping="Wrap"><Run Text="編集するキーまたはDeckボタンを"/><LineBreak/><Run Text="選択してください"/></TextBlock>
        </StackPanel>
        </Grid>
      </Border>
      <Border x:Name="RightPaneSoftDivider" Grid.Column="2" Panel.ZIndex="19" Width="1" HorizontalAlignment="Left" VerticalAlignment="Stretch"
              Margin="0,36,0,36" Background="{DynamicResource SubtleBorderBrush}" Opacity="0.58" IsHitTestVisible="False"/>
    </Grid>
  </DockPanel>
</Window>
