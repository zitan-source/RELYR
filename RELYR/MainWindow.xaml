<Window x:Class="RELYR.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RELYR"
        Title="RELYR" Icon="Assets/RELYR.ico" Height="820" Width="1280" MinHeight="640" MinWidth="880" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackground}" Foreground="{DynamicResource PrimaryText}" Closing="Window_Closing" PreviewMouseDown="MainWindow_PreviewMouseDown">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="12,7"/><Setter Property="MinHeight" Value="36"/>
      <Setter Property="Background" Value="{DynamicResource ControlBackground}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ControlHoverBackground}"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ControlPressedBackground}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Height" Value="36"/><Setter Property="MinWidth" Value="36"/>
      <Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="12,0"/>
      <Setter Property="FontWeight" Value="Normal"/>
    </Style>
    <Style x:Key="SidebarButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
      <Setter Property="Height" Value="42"/><Setter Property="Margin" Value="0,2"/>
      <Setter Property="Padding" Value="10,0"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource DangerBackground}"/><Setter Property="Foreground" Value="{DynamicResource DangerForeground}"/><Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="DangerBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="DangerBorder" Property="Background" Value="{DynamicResource DangerHoverBackground}"/><Setter Property="Foreground" Value="{DynamicResource DangerHoverForeground}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="DangerBorder" Property="Opacity" Value="0.8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="StatusToggleStyle" TargetType="ToggleButton">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="6,2"/><Setter Property="Margin" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="StatusBorder" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="StatusBorder" Property="Background" Value="{DynamicResource ControlHoverBackground}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="StatusBorder" Property="Opacity" Value="0.72"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ToggleButton"><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="10,7"/><Setter Property="Background" Value="{DynamicResource ControlBackground}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="Cursor" Value="Hand"/><Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="{DynamicResource AccentStrongBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentButtonText}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger></Style.Triggers></Style>
    <Style x:Key="KeyButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="MinWidth" Value="48"/><Setter Property="Height" Value="48"/><Setter Property="FontSize" Value="12"/>
      <EventSetter Event="PreviewMouseLeftButtonDown" Handler="DestinationButton_PreviewMouseDown"/>
      <EventSetter Event="PreviewMouseRightButtonDown" Handler="InputButton_RightClick"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="KeyBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4"><Grid><Border Height="1" Margin="3,1,3,0" VerticalAlignment="Top" Background="#24FFFFFF" IsHitTestVisible="False"/><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="KeyBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="KeyBorder" Property="Opacity" Value="0.94"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="KeyBorder" Property="Background" Value="{DynamicResource ControlPressedBackground}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="DeckButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/><Setter Property="FontSize" Value="11"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="DeckKeyBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4"><Grid><Border Height="1" Margin="3,1,3,0" VerticalAlignment="Top" Background="#24FFFFFF" IsHitTestVisible="False"/><ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="DeckKeyBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="DeckKeyBorder" Property="Opacity" Value="0.94"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="DeckKeyBorder" Property="Background" Value="{DynamicResource ControlPressedBackground}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="LayerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style x:Key="MouseHotspot" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource ControlBackground}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="2"/><Setter Property="Margin" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="9"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="MouseButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="MouseButtonBorder" Property="Background" Value="{DynamicResource ControlHoverBackground}"/><Setter TargetName="MouseButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="MouseButtonBorder" Property="Background" Value="{DynamicResource ControlPressedBackground}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
      <EventSetter Event="PreviewMouseLeftButtonDown" Handler="DestinationButton_PreviewMouseDown"/>
      <EventSetter Event="PreviewMouseRightButtonDown" Handler="InputButton_RightClick"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Margin" Value="0,4,0,10"/><Setter Property="Padding" Value="7"/>
      <Setter Property="Background" Value="{DynamicResource InputBackground}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/><Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    </Style>
    <Style TargetType="ComboBox"><Setter Property="Margin" Value="0,4,0,10"/><Setter Property="Padding" Value="6"/><Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/><Setter Property="Background" Value="{DynamicResource InputBackground}"/></Style>
    <Style x:Key="ToolbarComboBoxStyle" TargetType="ComboBox">
      <Setter Property="Height" Value="36"/><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="11,0,34,0"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/><Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/><Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/><Setter Property="Padding" Value="10,7"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{DynamicResource ControlHoverBackground}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource AccentStrongBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentButtonText}"/></Trigger></Style.Triggers>
      </Style></Setter.Value></Setter>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <Border x:Name="ComboBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"/>
          <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" IsHitTestVisible="False"/>
          <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0" Fill="{DynamicResource SecondaryText}" Data="M 0 0 L 8 0 L 4 5 Z" IsHitTestVisible="False"/>
          <ToggleButton Background="Transparent" BorderThickness="0" Focusable="False" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
            <Border Margin="0,3,0,0" Width="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="320" Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
              <ScrollViewer><ItemsPresenter/></ScrollViewer>
            </Border>
          </Popup>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ComboBorder" Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/></Style>
    <Style TargetType="Expander"><Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/></Style>
    <Style TargetType="ListBox"><Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/></Style>
    <Style x:Key="ActionChoice" TargetType="ListBoxItem">
      <Setter Property="IsEnabled" Value="{Binding IsEnabled}"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/><Setter Property="Background" Value="{DynamicResource KeyBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="7,3"/><Setter Property="Margin" Value="3"/><Setter Property="Height" Value="36"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="ChoiceBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ChoiceBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="ChoiceBorder" Property="Background" Value="{DynamicResource ControlPressedBackground}"/><Setter TargetName="ChoiceBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ChoiceBorder" Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ActionChoiceIcon" TargetType="TextBlock">
      <Setter Property="Width" Value="20"/><Setter Property="FontSize" Value="15"/><Setter Property="FontFamily" Value="Segoe UI Symbol"/>
      <Setter Property="TextAlignment" Value="Center"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Kind}" Value="{x:Static local:ActionKind.Key}"><Setter Property="Foreground" Value="{DynamicResource ActionKeyIconBrush}"/></DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="{x:Static local:ActionKind.Disabled}"><Setter Property="Foreground" Value="{DynamicResource ActionDisabledIconBrush}"/></DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="{x:Static local:ActionKind.Profile}"><Setter Property="Foreground" Value="{DynamicResource ActionProfileIconBrush}"/></DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="{x:Static local:ActionKind.Shortcut}"><Setter Property="Foreground" Value="{DynamicResource ActionShortcutIconBrush}"/></DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="{x:Static local:ActionKind.Text}"><Setter Property="Foreground" Value="{DynamicResource ActionTextIconBrush}"/></DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="{x:Static local:ActionKind.Launch}"><Setter Property="Foreground" Value="{DynamicResource ActionLaunchIconBrush}"/></DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="{x:Static local:ActionKind.Macro}"><Setter Property="Foreground" Value="{DynamicResource ActionMacroIconBrush}"/></DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="{x:Static local:ActionKind.Gesture}"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></DataTrigger>
      </Style.Triggers>
    </Style>
    <DataTemplate x:Key="ActionChoiceTemplate">
      <Grid Width="112">
        <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Icon}" Style="{StaticResource ActionChoiceIcon}"/>
        <TextBlock Grid.Column="2" Text="{Binding Label}" Foreground="{DynamicResource PrimaryText}" TextWrapping="NoWrap" HorizontalAlignment="Left" VerticalAlignment="Center"/>
      </Grid>
    </DataTemplate>
    <Style x:Key="ActionChoiceList" TargetType="ListBox">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox">
        <ItemsPresenter/>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="LowerGroupFrame" TargetType="Border">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1,1,1,1"/><Setter Property="CornerRadius" Value="6"/>
    </Style>
    <Style x:Key="LowerGroupTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource MutedText}"/><Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="10,4,0,0"/>
    </Style>
  </Window.Resources>

  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderBackground}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Padding="16,11">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="HeaderBrandColumn" Width="196"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <TextBlock x:Name="ProductNameText" Text="RELYR" FontWeight="SemiBold" FontSize="22"
                   Margin="0" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"
                   HorizontalAlignment="Left" TextAlignment="Left"/>
        <TextBlock x:Name="VersionText" Text="v—" Visibility="Collapsed" Width="0" Height="0" Margin="0"/>
        <WrapPanel x:Name="ToolbarPanel" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="プロファイル" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource SecondaryText}"/>
          <ComboBox x:Name="ProfileBox" Style="{StaticResource ToolbarComboBoxStyle}" Width="200" SelectionChanged="ProfileChanged" DropDownOpened="ProfileDropDownOpened" DropDownClosed="ProfileDropDownClosed"/>
          <Button x:Name="NewProfileButton" Style="{StaticResource ToolbarButtonStyle}" Content="＋" Width="36" MinWidth="36" Padding="0" Click="NewProfile_Click" ToolTip="新しいプロファイル"/>
          <TextBlock Text="配列" VerticalAlignment="Center" Margin="14,0,7,0" Foreground="{DynamicResource SecondaryText}"/><ComboBox x:Name="KeyboardLayoutBox" Style="{StaticResource ToolbarComboBoxStyle}" Width="76" SelectionChanged="KeyboardLayoutChanged"><ComboBoxItem Content="JIS"/><ComboBoxItem Content="US"/></ComboBox>
          <Button Style="{StaticResource ToolbarButtonStyle}" Content="保存" Click="Save_Click" Margin="14,3,3,3" Background="{DynamicResource AccentStrongBrush}" Foreground="{DynamicResource AccentButtonText}" BorderBrush="{DynamicResource AccentBrush}" ToolTip="変更を保存して反映"/>
        </WrapPanel>
      </Grid>
    </Border>

    <Border x:Name="UpdateBanner" DockPanel.Dock="Top" Visibility="Collapsed"
            Background="{DynamicResource AccentStrongBrush}" Padding="14,8">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="UpdateBannerText" VerticalAlignment="Center" FontWeight="SemiBold"
                     Foreground="{DynamicResource AccentButtonText}" Text="新しいバージョンが利用可能です"/>
          <Button x:Name="UpdateAvailableButton" Grid.Column="1" Click="UpdateAvailable_Click"
                  Content="今すぐ更新" Margin="12,0,4,0" Padding="14,5" Cursor="Hand"
                  Background="{DynamicResource CardBackground}" Foreground="{DynamicResource PrimaryText}"
                  BorderBrush="{DynamicResource AccentButtonText}"/>
          <Button x:Name="UpdateDismissButton" Grid.Column="2" Click="UpdateDismiss_Click"
                  Content="×" ToolTip="このバージョンの通知を閉じる" Margin="4,0,0,0" Padding="9,4"
                  FontSize="17" FontWeight="SemiBold" Cursor="Hand"
                  Background="Transparent" Foreground="{DynamicResource AccentButtonText}"
                  BorderBrush="Transparent"/>
        </Grid>
        <ProgressBar x:Name="UpdateBannerProgress" Grid.Row="1" Height="4" Minimum="0" Maximum="100"
                     Visibility="Collapsed" Margin="0,7,0,0"
                     Foreground="{DynamicResource AccentButtonText}" Background="{DynamicResource AccentSoftBrush}"/>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="{DynamicResource FooterBackground}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,1,0,0" Padding="10,7">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <ToggleButton x:Name="EngineToggle" Grid.Column="0" Style="{StaticResource StatusToggleStyle}" IsChecked="True" Checked="EngineChanged" Unchecked="EngineChanged" ToolTip="クリックして入力変換を一時停止・再開します"><TextBlock x:Name="EngineStatus" Text="● エンジン稼働中" Foreground="{DynamicResource AccentBrush}"/></ToggleButton>
        <ToggleButton x:Name="AutoSaveToggle" Grid.Column="1" Style="{StaticResource StatusToggleStyle}" Checked="AutoSaveChanged" Unchecked="AutoSaveChanged" ToolTip="クリックして自動保存を切り替えます"><TextBlock x:Name="AutoSaveStatus" Text="自動保存 オフ"/></ToggleButton>
        <TextBlock x:Name="AdminStatus" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <TextBlock x:Name="LastInput" Grid.Column="3" Text="入力: —" VerticalAlignment="Center" HorizontalAlignment="Right"/>
      </Grid>
    </Border>

    <Grid x:Name="MainContentGrid" ClipToBounds="True" SizeChanged="MainContent_SizeChanged">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="LayerNavigationColumn" Width="196"/><ColumnDefinition Width="*" MinWidth="0"/><ColumnDefinition x:Name="AssignmentPaneColumn" Width="320"/></Grid.ColumnDefinitions>

      <Border Background="{DynamicResource PaneBackground}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,1,0" Padding="12">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <ScrollViewer x:Name="LayerNavigationScrollViewer" Grid.Row="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
           <StackPanel>
             <StackPanel x:Name="LayerNavigationHost"/>
            <Grid x:Name="MousePanel" Width="168" Height="260" HorizontalAlignment="Center">
            <Canvas Width="168" Height="260" ClipToBounds="False">
              <Border Canvas.Left="6" Canvas.Top="8" Width="156" Height="238" CornerRadius="74" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource CardBackground}" BorderThickness="2"/>
              <Line X1="84" Y1="10" X2="84" Y2="82" Stroke="{DynamicResource BorderBrush}" StrokeThickness="2"/>
              <Line X1="8" Y1="82" X2="160" Y2="82" Stroke="{DynamicResource BorderBrush}" StrokeThickness="2"/>
              <Button Style="{StaticResource MouseHotspot}" Tag="MouseLeft" Content="左" ToolTip="左クリック" Click="InputButton_Click" Canvas.Left="14" Canvas.Top="16" Width="56" Height="54" FontSize="11"/>
              <Button Style="{StaticResource MouseHotspot}" Tag="MouseRight" Content="右" ToolTip="右クリック／右クリックレイヤー" Click="InputButton_Click" Canvas.Left="98" Canvas.Top="16" Width="56" Height="54" FontSize="11"/>
              <Button Style="{StaticResource MouseHotspot}" Tag="WheelUp" Content="▲" ToolTip="ホイール上回転" Click="InputButton_Click" Canvas.Left="72" Canvas.Top="18" Width="24" Height="20" FontSize="9"/>
              <Button Style="{StaticResource MouseHotspot}" Tag="MouseMiddle" Content="●" ToolTip="ホイールクリック（中央ボタン）" Click="InputButton_Click" Canvas.Left="72" Canvas.Top="40" Width="24" Height="16" FontSize="8"/>
              <Button Style="{StaticResource MouseHotspot}" Tag="WheelDown" Content="▼" ToolTip="ホイール下回転" Click="InputButton_Click" Canvas.Left="72" Canvas.Top="58" Width="24" Height="20" FontSize="9"/>
              <TextBlock Canvas.Left="0" Canvas.Top="96" Width="168" Text="TILT" TextAlignment="Center" Foreground="{DynamicResource MutedText}" FontSize="8" FontWeight="Bold"/>
              <Button Style="{StaticResource MouseHotspot}" Tag="TiltLeft" Content="◀" ToolTip="チルトホイール左" Click="InputButton_Click" Canvas.Left="44" Canvas.Top="108" Width="38" Height="28" FontSize="11"/>
              <Button Style="{StaticResource MouseHotspot}" Tag="TiltRight" Content="▶" ToolTip="チルトホイール右" Click="InputButton_Click" Canvas.Left="86" Canvas.Top="108" Width="38" Height="28" FontSize="11"/>
              <Button Style="{StaticResource MouseHotspot}" Tag="MouseForward" Content="進む" ToolTip="進むボタン／進むレイヤー" Click="InputButton_Click" Canvas.Left="20" Canvas.Top="151" Width="48" Height="31" FontSize="11"/>
              <Button Style="{StaticResource MouseHotspot}" Tag="MouseBack" Content="戻る" ToolTip="戻るボタン／戻るレイヤー" Click="InputButton_Click" Canvas.Left="20" Canvas.Top="186" Width="48" Height="31" FontSize="11"/>
              <Button Style="{StaticResource MouseHotspot}" Tag="MouseX" Content="X1" ToolTip="追加マウスボタン" Click="InputButton_Click" Canvas.Left="112" Canvas.Top="151" Width="36" Height="66" FontSize="11"/>
            </Canvas>
            </Grid>
           </StackPanel>
          </ScrollViewer>
          <StackPanel x:Name="LeftBottomActions" Grid.Row="1" Margin="0,10,0,0">
            <Separator Margin="4,0,4,8"/>
            <Button x:Name="MacroManagerButton" Style="{StaticResource SidebarButtonStyle}" HorizontalAlignment="Stretch" Click="OpenMacros_Click" ToolTip="操作を記録してキーへ割り当てます">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="●" FontSize="11" Foreground="{DynamicResource ActionMacroIconBrush}" HorizontalAlignment="Center"/><TextBlock Grid.Column="1" Text="マクロ" Margin="10,0,0,0" TextAlignment="Left" HorizontalAlignment="Stretch"/></Grid>
            </Button>
            <Button x:Name="ProfileManagerButton" Style="{StaticResource SidebarButtonStyle}" HorizontalAlignment="Stretch" Click="OpenProfileManager_Click" ToolTip="プロファイルの追加、編集、自動切替を管理します">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="≡" FontSize="18" HorizontalAlignment="Center"/><TextBlock Grid.Column="1" Text="プロファイル" Margin="10,0,0,0" TextAlignment="Left" HorizontalAlignment="Stretch"/></Grid>
            </Button>
            <Button x:Name="GestureManagerButton" Style="{StaticResource SidebarButtonStyle}" HorizontalAlignment="Stretch" Click="OpenGestureManager_Click" ToolTip="長押し後に上下左右へ動かすジェスチャーを管理します">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="✣" FontSize="15" HorizontalAlignment="Center"/><TextBlock Grid.Column="1" Text="ジェスチャー" Margin="10,0,0,0" TextAlignment="Left" HorizontalAlignment="Stretch"/></Grid>
            </Button>
            <Button x:Name="DeckPanelManagerButton" Style="{StaticResource SidebarButtonStyle}" HorizontalAlignment="Stretch" Click="OpenDeckPanelManager_Click" ToolTip="Deckオーバーレイの45個のボタンを管理します">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="▦" FontSize="15" HorizontalAlignment="Center"/><TextBlock Grid.Column="1" Text="Deckパネル" Margin="10,0,0,0" TextAlignment="Left" HorizontalAlignment="Stretch"/></Grid>
            </Button>
            <Button x:Name="AppSettingsButton" Style="{StaticResource SidebarButtonStyle}" HorizontalAlignment="Stretch" Click="OpenSettings_Click" ToolTip="自動起動や自動解凍を設定します">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="⚙" FontSize="15" HorizontalAlignment="Center"/><TextBlock Grid.Column="1" Text="設定" Margin="10,0,0,0" TextAlignment="Left" HorizontalAlignment="Stretch"/></Grid>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <Grid x:Name="WorkspaceGrid" Grid.Column="1" MinWidth="0" Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="2,0,0,18">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock x:Name="WorkspaceTitle" Text="キーボード" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock x:Name="WorkspaceSubtitle" Text="通常レイヤー" Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource SecondaryText}"/>
          </StackPanel>
          <CheckBox x:Name="SharedDeckPanelBox" Grid.Column="1" Visibility="Collapsed" VerticalAlignment="Center"
                    Content="すべてのプロファイルで共通のDeckを使用" FontSize="13" Margin="20,0,2,0"
                    Checked="SharedDeckPanelChanged" Unchecked="SharedDeckPanelChanged"/>
        </Grid>
        <StackPanel x:Name="WorkspaceIntroPanel" Visibility="Collapsed">
          <StackPanel Margin="0,0,0,16">
           <StackPanel x:Name="LayerButtonsPanel" HorizontalAlignment="Stretch" SizeChanged="LayerButtonsPanel_SizeChanged">
             <TextBlock x:Name="KeyboardLayerCategory" Text="キーボード" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold" Margin="8,5,8,3"/>
            <Button x:Name="NormalLayerButton" Style="{StaticResource LayerButton}" Tag="通常" Click="LayerButton_Click">
               <StackPanel><TextBlock Text="通常レイヤー"/><TextBlock Text="そのまま押す" FontSize="11" Foreground="{DynamicResource SecondaryText}"/></StackPanel>
            </Button>
            <Button x:Name="SpaceLayerButton" Style="{StaticResource LayerButton}" Tag="Space" Click="LayerButton_Click">
               <StackPanel><TextBlock Text="Space レイヤー"/><TextBlock Text="Spaceを押しながら" FontSize="11" Foreground="{DynamicResource SecondaryText}"/></StackPanel>
            </Button>
            <Button x:Name="CapsLockLayerButton" Style="{StaticResource LayerButton}" Tag="CapsLock" Click="LayerButton_Click">
               <StackPanel><TextBlock Text="CapsLock レイヤー"/><TextBlock Text="F13リマップ設定が必要" FontSize="9" Foreground="{DynamicResource WarningBrush}"/></StackPanel>
            </Button>
             <TextBlock x:Name="MouseLayerCategory" Text="マウス" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold" Margin="8,8,8,3"/>
             <Button x:Name="RightMouseLayerButton" Style="{StaticResource LayerButton}" Tag="MouseRight" Click="LayerButton_Click"><StackPanel><TextBlock Text="右クリック レイヤー"/><TextBlock Text="右クリックを押しながら" FontSize="10" Foreground="{DynamicResource SecondaryText}"/></StackPanel></Button>
             <Button x:Name="ForwardMouseLayerButton" Style="{StaticResource LayerButton}" Tag="MouseForward" Click="LayerButton_Click"><StackPanel><TextBlock Text="進む レイヤー"/><TextBlock Text="進むを押しながら" FontSize="10" Foreground="{DynamicResource SecondaryText}"/></StackPanel></Button>
             <Button x:Name="BackMouseLayerButton" Style="{StaticResource LayerButton}" Tag="MouseBack" Click="LayerButton_Click"><StackPanel><TextBlock Text="戻る レイヤー"/><TextBlock Text="戻るを押しながら" FontSize="10" Foreground="{DynamicResource SecondaryText}"/></StackPanel></Button>
             <TextBlock x:Name="WindowsLayerCategory" Text="Windows" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold" Margin="8,8,8,3"/>
            <Button x:Name="TaskbarLayerButton" Style="{StaticResource LayerButton}" Tag="Taskbar" Click="LayerButton_Click">
               <StackPanel><TextBlock Text="タスクバー上"/><TextBlock Text="カーソルがタスクバーにある時" FontSize="10" Foreground="{DynamicResource SecondaryText}"/></StackPanel>
            </Button>
           </StackPanel>
          </StackPanel>

        </StackPanel>
        <Grid x:Name="KeyboardWorkspace" Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition x:Name="LowerInputRow" Height="320"/></Grid.RowDefinitions>
          <Viewbox x:Name="KeyboardViewbox" MaxWidth="1220" Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Canvas x:Name="KeyboardPanel" Width="960" Height="364"/>
          </Viewbox>
          <Grid x:Name="LowerInputGrid" Grid.Row="1" Width="{Binding ActualWidth,ElementName=KeyboardViewbox}" HorizontalAlignment="Left" Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="MouseColumn" Width="300"/></Grid.ColumnDefinitions>
            <Viewbox x:Name="SecondaryKeyboardViewbox" Margin="0,0,12,0" Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Left" VerticalAlignment="Stretch"><Canvas x:Name="SecondaryKeyboardPanel" Width="654" Height="312"/></Viewbox>
            <Border x:Name="MouseFrame" Grid.Column="1" Style="{StaticResource LowerGroupFrame}" Height="{Binding ActualHeight,ElementName=SecondaryKeyboardViewbox}" VerticalAlignment="Top" Margin="0,0,0,2" Panel.ZIndex="0"/>
            <TextBlock Grid.Column="1" Text="マウス" Style="{StaticResource LowerGroupTitle}" Panel.ZIndex="2" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <Viewbox x:Name="MouseHost" Grid.Column="1" Margin="8,22,8,8" Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Center" VerticalAlignment="Top" Panel.ZIndex="1"/>
          </Grid>
        </Grid>
        <Viewbox x:Name="DeckWorkspace" Grid.Row="1" Visibility="Collapsed" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Top">
          <UniformGrid x:Name="DeckManagementGrid" Rows="5" Columns="9" Width="522" Height="350"/>
        </Viewbox>
      </Grid>

      <Border x:Name="AssignmentPane" Grid.Column="2" Panel.ZIndex="20" Visibility="Visible" Background="{DynamicResource PaneBackground}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1,0,0,0" Padding="20">
        <Border.RenderTransform><TranslateTransform x:Name="AssignmentPaneTransform" X="0"/></Border.RenderTransform>
        <ScrollViewer x:Name="AssignmentScrollViewer" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly" IsDeferredScrollingEnabled="False" PreviewMouseWheel="AssignmentPane_PreviewMouseWheel">
          <StackPanel>
            <TextBlock Text="インスペクター" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
            <Button x:Name="DetectInputButton" Content="入力を検出" Click="Detect_Click" Margin="0,0,0,12" ToolTip="押したキーまたはマウス入力を検出"/>
            <Button x:Name="DeckKeypadInputButton" Content="キーパッドから入力" Click="DeckKeypadInput_Click" Margin="0,0,0,12" Visibility="Collapsed"/>
            <StackPanel x:Name="InspectorEmptyState" Margin="0,42,0,0">
              <TextBlock Text="キーを選択" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
              <TextBlock Text="編集するキーまたはDeckボタンを選択してください" Margin="8,6,8,0" Foreground="{DynamicResource SecondaryText}" TextAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel x:Name="SelectionHeader" Visibility="Collapsed" Margin="0,0,0,14">
              <TextBlock Text="入力元" FontSize="11" Foreground="{DynamicResource SecondaryText}"/>
              <TextBlock x:Name="InputDisplayText" Text="キーを選択してください" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" TextWrapping="Wrap" Margin="0,3,0,0"/>
            </StackPanel>
            <TextBox x:Name="InputName" IsReadOnly="True" Visibility="Collapsed"/>
            <StackPanel x:Name="AssignmentEditor" Visibility="Collapsed">
            <StackPanel x:Name="DeckNameEditorPanel" Visibility="Collapsed" Margin="0,0,0,16">
              <TextBlock Text="名前" Foreground="{DynamicResource SecondaryText}"/>
              <TextBox x:Name="DeckNameBox" TextChanged="DeckNameBox_TextChanged" ToolTip="Deckボタンの下に表示する名前"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="実行する操作" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <ListBox x:Name="KindBox" Style="{StaticResource ActionChoiceList}" SelectionChanged="EditorChanged" PreviewMouseLeftButtonDown="ActionKind_PreviewMouseLeftButtonDown" ItemContainerStyle="{StaticResource ActionChoice}" ItemTemplate="{StaticResource ActionChoiceTemplate}" Margin="0,0,0,7"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox>
                <TextBlock Text="内容" Foreground="{DynamicResource SecondaryText}"/><TextBox x:Name="ValueBox" TextChanged="EditorChanged" PreviewKeyDown="ExecutionValue_PreviewKeyDown" ToolTip="Ctrlを押しながらCなど、実際のキーボードでもショートカットを入力できます"/>
                <Button Content="入力完了" HorizontalAlignment="Right" Click="DestinationInputDone_Click" Background="{DynamicResource AccentStrongBrush}" Foreground="{DynamicResource AccentButtonText}"/>
                <Button x:Name="LongPressOnlyButton" Content="短押しを元の入力にする" Click="LongPressOnly_Click" Margin="0,4,0,2"/>
              </StackPanel>
            </StackPanel>
            <Separator Margin="0,2,0,12"/>
            <Expander x:Name="LongPressExpander" Header="長押しを追加" Expanded="LongPressExpander_Expanded" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Text="長押しの操作" FontSize="13" FontWeight="SemiBold" Margin="0,10,0,8"/>
                <ListBox x:Name="LongKindBox" Style="{StaticResource ActionChoiceList}" SelectionChanged="EditorChanged" PreviewMouseLeftButtonDown="ActionKind_PreviewMouseLeftButtonDown" ItemContainerStyle="{StaticResource ActionChoice}" ItemTemplate="{StaticResource ActionChoiceTemplate}" Margin="0,0,0,7"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox>
                <TextBlock Text="内容" Foreground="{DynamicResource SecondaryText}"/><TextBox x:Name="LongValueBox" TextChanged="EditorChanged" PreviewKeyDown="ExecutionValue_PreviewKeyDown" ToolTip="Ctrlを押しながらCなど、実際のキーボードでもショートカットを入力できます"/>
                <Button Content="入力完了" HorizontalAlignment="Right" Click="DestinationInputDone_Click" Background="{DynamicResource AccentStrongBrush}" Foreground="{DynamicResource AccentButtonText}"/>
                <TextBlock Text="判定時間（ms）" Margin="0,8,0,0" Foreground="{DynamicResource SecondaryText}"/><TextBox x:Name="LongPressBox" Text="500" TextChanged="EditorChanged"/>
              </StackPanel>
            </Expander>
            <Button x:Name="AssignmentDeleteButton" Content="割り当てを削除" Background="Transparent" Foreground="{DynamicResource DangerBrush}" BorderBrush="Transparent" HorizontalAlignment="Left" Margin="-3,14,0,0" Click="Delete_Click"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </DockPanel>
</Window>
