<Window x:Class="RELYR.ApplicationPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="起動するアプリを選択" Width="760" Height="620" MinWidth="620" MinHeight="460"
        WindowStartupLocation="CenterOwner" Background="#11141B" Foreground="#E8ECF4" ShowInTaskbar="False">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#293142"/><Setter Property="BorderBrush" Value="#465168"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="18,9"/><Setter Property="Margin" Value="4"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Border" Property="Background" Value="#354158"/><Setter TargetName="Border" Property="BorderBrush" Value="#72E0C1"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Border" Property="Background" Value="#176B5D"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Border" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#171D27"/><Setter Property="Foreground" Value="White"/><Setter Property="CaretBrush" Value="#72E0C1"/><Setter Property="BorderBrush" Value="#465168"/><Setter Property="Padding" Value="10,8"/><Setter Property="FontSize" Value="14"/></Style>
  </Window.Resources>
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="インストール済みアプリから選択" FontSize="24" FontWeight="Bold" Foreground="#72E0C1"/><TextBlock Text="スタート メニューとWindowsの登録情報から、起動できるアプリを表示します。" Foreground="#AAB4C8" Margin="0,4,0,14"/></StackPanel>
    <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="検索" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBox x:Name="SearchBox" Grid.Column="1" TextChanged="SearchChanged" ToolTip="アプリ名またはパスを検索"/></Grid>
    <Grid Grid.Row="2"><ListBox x:Name="ApplicationList" Background="#171D27" Foreground="White" BorderBrush="#465168" SelectionChanged="ApplicationSelectionChanged" MouseDoubleClick="ApplicationDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="9,7"><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding Source}" Foreground="#72E0C1" FontSize="11" Margin="0,2,0,0"/><TextBlock Text="{Binding LaunchPath}" Foreground="#AAB4C8" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding LaunchPath}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock x:Name="EmptyMessage" Text="アプリを読み込んでいます…" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#AAB4C8" FontSize="15" IsHitTestVisible="False"/></Grid>
    <Grid Grid.Row="3" Margin="0,12,0,0"><TextBlock x:Name="ResultCount" VerticalAlignment="Center" Foreground="#AAB4C8"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="一覧にないアプリを参照…" Click="BrowseFile_Click"/><Button Content="キャンセル" Click="Cancel_Click"/><Button x:Name="SelectButton" Content="このアプリを使用" Background="#1F8F7B" BorderBrush="#72E0C1" IsEnabled="False" Click="Select_Click"/></StackPanel></Grid>
  </Grid>
</Window>
