<Window x:Class="RELYR.ApplicationPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="起動するアプリを選択" Width="760" Height="620" MinWidth="620" MinHeight="460"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackground}" Foreground="{DynamicResource PrimaryText}" ShowInTaskbar="False">
  <Window.Resources>
    <Style TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
      <Setter Property="Margin" Value="4"/>
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource AppTextBoxStyle}"><Setter Property="Background" Value="{DynamicResource InputBackground}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/><Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="FontSize" Value="14"/></Style>
  </Window.Resources>
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="検索" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBox x:Name="SearchBox" Grid.Column="1" TextChanged="SearchChanged" ToolTip="アプリ名またはパスを検索"/></Grid>
    <Grid x:Name="ManualTargetPanel" Grid.Row="1" Margin="0,0,0,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="パス / URL" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
      <TextBox x:Name="ManualTargetBox" Grid.Column="1" TextChanged="ManualTargetChanged" ToolTip="アプリ、ファイル、フォルダーのパス、またはURLを直接入力"/>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,-4,-4,-4"><Button x:Name="BrowseApplicationButton" Content="ファイル…" Click="BrowseFile_Click"/><Button x:Name="BrowseFolderButton" Content="フォルダー…" Click="BrowseFolder_Click"/></StackPanel>
    </Grid>
    <Grid Grid.Row="2"><ListBox x:Name="ApplicationList" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource BorderBrush}" SelectionChanged="ApplicationSelectionChanged" MouseDoubleClick="ApplicationDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Grid Margin="9,7"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="34" Height="34" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource ControlBackground}" CornerRadius="8"><Image Source="{Binding Icon}" Width="26" Height="26" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/></Border><Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><Grid Grid.Row="1" Margin="0,2,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Source}" Foreground="{DynamicResource AccentTextBrush}" FontSize="11"/><TextBlock Grid.Column="1" Text="  ·  " Foreground="{DynamicResource MutedText}" FontSize="11"/><TextBlock Grid.Column="2" Text="{Binding LaunchPath}" Foreground="{DynamicResource SecondaryText}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding LaunchPath}"/></Grid></Grid></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock x:Name="EmptyMessage" Text="アプリを読み込んでいます…" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}" FontSize="15" IsHitTestVisible="False"/></Grid>
    <Grid Grid.Row="3" Margin="0,12,0,0"><TextBlock x:Name="ResultCount" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="キャンセル" Click="Cancel_Click"/><Button x:Name="SelectButton" Content="この内容を使用" Background="{DynamicResource AccentStrongBrush}" Foreground="{DynamicResource AccentButtonText}" BorderBrush="{DynamicResource AccentBrush}" IsEnabled="False" Click="Select_Click"/></StackPanel></Grid>
  </Grid>
</Window>
