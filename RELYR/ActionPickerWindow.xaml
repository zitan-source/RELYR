<Window x:Class="RELYR.ActionPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="アクションを選択" Width="980" Height="680"
        MinWidth="760" MinHeight="560" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}" Foreground="{DynamicResource PrimaryText}">
  <Window.Resources>
    <Style TargetType="Button" BasedOn="{StaticResource AppButtonStyle}"/>
    <Style TargetType="TextBox" BasedOn="{StaticResource AppTextBoxStyle}">
      <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style x:Key="CatalogList" TargetType="ListBox" BasedOn="{StaticResource AppListBoxStyle}">
      <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="Padding" Value="5"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>
  </Window.Resources>
  <Grid Margin="18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <TextBlock Text="検索" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
      <TextBox x:Name="SearchBox" Grid.Column="1" TextChanged="SearchChanged" ToolTip="名前・説明・ショートカットを検索"/>
    </Grid>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="10"/><ColumnDefinition Width="210"/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="大カテゴリ" FontWeight="SemiBold" Margin="4,0,0,6"/><ListBox x:Name="MajorCategoryList" Grid.Row="1" SelectionChanged="MajorCategoryChanged" Style="{StaticResource CatalogList}"/></Grid>
      <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="中カテゴリ" FontWeight="SemiBold" Margin="4,0,0,6"/><ListBox x:Name="CategoryList" Grid.Row="1" SelectionChanged="CategoryChanged" Style="{StaticResource CatalogList}"/></Grid>
      <Grid Grid.Column="4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><Grid><TextBlock Text="アクション" FontWeight="SemiBold" Margin="4,0,0,6"/><TextBlock x:Name="ResultCount" HorizontalAlignment="Right" Foreground="{DynamicResource SecondaryText}" Margin="0,0,4,6"/></Grid><ListBox x:Name="ActionList" Grid.Row="1" SelectionChanged="ActionChanged" MouseDoubleClick="ActionDoubleClick" Style="{StaticResource CatalogList}"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="6"><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,2,0,0"/><TextBlock Text="{Binding Value}" Foreground="{DynamicResource AccentBrush}" FontSize="11" Margin="0,3,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
    </Grid>
    <Border Grid.Row="2" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource SurfaceCornerRadius}" Padding="10" Margin="0,12,0,0">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Button Content="キーパッドから入力" Padding="14,8" Click="OpenKeypad_Click"/>
        <TextBox x:Name="CustomShortcutBox" Grid.Column="1" Margin="10,0" VerticalContentAlignment="Center" TextChanged="CustomShortcutChanged" ToolTip="例: Ctrl+Shift+K"/>
        <Button Grid.Column="2" Content="クリア" Padding="14,8" Margin="0,0,8,0" Click="ClearShortcut_Click"/>
        <Button x:Name="UseShortcutButton" Grid.Column="3" Content="このキー操作を使用" Padding="14,8" Click="UseShortcut_Click" IsEnabled="False"/>
      </Grid>
    </Border>
    <Grid Grid.Row="3" Margin="0,14,0,0">
      <TextBlock x:Name="SelectedDescription" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}" TextTrimming="CharacterEllipsis" Margin="0,0,320,0"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="ClockSettingsButton" Content="クロック設定…" Padding="18,8" Margin="4"
                Visibility="Collapsed" Click="ClockSettings_Click"/>
        <Button Content="キャンセル" Padding="18,8" Margin="4" Click="Cancel_Click"/>
        <Button x:Name="SelectButton" Content="選択した項目を使用" Padding="18,8" Margin="4" Background="{DynamicResource AccentStrongBrush}" Foreground="{DynamicResource AccentButtonText}" BorderBrush="{DynamicResource AccentBrush}" Click="Select_Click" IsEnabled="False"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
