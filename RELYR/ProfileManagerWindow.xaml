<Window x:Class="RELYR.ProfileManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="プロファイル" Width="980" Height="650" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackground}" Foreground="{DynamicResource PrimaryText}" ShowInTaskbar="False">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    <Style TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
      <Setter Property="Margin" Value="3"/>
    </Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource DangerBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource DangerForeground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="DangerBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource ControlCornerRadius}" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter TargetName="DangerBorder" Property="Background" Value="{DynamicResource DangerHoverBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerHoverForeground}"/>
          </Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="DangerBorder" Property="Opacity" Value="0.8"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="DangerBorder" Property="Opacity" Value="0.42"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="AutoSwitchToggle" TargetType="ToggleButton"><Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/><Setter Property="Background" Value="{DynamicResource ControlBackground}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="MinHeight" Value="{StaticResource ControlHeight}"/><Setter Property="Padding" Value="{StaticResource ControlPadding}"/><Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource ControlCornerRadius}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True"><ContentPresenter VerticalAlignment="Center" Margin="0,0,0,1"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Border" Property="Background" Value="{DynamicResource AccentStrongBrush}"/><Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentButtonText}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Border" Property="Opacity" Value="0.42"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ListBox" BasedOn="{StaticResource AppListBoxStyle}"><Setter Property="Background" Value="{DynamicResource InputBackground}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/></Style>
  </Window.Resources>
  <Grid Margin="12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox x:Name="CursorProfileSwitchBox" Grid.Column="1" Content="カーソル下のアプリに合わせて自動切替" VerticalAlignment="Center" ToolTip="RELYR自身の画面上ではプロファイルを切り替えません"/></Grid>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="ProfileListColumn" Width="165"/><ColumnDefinition Width="14"/><ColumnDefinition x:Name="ApplicationManagementColumn"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource SurfaceCornerRadius}" Padding="10">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="一覧" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
          <ListBox x:Name="ProfileList" Grid.Row="1" SelectionChanged="ProfileSelectionChanged" PreviewMouseRightButtonDown="ProfileList_PreviewMouseRightButtonDown">
            <ListBox.ItemTemplate><DataTemplate><Grid Margin="6,7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="自動" FontSize="11" Foreground="{DynamicResource AccentBrush}" Visibility="{Binding AutoSwitchEnabled,Converter={StaticResource BooleanToVisibilityConverter},FallbackValue=Collapsed}"/></Grid></DataTemplate></ListBox.ItemTemplate>
            <ListBox.ContextMenu><ContextMenu><MenuItem Header="割り当てをコピー" Click="CopyAssignments_Click"/><MenuItem Header="割り当てを貼り付け" Click="PasteAssignments_Click"/><Separator/><MenuItem Header="名前を変更" Click="RenameProfileManager_Click"/><MenuItem Header="削除" Foreground="{DynamicResource DangerBrush}" Click="DeleteProfileManager_Click"/></ContextMenu></ListBox.ContextMenu>
          </ListBox>
          <UniformGrid Grid.Row="2" Columns="3" Margin="0,9,0,0">
            <Button x:Name="AddProfileButton" Click="AddProfileManager_Click" ToolTip="プロファイルを追加" Padding="0">
              <Viewbox Width="18" Height="18"><Canvas Width="18" Height="18"><Path Data="M9,3 V15 M3,9 H15" Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox>
            </Button>
            <Button x:Name="RenameProfileButton" Click="RenameProfileManager_Click" ToolTip="プロファイル名を編集" Padding="0">
              <Viewbox Width="18" Height="18"><Canvas Width="18" Height="18"><Path Data="M3,15 L4.2,10.8 L12.6,2.4 Q13.3,1.7 14,2.4 L15.6,4 Q16.3,4.7 15.6,5.4 L7.2,13.8 Z M4.2,10.8 L7.2,13.8" Stroke="White" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/></Canvas></Viewbox>
            </Button>
            <Button x:Name="DeleteProfileButton" Style="{StaticResource DangerButton}" Click="DeleteProfileManager_Click" ToolTip="プロファイルを削除" Padding="0">
              <Viewbox Width="18" Height="18"><Canvas Width="18" Height="18"><Path Data="M3,5 H15 M6,5 V3 H12 V5 M5,5 L6,16 H12 L13,5 M8,8 V13 M10,8 V13" Stroke="White" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/></Canvas></Viewbox>
            </Button>
          </UniformGrid>
          <StackPanel Grid.Row="3" Margin="0,3,0,0"><Button Content="割り当てをコピー" Click="CopyAssignments_Click"/><Button Content="割り当てを貼り付け" Click="PasteAssignments_Click"/></StackPanel>
        </Grid>
      </Border>
      <Border Grid.Column="2" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource SurfaceCornerRadius}" Padding="12">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="SelectedProfileTitle" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/><ToggleButton x:Name="AutoSwitchBox" Grid.Column="1" Style="{StaticResource AutoSwitchToggle}" Content="自動切替 オフ" Checked="AutoSwitchChanged" Unchecked="AutoSwitchChanged" ToolTip="マウスカーソルが対象アプリ上にあるとき、このプロファイルへ切り替えます"/></Grid>
          <Grid Grid.Row="1" Margin="0,10,0,6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="対象に登録したアプリ" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="現在起動中のアプリ" FontWeight="SemiBold"/></Grid>
          <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <ListBox x:Name="AssignedApplicationList" MouseDoubleClick="RemoveAutoSwitchApplication_Click"><ListBox.ItemTemplate><DataTemplate><Grid Margin="8,6"><TextBlock Text="{Binding}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
            <ListBox x:Name="RunningApplicationList" Grid.Column="2" MouseDoubleClick="AddRunningApplication_Click"><ListBox.ItemTemplate><DataTemplate><Grid Margin="8,6"><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Row="1" Text="{Binding Value}" Foreground="{DynamicResource SecondaryText}" FontSize="11" TextTrimming="CharacterEllipsis"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
          </Grid>
          <Grid Grid.Row="3" Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal"><Button Content="外す" FontSize="12" ToolTip="選択した登録を外します" Click="RemoveAutoSwitchApplication_Click"/></StackPanel>
            <WrapPanel Grid.Column="2" HorizontalAlignment="Right"><Button Content="更新" ToolTip="起動中のアプリ一覧を更新します" Click="RefreshRunningApplications_Click"/><Button Content="追加" ToolTip="選択した起動中のアプリを追加します" Click="AddRunningApplication_Click"/><Button Content="アプリを選ぶ…" ToolTip="インストール済みのアプリから選びます" Click="AddInstalledApplication_Click"/></WrapPanel>
          </Grid>
        </Grid>
      </Border>
    </Grid>
    <Grid Grid.Row="2" Margin="0,6,0,0"><TextBlock x:Name="StatusText" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="キャンセル" Click="Cancel_Click"/><Button Content="適用" Background="{DynamicResource AccentStrongBrush}" Foreground="{DynamicResource AccentButtonText}" BorderBrush="{DynamicResource AccentBrush}" Click="Apply_Click"/></StackPanel></Grid>
  </Grid>
</Window>
